# Funktion zum Ausführen von Tests
run_test_suite() {
    local name="$1"
    shift
    local tests=("$@")
    log_info "=== $name ==="
    # Nur existierende Test-Dateien filtern
    local existing_tests=()
    for test in "${tests[@]}"; do
        if [[ -f "$ROOT_DIR/$test" ]]; then
            existing_tests+=("$test")
        else
            log_warn "Test nicht gefunden (übersprungen): $test"
        fi
    done
    if [[ ${#existing_tests[@]} -eq 0 ]]; then
        log_warn "Keine Tests in Suite '$name' gefunden."
        return 0
    fi
    local cmd=("$PYTHON" -B -m pytest -q -p no:cacheprovider --timeout=120 $PYTEST_ARGS "${existing_tests[@]}")
    log_info "Ausführen: ${cmd[*]}"
    if "${cmd[@]}"; then
        log_ok "$name: erfolgreich"
        return 0
    else
        log_error "$name: FEHLGESCHLAGEN"
        return 3
    fi
}

# Haupt-Ausführung
OVERALL_EXIT=0

case "$MODE" in
    quick)
        log_info "=== BACH CI: QUICK MODE ==="
        run_test_suite "Worker Policy & Completion" "${WORKER_POLICY_TESTS[@]}" || OVERALL_EXIT=3
        run_test_suite "Model Request Budget" "${BUDGET_TESTS[@]}" || OVERALL_EXIT=3
        ;;
    full)
        log_info "=== BACH CI: FULL MODE ==="
        run_test_suite "Worker Policy & Completion" "${WORKER_POLICY_TESTS[@]}" || OVERALL_EXIT=3
        run_test_suite "Model Request Budget" "${BUDGET_TESTS[@]}" || OVERALL_EXIT=3
        run_test_suite "GUI Release & Shared Contract" "${GUI_TESTS[@]}" || OVERALL_EXIT=3
        run_test_suite "Native Core" "${NATIVE_CORE_TESTS[@]}" || OVERALL_EXIT=3
        run_test_suite "Standard Suites" "${STANDARD_TESTS[@]}" || OVERALL_EXIT=3
        run_test_suite "Learning & Hermes" "${LEARNING_TESTS[@]}" || OVERALL_EXIT=3
        run_test_suite "GUI GUX" "${GUI_GUX_TESTS[@]}" || OVERALL_EXIT=3
        run_test_suite "Native DB Sync" "${NATIVE_DB_SYNC_TESTS[@]}" || OVERALL_EXIT=3
        ;;
    standard|*)
        log_info "=== BACH CI: STANDARD MODE ==="
        run_test_suite "Worker Policy & Completion" "${WORKER_POLICY_TESTS[@]}" || OVERALL_EXIT=3
        run_test_suite "Model Request Budget" "${BUDGET_TESTS[@]}" || OVERALL_EXIT=3
        run_test_suite "GUI Release & Shared Contract" "${GUI_TESTS[@]}" || OVERALL_EXIT=3
        run_test_suite "Native Core" "${NATIVE_CORE_TESTS[@]}" || OVERALL_EXIT=3
        run_test_suite "Standard Suites" "${STANDARD_TESTS[@]}" || OVERALL_EXIT=3
        run_test_suite "Learning & Hermes" "${LEARNING_TESTS[@]}" || OVERALL_EXIT=3
        run_test_suite "GUI GUX" "${GUI_GUX_TESTS[@]}" || OVERALL_EXIT=3
        run_test_suite "Native DB Sync" "${NATIVE_DB_SYNC_TESTS[@]}" || OVERALL_EXIT=3
        ;;
esac

# Native Readiness Prüfung (wie im CI)
log_info "=== Native Readiness Check ==="
if "$PYTHON" -c "
import sys, hashlib, sqlite3
from pathlib import Path
root = Path('$ROOT_DIR')
for mod_name, rel in [('sqlite_transit_sync', 'sqlite_transit_sync/__init__.py'), ('sqlite_transit_sync.core', 'sqlite_transit_sync/core.py')]:
    try:
        mod = __import__(mod_name, fromlist=[''])
        if Path(mod.__file__).resolve() != (root / rel).resolve():
            print(f'Shadow import: {mod.__file__}')
            sys.exit(1)
    except ImportError:
        pass
if sqlite3.sqlite_version_info < (3, 37, 0):
    print(f'SQLite {sqlite3.sqlite_version} zu alt, brauche 3.37+')
    sys.exit(1)
conn = sqlite3.connect(':memory:')
try:
    conn.execute('CREATE VIRTUAL TABLE ci_fts USING fts5(body)')
    conn.execute(\"INSERT INTO ci_fts(body) VALUES ('required native capability')\")
    row = conn.execute(\"SELECT body FROM ci_fts WHERE ci_fts MATCH 'native'\").fetchone()
    if row != ('required native capability',):
        print('FTS5 query failed')
        sys.exit(1)
    tables = conn.execute('PRAGMA table_list').fetchall()
    if not any(r[1] == 'ci_fts' and r[2] == 'virtual' for r in tables):
        print('table_list failed')
        sys.exit(1)
    cols = conn.execute('PRAGMA table_xinfo(ci_fts)').fetchall()
    if not any(c[1] == 'body' and c[6] == 0 for c in cols) or not any(c[1] == 'rank' and c[6] == 1 for c in cols):
        print('table_xinfo failed')
        sys.exit(1)
    for suite in ('test_db_sync_native_readiness.py', 'test_db_sync_handler.py', 'test_transit_sync_provider_wiring.py', 'test_prosync_race.py'):
        if not (root / 'system/tests' / suite).is_file():
            print(f'Missing suite: {suite}')
            sys.exit(1)
    print(f'Native readiness OK: SQLite {sqlite3.sqlite_version}')
finally:
    conn.close()
"; then
    log_ok "Native Readiness Check: erfolgreich"
else
    log_error "Native Readiness Check: FEHLGESCHLAGEN"
    OVERALL_EXIT=3
fi

# Zusammenfassung
echo
if [[ $OVERALL_EXIT -eq 0 ]]; then
    log_ok "=== ALLE PRÜFUNGEN ERFOLGREICH ==="
else
    log_error "=== PRÜFUNGEN FEHLGESCHLAGEN (Exit: $OVERALL_EXIT) ==="
fi

exit $OVERALL_EXIT
