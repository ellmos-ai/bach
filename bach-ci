#!/usr/bin/env bash
# bach-ci — Lokales CI-Skript für BACH
# Führt die wichtigsten Prüfungen lokal aus, ähnlich wie der GitHub Actions Workflow.
# Nutzung: ./bach-ci [--quick|--full] [--pytest-args "..."]
#
# Beendet mit Exit-Code != 0, wenn ein Schritt fehlschlägt.
# Stand: Task #3930 — getestet: pytest -q system/tests/test_db_sync_native_readiness.py (74 passed).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$SCRIPT_DIR"
SYSTEM_DIR="$ROOT_DIR/system"
STARTSPINE="$ROOT_DIR/start/startspine.py"

# Standard-Werte
MODE="standard"
PYTEST_ARGS=""

# Argumente parsen
while [[ $# -gt 0 ]]; do
    case $1 in
        --quick)
            MODE="quick"
            shift
            ;;
        --full)
            MODE="full"
            shift
            ;;
        --pytest-args)
            PYTEST_ARGS="$2"
            shift 2
            ;;
        --help|-h)
            cat <<EOF
bach-ci — Lokales CI-Skript für BACH

Usage: ./bach-ci [OPTIONEN]

Optionen:
  --quick          Nur schnelle Basis-Tests (Worker-Policy, Kern-Tests)
  --full           Vollständiger Testlauf (alle Suites wie im CI)
  --pytest-args    Zusätzliche Argumente an pytest weitergeben
  --help, -h       Diese Hilfe anzeigen

Beispiele:
  ./bach-ci                    # Standard-Lauf (Worker-Policy + Kern + Native)
  ./bach-ci --quick            # Nur schnelle Prüfung
  ./bach-ci --full             # Vollständiger Lauf
  ./bach-ci --pytest-args "-k not slow"  # Mit pytest-Filter

Exit-Codes:
  0  Alles erfolgreich
  1  Allgemeiner Fehler
  2  Abhängigkeiten fehlen
  3  Tests fehlgeschlagen
EOF
            exit 0
            ;;
        *)
            echo "Unbekannte Option: $1" >&2
            echo "Nutze --help für Hilfe." >&2
            exit 1
            ;;
    esac
done

# Farben für Ausgabe
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info()  { echo -e "${BLUE}[INFO]${NC} $*"; }
log_ok()    { echo -e "${GREEN}[OK]${NC} $*"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*"; }

# Prüfen, ob wir im richtigen Verzeichnis sind
if [[ ! -f "$SYSTEM_DIR/bach.py" ]] || [[ ! -f "$STARTSPINE" ]]; then
    log_error "BACH-System nicht gefunden. Erwartet: $SYSTEM_DIR/bach.py und $STARTSPINE"
    exit 1
fi

# Python-Interpreter ermitteln
if [[ -x "$HOME/.venvs/bach/bin/python" ]]; then
    PYTHON="$HOME/.venvs/bach/bin/python"
elif [[ -x "$HOME/.venvs/science/bin/python" ]]; then
    PYTHON="$HOME/.venvs/science/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
else
    PYTHON=python
fi

log_info "Verwende Python: $($PYTHON --version)"

# Abhängigkeiten prüfen
log_info "Prüfe Abhängigkeiten..."
if ! "$PYTHON" -c "import pytest; import psutil" 2>/dev/null; then
    log_warn "Fehlende Abhängigkeiten (pytest, psutil). Installiere via: pip install pytest psutil"
    log_warn "Fahre trotzdem fort – Tests werden fehlschlagen, wenn Abhängigkeiten fehlen."
fi

# PYTHONPATH setzen
export PYTHONPATH="$SYSTEM_DIR${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONIOENCODING=utf-8
export PYTHONUNBUFFERED=1
export PYTHONDONTWRITEBYTECODE=1
export PYSTRAY_BACKEND=dummy

# Test-Suiten definieren
