    "system/tests/test_worker_result_submission_receipt.py"
    "system/tests/test_worker_execution_evidence.py"
    "system/tests/test_worker_execution_runtime.py"
    "system/tests/test_worker_scope_snapshot.py"
    "system/tests/test_worker_scope_evidence.py"
    "system/tests/test_worker_scope_integration.py"
    "system/tests/test_provider_model_provenance.py"
    "system/tests/test_worker_model_provenance.py"
    "system/tests/test_model_backend.py"
    "system/tests/test_ollama_stream.py"
    "system/tests/test_worker_review_identity.py"
    "system/tests/test_worker_result_review.py"
    "system/tests/test_worker_review_runtime.py"
    "system/tests/test_worker_completion_policy.py"
    "system/tests/test_machine_false_acceptance_recovery.py"
    "system/tests/test_worker_completion_cli.py"
    "system/tests/test_task_completion_safe_db.py"
    "system/tests/test_task_result_correction.py"
    "system/tests/test_task_result_correction_client.py"
    "system/tests/test_task_result_correction_api.py"
    "system/tests/test_task_result_service_scopes_migration.py"
