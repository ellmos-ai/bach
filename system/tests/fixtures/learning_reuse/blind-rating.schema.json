{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning reuse blind rating",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "blind_submission_id",
    "rater_code",
    "scores",
    "critical_failure",
    "rationale"
  ],
  "properties": {
    "schema": {"const": "bach.learning-reuse.blind-rating.v1"},
    "case_id": {"type": "string", "pattern": "^case-[0-9]{2}$"},
    "blind_submission_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,80}$"},
    "rater_code": {"type": "string", "pattern": "^rater-[A-Za-z0-9_-]{4,40}$"},
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correctness", "completeness", "constraint_adherence", "evidence_and_verification"],
      "properties": {
        "correctness": {"type": "integer", "minimum": 0, "maximum": 2},
        "completeness": {"type": "integer", "minimum": 0, "maximum": 2},
        "constraint_adherence": {"type": "integer", "minimum": 0, "maximum": 2},
        "evidence_and_verification": {"type": "integer", "minimum": 0, "maximum": 2}
      }
    },
    "critical_failure": {"type": "boolean"},
    "rationale": {"type": "string", "maxLength": 2400}
  }
}