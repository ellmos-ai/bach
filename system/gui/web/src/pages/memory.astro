  async function loadWorkingTable() {
    const container = document.getElementById('working-table-container');
    if (!container) return;
    try {
      const res = await fetch('/api/memory/working');
      const data = await res.json();
      const items = data.working || [];
      container.innerHTML = items.length ? `
        <table class="data-table" style="width:100%;font-size:0.8rem;border-collapse:collapse;">
          <thead><tr><th style="padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">ID</th><th style="padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Typ</th><th style="padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Inhalt</th><th style="padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Erstellt</th></tr></thead>
          <tbody>
            ${items.map(w => `
              <tr>
                <td style="padding:0.5rem;border-bottom:1px solid var(--border);">#${safeId(w.id)}</td>
                <td style="padding:0.5rem;border-bottom:1px solid var(--border);"><span class="badge badge-accent">${escapeHtml(w.type || 'context')}</span></td>
                <td style="padding:0.5rem;border-bottom:1px solid var(--border);">${escapeHtml(w.content)}</td>
                <td style="padding:0.5rem;border-bottom:1px solid var(--border);">${escapeHtml(w.created_at || '-')}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      ` : '<p class="text-muted" style="padding:1rem;">Arbeitsgedächtnis aktuell leer.</p>';
    } catch (e) {
      container.textContent = 'Arbeitsgedächtnis konnte nicht geladen werden.';
    }
  }

  async function loadSessionsTable() {
    const container = document.getElementById('sessions-table-container');
    if (!container) return;
    try {
      const res = await fetch('/api/memory/sessions?limit=20');
      const data = await res.json();
      const sessions = data.sessions || [];
      container.innerHTML = sessions.length ? `
        <table class="data-table" style="width:100%;font-size:0.8rem;border-collapse:collapse;">
          <thead><tr><th style="padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">ID</th><th style="padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Session ID</th><th style="padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Start</th><th style="padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Ende</th><th style="padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Summary</th></tr></thead>
          <tbody>
            ${sessions.map(s => `
              <tr>
                <td style="padding:0.5rem;border-bottom:1px solid var(--border);">#${safeId(s.id)}</td>
                <td style="padding:0.5rem;border-bottom:1px solid var(--border);"><code>${escapeHtml(s.session_id ? String(s.session_id).substring(0, 16) + '...' : '-')}</code></td>
                <td style="padding:0.5rem;border-bottom:1px solid var(--border);">${escapeHtml(s.started_at || '-')}</td>
                <td style="padding:0.5rem;border-bottom:1px solid var(--border);">${escapeHtml(s.ended_at || '-')}</td>
                <td style="padding:0.5rem;border-bottom:1px solid var(--border);"><strong>${escapeHtml(s.summary || 'Arbeitssitzung')}</strong></td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      ` : '<p class="text-muted" style="padding:1rem;">Keine Sitzungen verzeichnet.</p>';
    } catch (e) {
      container.textContent = 'Sitzungen konnten nicht geladen werden.';
    }
  }

  async function searchMemory(event) {
    event.preventDefault();
    const query = document.getElementById('memory-search-query').value.trim();
    if (query.length < 2) return;
    const sourcesEl = document.getElementById('memory-search-sources');
    const resultsEl = document.getElementById('memory-search-results');
    sourcesEl.textContent = 'Quellen werden geprüft.';
    resultsEl.replaceChildren();
    try {
      const response = await fetch('/api/memory/search?q=' + encodeURIComponent(query) + '&limit=10');
      if (!response.ok) throw new Error('request_failed');
      const data = await response.json();
      sourcesEl.textContent = (data.sources || []).map(source =>
        source.source + ': ' + (source.availability === 'available'
          ? source.count + ' Treffer' : 'nicht verfügbar')
      ).join(' · ');
      for (const result of data.results || []) {
        const card = document.createElement('div');
        card.style.cssText = 'padding:0.75rem;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm)';
        const heading = document.createElement('strong');
        heading.textContent = result.source + ' · ' + result.type + ' · ' + result.title;
        const snippet = document.createElement('p');
        snippet.style.cssText = 'margin:0.35rem 0 0;font-size:0.8rem;color:var(--text-muted)';
        snippet.textContent = result.snippet;
        card.append(heading, snippet);
        resultsEl.appendChild(card);
      }
      if (!(data.results || []).length) resultsEl.textContent = 'Keine Treffer in den verfügbaren Quellen.';
    } catch (_) {
      sourcesEl.textContent = 'Quellenstatus nicht verfügbar.';
      resultsEl.textContent = 'Suche fehlgeschlagen.';
    }
  }
 
  // ═══════════════════════════════════════════════════════════════
  // HERMES SKILL-DESTILLATION CLIENT LOGIC
  // ═══════════════════════════════════════════════════════════════

  async function loadHermesStats() {
    try {
      const res = await fetch('/api/learning/hermes/stats');
      if (!res.ok) return;
      const data = await res.json();
      const setTxt = (id, val) => {
        const el = document.getElementById(id);
        if (el) el.textContent = val;
      };
      setTxt('hermes-stat-runs', data.total_runs ?? 0);
      setTxt('hermes-stat-noise', `${data.average_noise_reduction_percent ?? 0}%`);
      setTxt('hermes-stat-pending', data.pending_candidates ?? 0);
      setTxt('hermes-stat-approved', data.approved_candidates ?? 0);
      setTxt('hermes-stat-lessons', data.total_lessons_learned ?? 0);
    } catch (_) {}
  }

  async function loadHermesCandidates(status = 'pending') {
    const container = document.getElementById('hermes-candidates-container');
    if (!container) return;
    try {
      const res = await fetch(`/api/learning/hermes/candidates?status=${encodeURIComponent(status)}&limit=50`);
      const data = await res.json();
      const candidates = data.candidates || [];
      if (!candidates.length) {
        container.innerHTML = `<p class="text-muted" style="padding:1rem;">Keine Kandidaten mit Status '${escapeHtml(status)}' vorhanden.</p>`;
        return;
      }
      container.innerHTML = `
        <div style="display:flex;flex-direction:column;gap:0.75rem;">
          ${candidates.map(c => `
            <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm);padding:0.85rem;display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;flex-wrap:wrap;">
              <div style="flex:1;min-width:240px;">
                <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.25rem;">
                  <strong style="color:var(--text);font-size:0.9rem;">${escapeHtml(c.name)}</strong>
                  <span class="badge ${c.status === 'approved' ? 'badge-success' : (c.status === 'rejected' ? 'badge-danger' : 'badge-warning')}">${escapeHtml(c.status)}</span>
                  <span class="badge" style="background:var(--bg-panel);font-size:0.7rem;">v${escapeHtml(c.version || '1.0.0')}</span>
                </div>
                <div style="font-size:0.8rem;color:var(--text-muted);margin-bottom:0.4rem;">${escapeHtml(c.description || c.role || '')}</div>
                <div style="font-size:0.72rem;color:var(--text-muted);display:flex;gap:0.75rem;">
                  <span>Reduktion: <strong>${Math.round((c.noise_reduction_ratio || 0) * 100)}%</strong></span>
                  <span>Konfidenz: <strong>${Number(c.confidence || 0.85).toFixed(2)}</strong></span>
                  <span>Quelle: <strong>${escapeHtml(c.source_session || 'Ad-hoc')}</strong></span>
                </div>
              </div>
              <div style="display:flex;gap:0.4rem;align-items:center;flex-wrap:wrap;">
                <button class="btn btn-sm btn-secondary" onclick="viewCandidateModal(${safeId(c.id)})" title="SKILL.md Quellcode ansehen">📄 Anzeigen</button>
                ${c.status === 'pending' ? `
                  <button class="btn btn-sm btn-primary" onclick="approveCandidate(${safeId(c.id)})" style="background:var(--success);border-color:var(--success);">✅ Freigeben</button>
                  <button class="btn btn-sm btn-secondary" onclick="rejectCandidate(${safeId(c.id)})" style="color:var(--danger);">❌ Ablehnen</button>
                ` : ''}
              </div>
            </div>
          `).join('')}
        </div>
      `;
    } catch (_) {
      container.textContent = 'Skill-Kandidaten konnten nicht geladen werden.';
    }
  }

  async function submitHermesDistill() {
    const rawText = document.getElementById('hermes-input-text')?.value.trim();
    const sessionId = document.getElementById('hermes-input-session')?.value.trim();
    const hint = document.getElementById('hermes-input-hint')?.value.trim();
    const feedback = document.getElementById('hermes-distill-feedback');
    const resultBox = document.getElementById('hermes-result-container');
    const noiseBadge = document.getElementById('hermes-result-noise-badge');
    const details = document.getElementById('hermes-result-details');
    const btn = document.getElementById('btn-hermes-distill');

    if (!rawText && !sessionId) {
      if (feedback) feedback.textContent = 'Bitte Text oder Session-ID angeben.';
      return;
    }

    if (btn) btn.disabled = true;
    if (feedback) feedback.textContent = '⏳ Hermes destilliert (Rauschfilterung & Lessons)...';

    try {
      const res = await fetch('/api/learning/hermes/distill', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          session_id: sessionId || null,
          raw_text: rawText || null,
          skill_name_hint: hint || null
        })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.detail || 'Destillation fehlgeschlagen');

      if (feedback) feedback.textContent = `✅ Abgeschlossen (Run #${data.run_id})`;
      if (resultBox && noiseBadge && details) {
        resultBox.style.display = 'block';
        noiseBadge.textContent = `${data.noise_reduction_percent}% Rauschfilter`;
        details.innerHTML = `
          <div><strong>Kandidat erzeugt:</strong> <code>${escapeHtml(data.skill_candidate?.name || 'Skill')}</code> (${escapeHtml(data.skill_candidate?.category || 'utilities')})</div>
          <div><strong>Lessons Learned extrahiert:</strong> ${data.lessons_extracted?.length || 0}</div>
          <div style="margin-top:0.35rem;"><button class="btn btn-sm btn-secondary" onclick="viewCandidateModal(${safeId(data.skill_candidate?.id)})">📄 Erzeugten SKILL.md-Entwurf prüfen</button></div>
        `;
      }
      loadHermesStats();
      loadHermesCandidates('pending');
    } catch (e) {
      if (feedback) feedback.textContent = `❌ Fehler: ${e.message}`;
    } finally {
      if (btn) btn.disabled = false;
    }
  }

  async function approveCandidate(candidateId) {
    if (!confirm(`Kandidat #${candidateId} wirklich freigeben und in skill_versions aufnehmen?`)) return;
    try {
      const res = await fetch(`/api/learning/hermes/candidates/${candidateId}/approve`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ approved_by: 'operator' })
      });
      if (res.ok) {
        loadHermesStats();
        loadHermesCandidates('pending');
      } else {
        alert('Freigabe fehlgeschlagen');
      }
    } catch (_) {
      alert('Netzwerkfehler');
    }
  }

  async function rejectCandidate(candidateId) {
    const reason = prompt('Begründung für die Ablehnung (optional):', '');
    if (reason === null) return;
    try {
      const res = await fetch(`/api/learning/hermes/candidates/${candidateId}/reject`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason: reason || 'Vom Operator abgelehnt' })
      });
      if (res.ok) {
        loadHermesStats();
        loadHermesCandidates('pending');
      }
    } catch (_) {}
  }

  async function viewCandidateModal(candidateId) {
    try {
      const res = await fetch(`/api/learning/hermes/candidates/${candidateId}`);
      if (!res.ok) return alert('Kandidat nicht gefunden');
      const cand = await res.json();
      const modal = document.getElementById('hermes-candidate-modal');
      const title = document.getElementById('hermes-modal-title');
      const content = document.getElementById('hermes-modal-content');
      if (modal && title && content) {
        title.textContent = `SKILL.md: ${cand.name} (v${cand.version})`;
        content.textContent = cand.content || '';
        modal.style.display = 'flex';
      }
    } catch (_) {
      alert('Kandidat konnte nicht geladen werden');
    }
  }

  function closeCandidateModal() {
    const modal = document.getElementById('hermes-candidate-modal');
    if (modal) modal.style.display = 'none';
  }

  document.addEventListener('DOMContentLoaded', () => {
    loadCognitiveState();
    loadFactsTable();
    loadHermesStats();
    document.getElementById('memory-search-form').addEventListener('submit', searchMemory);
  });
</script>
