          <div style="padding:0.5rem;background:var(--bg-card);border-radius:var(--radius-sm);border:1px solid var(--border);">
            <div style="font-size:1.2rem;font-weight:700;color:var(--text);" id="stat-facts">Nicht geprüft</div>
            <div style="font-size:0.75rem;color:var(--text-muted);">memory_facts</div>
          </div>
          <div style="padding:0.5rem;background:var(--bg-card);border-radius:var(--radius-sm);border:1px solid var(--border);">
            <div style="font-size:1.2rem;font-weight:700;color:var(--text);" id="stat-lessons">Nicht geprüft</div>
            <div style="font-size:0.75rem;color:var(--text-muted);">memory_lessons</div>
          </div>
          <div style="padding:0.5rem;background:var(--bg-card);border-radius:var(--radius-sm);border:1px solid var(--border);">
            <div style="font-size:1.2rem;font-weight:700;color:var(--text);" id="stat-sessions">Nicht geprüft</div>
            <div style="font-size:0.75rem;color:var(--text-muted);">memory_sessions</div>
          </div>
          <div style="padding:0.5rem;background:var(--bg-card);border-radius:var(--radius-sm);border:1px solid var(--border);">
            <div style="font-size:1.2rem;font-weight:700;color:var(--text);" id="stat-working">Nicht geprüft</div>
            <div style="font-size:0.75rem;color:var(--text-muted);">memory_working</div>
          </div>
        </div>

        <div style="margin-top:1.5rem;border-top:1px solid var(--border);padding-top:1.25rem;">
          <h4 style="margin:0 0 0.5rem 0;color:var(--text);">Gedächtnisquellen durchsuchen</h4>
          <p style="font-size:0.8rem;color:var(--text-muted);">BACH, Gardener und USMC werden getrennt und nur lesend abgefragt. Fehlende Quellen erscheinen als nicht verfügbar.</p>
          <form id="memory-search-form" style="display:flex;gap:0.5rem;flex-wrap:wrap;">
            <input id="memory-search-query" type="search" minlength="2" maxlength="200" required placeholder="Suchbegriff" style="flex:1;min-width:12rem;padding:0.4rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:4px;color:var(--text);" />
            <button type="submit" class="btn btn-sm btn-primary">Suchen</button>
          </form>
          <div id="memory-search-sources" style="margin-top:0.75rem;font-size:0.8rem;color:var(--text-muted);">Quellenstatus wird beim Suchen geprüft.</div>
          <div id="memory-search-results" style="margin-top:0.75rem;display:flex;flex-direction:column;gap:0.5rem;"></div>
        </div>

        <!-- Interaktiver Tabellen-Inspektor & Editor fuer bach.db -->
        <div style="margin-top:1.5rem;border-top:1px solid var(--border);padding-top:1.25rem;">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;flex-wrap:wrap;gap:0.5rem;">
            <h4 style="margin:0;font-size:1.05rem;color:var(--text);display:flex;align-items:center;gap:0.4rem;">
              <span>🔍</span> Interaktive bach.db Tabellen-Inspektion & Bearbeitung
            </h4>
            <div style="display:flex;gap:0.35rem;">
              <button class="db-tab-btn active" data-dbtab="facts" onclick="switchDbTab('facts')">Fakten</button>
              <button class="db-tab-btn" data-dbtab="lessons" onclick="switchDbTab('lessons')">Lessons</button>
              <button class="db-tab-btn" data-dbtab="working" onclick="switchDbTab('working')">Working</button>
              <button class="db-tab-btn" data-dbtab="sessions" onclick="switchDbTab('sessions')">Sessions</button>
            </div>
          </div>

          <!-- TAB: FACTS -->
          <div id="dbtab-facts" class="dbtab-pane">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem;">
              <span style="font-size:0.8rem;color:var(--text-muted);">Tabelle: <code>memory_facts</code></span>
              <button class="btn btn-sm btn-primary" onclick="toggleAddFactForm()">+ Neuer Fakt</button>
            </div>
            <!-- Add Fact Form -->
            <form id="form-add-fact" style="display:none;background:rgba(255,255,255,0.02);padding:1rem;border-radius:var(--radius-sm);border:1px solid var(--border);margin-bottom:1rem;" onsubmit="event.preventDefault(); submitNewFact();">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-bottom:0.75rem;">
                <div>
                  <label style="display:block;font-size:0.75rem;color:var(--text-muted);">Kategorie</label>
                  <input type="text" id="new-fact-cat" placeholder="z. B. system, user, architektur" required style="width:100%;padding:0.4rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:4px;color:var(--text);" />
                </div>
                <div>
                  <label style="display:block;font-size:0.75rem;color:var(--text-muted);">Schlüssel (Key)</label>
                  <input type="text" id="new-fact-key" placeholder="z. B. preferred_os, git_guard" required style="width:100%;padding:0.4rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:4px;color:var(--text);" />
                </div>
              </div>
              <div style="margin-bottom:0.75rem;">
                <label style="display:block;font-size:0.75rem;color:var(--text-muted);">Wert (Value)</label>
                <input type="text" id="new-fact-val" placeholder="Wert oder Inhalt des Fakts..." required style="width:100%;padding:0.4rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:4px;color:var(--text);" />
              </div>
              <button type="submit" class="btn btn-sm btn-primary">Fakt speichern</button>
              <button type="button" class="btn btn-sm btn-secondary" onclick="toggleAddFactForm()">Abbrechen</button>
            </form>
            <div id="facts-table-container">
              <p class="loading-state">Lade Fakten...</p>
            </div>
          </div>

          <!-- TAB: LESSONS -->
          <div id="dbtab-lessons" class="dbtab-pane" style="display:none;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem;">
              <span style="font-size:0.8rem;color:var(--text-muted);">Tabelle: <code>memory_lessons</code></span>
              <button class="btn btn-sm btn-primary" onclick="toggleAddLessonForm()">+ Neue Lesson</button>
            </div>
            <!-- Add Lesson Form -->
            <form id="form-add-lesson" style="display:none;background:rgba(255,255,255,0.02);padding:1rem;border-radius:var(--radius-sm);border:1px solid var(--border);margin-bottom:1rem;" onsubmit="event.preventDefault(); submitNewLesson();">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-bottom:0.75rem;">
                <div>
                  <label style="display:block;font-size:0.75rem;color:var(--text-muted);">Kategorie</label>
                  <input type="text" id="new-lesson-cat" placeholder="z. B. best_practice, bugfix, workflow" required style="width:100%;padding:0.4rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:4px;color:var(--text);" />
                </div>
                <div>
                  <label style="display:block;font-size:0.75rem;color:var(--text-muted);">Titel / Problem</label>
                  <input type="text" id="new-lesson-title" placeholder="Kurzbeschreibung..." required style="width:100%;padding:0.4rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:4px;color:var(--text);" />
                </div>
              </div>
              <div style="margin-bottom:0.75rem;">
                <label style="display:block;font-size:0.75rem;color:var(--text-muted);">Lösung / Best Practice (Solution)</label>
                <textarea id="new-lesson-solution" rows="2" placeholder="Gefundene Lösung oder Verhaltensregel..." required style="width:100%;padding:0.4rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:4px;color:var(--text);"></textarea>
              </div>
              <button type="submit" class="btn btn-sm btn-primary">Lesson speichern</button>
              <button type="button" class="btn btn-sm btn-secondary" onclick="toggleAddLessonForm()">Abbrechen</button>
            </form>
            <div id="lessons-table-container">
              <p class="loading-state">Lade Lessons...</p>
            </div>
          </div>

          <!-- TAB: WORKING -->
          <div id="dbtab-working" class="dbtab-pane" style="display:none;">
            <div id="working-table-container">
              <p class="loading-state">Lade Arbeitsgedächtnis...</p>
            </div>
          </div>

          <!-- TAB: SESSIONS -->
          <div id="dbtab-sessions" class="dbtab-pane" style="display:none;">
            <div id="sessions-table-container">
              <p class="loading-state">Lade Sitzungen...</p>
            </div>
          </div>
        </div>
      </div>
    </div>

  <!-- Hermes Candidate Inspector Modal -->
  <div id="hermes-candidate-modal" style="display:none;position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(0,0,0,0.75);backdrop-filter:blur(4px);z-index:9999;justify-content:center;align-items:center;padding:1.5rem;">
    <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-md);width:100%;max-width:850px;max-height:85vh;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 12px 36px rgba(0,0,0,0.5);">
      <div style="display:flex;justify-content:space-between;align-items:center;padding:1rem 1.25rem;border-bottom:1px solid var(--border);background:var(--bg-panel);">
        <strong id="hermes-modal-title" style="font-size:1rem;color:var(--text);">SKILL.md Entwurf</strong>
        <button class="btn btn-sm btn-secondary" onclick="closeCandidateModal()">✕ Schließen</button>
      </div>
      <div style="padding:1.25rem;overflow-y:auto;flex:1;">
        <pre id="hermes-modal-content" style="background:var(--bg-dark);color:var(--text);padding:1rem;border-radius:var(--radius-sm);font-family:monospace;font-size:0.8rem;white-space:pre-wrap;line-height:1.5;border:1px solid var(--border);margin:0;"></pre>
      </div>
    </div>
  </div>

</BachLayout>

<style>
  /* ═══════════════════════════════════════════════════════════════
     THEME-AWARE STYLING (DARK, LIGHT, OCEAN, WARM)
     ═══════════════════════════════════════════════════════════════ */

  .process-board {
    background: var(--bg-card);
    transition: background var(--duration) var(--ease), border-color var(--duration) var(--ease);
  }

  /* View Switcher Buttons */
  .view-btn {
    border: none;
    background: transparent;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--duration) var(--ease);
  }

  .view-btn.active {
    background: var(--bg-card);
    color: var(--text);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
  }

  .view-btn:hover:not(.active) {
    color: var(--text);
  }

  /* SVG Node Styling */
  .node-box {
    fill: var(--bg-panel);
    stroke: var(--border);
    stroke-width: 1.5;
    transition: all 180ms ease;
  }

  .node-diamond {
    fill: var(--bg-panel);
    stroke: var(--warning);
    stroke-width: 1.5;
    transition: all 180ms ease;
  }

  .node-box-ze {
    stroke: var(--accent);
    stroke-width: 2;
  }

  .node-box-hooker {
    stroke: var(--success);
    stroke-width: 2;
  }

  .node-box-start {
    stroke: var(--accent-blue);
    stroke-width: 1.5;
  }

  .node-box-center {
    fill: var(--bg-elevated);
    stroke: var(--accent);
    stroke-width: 2.5;
  }

  .node-box-db {
    stroke: var(--border);
  }

  .node-title {
    fill: var(--text);
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  }

  .node-sub {
    fill: var(--text-muted);
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  }

  .node-title-center {
    fill: var(--text);
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  }

  .node-sub-center {
    fill: var(--text-muted);
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  }

  .svg-wire-label {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  }

  /* Hover & Active Node State */
  .svg-node:hover .node-box,
  .svg-node:hover .node-diamond {
    stroke: var(--accent-light);
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.15));
  }

  .svg-node.active-node .node-box,
  .svg-node.active-node .node-diamond {
    stroke: var(--accent);
    stroke-width: 2.5;
  }

  /* Inspector Tabs */
  .insp-tab-btn {
    border: none;
    background: transparent;
    color: var(--text-muted);
    padding: 0.5rem 0.85rem;
    font-size: 0.825rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
    cursor: pointer;
    white-space: nowrap;
    transition: all var(--duration) var(--ease);
  }

  .insp-tab-btn.active {
    background: var(--bg-elevated);
    color: var(--text);
    border-bottom: 2px solid var(--accent);
  }

  .insp-tab-btn:hover:not(.active) {
    color: var(--text);
    background: var(--bg-panel);
  }

  /* ═══════════════════════════════════════════════════════════════
     HIGH-CONTRAST LIGHT MODE SPECIFICS
     ═══════════════════════════════════════════════════════════════ */
  :global([data-theme="light"]) .process-board {
    background: #ffffff;
    border-color: #cbd5e1;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  :global([data-theme="light"]) .node-box {
    fill: #ffffff;
    stroke: #cbd5e1;
  }

  :global([data-theme="light"]) .node-diamond {
    fill: #ffffff;
    stroke: #d97706;
  }

  :global([data-theme="light"]) .node-box-center {
    fill: #f8fafc;
    stroke: #c83a4e;
  }

  :global([data-theme="light"]) .node-box-ze {
    stroke: #c83a4e;
  }

  :global([data-theme="light"]) .node-box-hooker {
    stroke: #16a34a;
  }

  :global([data-theme="light"]) .node-title,
  :global([data-theme="light"]) .node-title-center {
    fill: #0f172a;
  }

  :global([data-theme="light"]) .node-sub,
  :global([data-theme="light"]) .node-sub-center {
    fill: #475569;
  }

  :global([data-theme="light"]) .svg-wire-label {
    fill: #334155;
  }

  :global([data-theme="light"]) .flow-wire {
    opacity: 0.9;
  }
</style>

<script is:inline>
  // ═══════════════════════════════════════════════════════════════
  // CLIENT INTERACTIVITY: VIEW SWITCHER & INSPECTOR TABS
  // ═══════════════════════════════════════════════════════════════

  function selectInspector(tabKey) {
    // 1. Alle Tabs deselektieren
    document.querySelectorAll('.insp-tab-btn').forEach(btn => btn.classList.remove('active'));
    document.querySelectorAll('.insp-panel').forEach(p => p.style.display = 'none');

    // 2. Ziel-Tab aktivieren
    const targetBtn = document.getElementById('tab-btn-' + tabKey);
    const targetPanel = document.getElementById('panel-' + tabKey);
    if (targetBtn) targetBtn.classList.add('active');
    if (targetPanel) targetPanel.style.display = 'block';

    // 3. SVG Node hervorheben
    document.querySelectorAll('.svg-node').forEach(node => {
      node.classList.remove('active-node');
      if (node.getAttribute('data-target') === tabKey) {
        node.classList.add('active-node');
      }
    });

    // 4. Tab-spezifische Daten nachladen
    if (tabKey === 'learn') {
      loadHermesStats();
      loadHermesCandidates('pending');
    }
  }

  function switchView(viewMode) {
    document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
    const btn = document.getElementById('btn-view-' + viewMode);
    if (btn) btn.classList.add('active');

    const svgC = document.getElementById('view-svg-container');
    const mrmC = document.getElementById('view-mermaid-container');
    const cdeC = document.getElementById('view-code-container');

    if (svgC) svgC.style.display = (viewMode === 'svg') ? 'block' : 'none';
    if (mrmC) mrmC.style.display = (viewMode === 'mermaid') ? 'block' : 'none';
    if (cdeC) cdeC.style.display = (viewMode === 'code') ? 'block' : 'none';

    if (viewMode === 'mermaid') {
      renderMermaidDiagram();
    }
  }

  // Mermaid Rendering mit Theme-Anpassung
  let mermaidLoaded = false;
  async function renderMermaidDiagram() {
    const target = document.getElementById('mermaid-render-target');
    if (!target) return;

    try {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      const themeName = isLight ? 'default' : 'dark';

      if (!mermaidLoaded) {
        const module = await import('https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs');
        window.mermaid = module.default;
        mermaidLoaded = true;
      }

      window.mermaid.initialize({
        startOnLoad: false,
        theme: themeName,
        securityLevel: 'loose',
        flowchart: { curve: 'basis', htmlLabels: true }
      });

      const rawCode = document.getElementById('mermaid-raw-code').innerText;
      const { svg } = await window.mermaid.render('mermaid-svg-chart', rawCode);
      target.innerHTML = svg;
    } catch (err) {
      target.innerHTML = `<div style="color:var(--text-muted);font-size:0.875rem;padding:1rem;">
        Mermaid-Renderer offline oder blockiert. Nutze den interaktiven Prozess-Graphen. (Info: ${err.message})
      </div>`;
    }
  }

  function copyMermaidCode() {
    const raw = document.getElementById('mermaid-raw-code').innerText;
    navigator.clipboard.writeText(raw).then(() => {
      const btn = document.getElementById('btn-copy-mermaid');
      if (btn) {
        btn.innerText = '✅ Kopiert!';
        setTimeout(() => { btn.innerText = '📋 Code kopieren'; }, 2000);
      }
    });
  }

  // Theme-Beobachter für SVG und Mermaid
  const themeObserver = new MutationObserver(() => {
    const mrmC = document.getElementById('view-mermaid-container');
    if (mrmC && mrmC.style.display !== 'none' && mermaidLoaded) {
      renderMermaidDiagram();
    }
  });
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  // Initialdaten laden
  async function loadCognitiveState() {
    try {
      const res = await fetch('/api/memory/cognitive-state');
      if (res.ok) {
        const data = await res.json();
        if (data.langzeit_gedaechtnis) {
          const lzg = data.langzeit_gedaechtnis;
          for (const [key, id] of Object.entries({facts: 'stat-facts', lessons: 'stat-lessons', sessions: 'stat-sessions', working: 'stat-working'})) {
            const count = lzg[key]?.count;
            document.getElementById(id).textContent = Number.isInteger(count) ? count.toLocaleString('de-DE') : 'Nicht geprüft';
          }
        }
      }
    } catch (e) {
      // Unknown remains visible when the live source cannot be read.
    }
  }

  // Interaktive DB Tabellen Umschaltung & CRUD
  function switchDbTab(tab) {
    document.querySelectorAll('.db-tab-btn').forEach(btn => {
      btn.classList.toggle('active', btn.getAttribute('data-dbtab') === tab);
    });
    document.querySelectorAll('.dbtab-pane').forEach(p => p.style.display = 'none');
    const target = document.getElementById('dbtab-' + tab);
    if (target) target.style.display = 'block';

    if (tab === 'facts') loadFactsTable();
    else if (tab === 'lessons') loadLessonsTable();
    else if (tab === 'working') loadWorkingTable();
    else if (tab === 'sessions') loadSessionsTable();
  }

  function toggleAddFactForm() {
    const f = document.getElementById('form-add-fact');
    if (f) f.style.display = f.style.display === 'none' ? 'block' : 'none';
  }

  function escapeHtml(value) {
    const node = document.createElement('span');
    node.textContent = String(value ?? '');
    return node.innerHTML;
  }

  function safeId(value) {
    const id = Number(value);
    return Number.isSafeInteger(id) && id >= 0 ? id : 0;
  }

  function toggleAddLessonForm() {
    const f = document.getElementById('form-add-lesson');
    if (f) f.style.display = f.style.display === 'none' ? 'block' : 'none';
  }

  async function loadFactsTable() {
    const container = document.getElementById('facts-table-container');
    if (!container) return;
    try {
      const res = await fetch('/api/memory/facts?limit=50');
      const data = await res.json();
      const facts = data.facts || [];
      if (!facts.length) {
        container.innerHTML = '<p class="text-muted" style="padding:1rem;">Keine Fakten in memory_facts gefunden.</p>';
        return;
      }
      container.innerHTML = `
        <table class="data-table" style="width:100%;font-size:0.8rem;border-collapse:collapse;">
          <thead>
            <tr>
              <th style="padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">ID</th>
              <th style="padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Kategorie</th>
              <th style="padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Key</th>
              <th style="padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Value</th>
              <th style="padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Konfidenz</th>
              <th style="padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Aktion</th>
            </tr>
          </thead>
          <tbody>
            ${facts.map(f => `
              <tr>
                <td style="padding:0.5rem;border-bottom:1px solid var(--border);">#${safeId(f.id)}</td>
                <td style="padding:0.5rem;border-bottom:1px solid var(--border);"><span class="badge badge-accent">${escapeHtml(f.category || 'general')}</span></td>
                <td style="padding:0.5rem;border-bottom:1px solid var(--border);"><strong>${escapeHtml(f.key)}</strong></td>
                <td style="padding:0.5rem;border-bottom:1px solid var(--border);max-width:300px;word-break:break-all;">${escapeHtml(f.value)}</td>
                <td style="padding:0.5rem;border-bottom:1px solid var(--border);">${Number(f.confidence ?? 1).toFixed(2)}</td>
                <td style="padding:0.5rem;border-bottom:1px solid var(--border);">
                  <button class="btn btn-sm btn-secondary" style="color:var(--danger);padding:0.2rem 0.5rem;" onclick="deleteFact(${safeId(f.id)})">Löschen</button>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
    } catch (e) {
      container.textContent = 'Fakten konnten nicht geladen werden.';
    }
  }

  async function submitNewFact() {
    const category = document.getElementById('new-fact-cat').value.trim();
    const key = document.getElementById('new-fact-key').value.trim();
    const value = document.getElementById('new-fact-val').value.trim();
    if (!key || !value) return;
    try {
      const res = await fetch('/api/memory/facts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ category, key, value, confidence: 1.0 })
      });
      if (res.ok) {
        toggleAddFactForm();
        document.getElementById('new-fact-key').value = '';
        document.getElementById('new-fact-val').value = '';
        loadFactsTable();
        loadCognitiveState();
      } else {
        alert('Fehler beim Speichern des Fakts');
      }
    } catch (e) {
      alert('Netzwerkfehler: ' + e.message);
    }
  }

  async function deleteFact(id) {
    if (!confirm('Fakt wirklich löschen?')) return;
    try {
      const res = await fetch('/api/memory/facts/' + id, { method: 'DELETE' });
      if (res.ok) {
        loadFactsTable();
        loadCognitiveState();
      }
    } catch (e) {
      alert('Fehler: ' + e.message);
    }
  }

  async function loadLessonsTable() {
    const container = document.getElementById('lessons-table-container');
    if (!container) return;
    try {
      const res = await fetch('/api/memory/lessons?limit=50');
      const data = await res.json();
      const lessons = data.lessons || [];
      if (!lessons.length) {
        container.innerHTML = '<p class="text-muted" style="padding:1rem;">Keine aktiven Lessons in memory_lessons.</p>';
        return;
      }
      container.innerHTML = `
        <table class="data-table" style="width:100%;font-size:0.8rem;border-collapse:collapse;">
          <thead>
            <tr>
              <th style="padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">ID</th>
              <th style="padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Kategorie</th>
              <th style="padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Titel / Problem</th>
              <th style="padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Lösung / Best Practice</th>
              <th style="padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Aktiv</th>
              <th style="padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Aktion</th>
            </tr>
          </thead>
          <tbody>
            ${lessons.map(l => `
              <tr>
                <td style="padding:0.5rem;border-bottom:1px solid var(--border);">#${safeId(l.id)}</td>
                <td style="padding:0.5rem;border-bottom:1px solid var(--border);"><span class="badge badge-accent">${escapeHtml(l.category || 'general')}</span></td>
                <td style="padding:0.5rem;border-bottom:1px solid var(--border);"><strong>${escapeHtml(l.title)}</strong></td>
                <td style="padding:0.5rem;border-bottom:1px solid var(--border);max-width:320px;word-break:break-word;">${escapeHtml(l.content || '-')}</td>
                <td style="padding:0.5rem;border-bottom:1px solid var(--border);"><span class="badge ${l.is_active ? 'badge-success' : 'badge-secondary'}">${l.is_active ? 'Ja' : 'Nein'}</span></td>
                <td style="padding:0.5rem;border-bottom:1px solid var(--border);white-space:nowrap;">
                  <button class="btn btn-sm btn-secondary" style="padding:0.2rem 0.5rem;" onclick="toggleLesson(${safeId(l.id)})">Umschalten</button>
                  <button class="btn btn-sm btn-secondary" style="color:var(--danger);padding:0.2rem 0.5rem;" onclick="deleteLesson(${safeId(l.id)})">Löschen</button>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
    } catch (e) {
      container.textContent = 'Lessons konnten nicht geladen werden.';
    }
  }

  async function submitNewLesson() {
