---
// memory.astro - Kognitiver Memory-Schaltplan & Prozess-Topologie
// Arbeitsgedächtnismodell (Baddeley) • Zentrale Exekutive mit Sensoren & Messtechnik
// Selbstkontroll-Guards (Deterministische Skripte & Lebendige LLM-Guards)
// Berechtigungskontrolle & Hooker-Injektoren (Reine Zustell-Pipeline)
// Startprompt-Synthese (Einmaliger Boot-Bus) • Langzeitgedächtnis (bach.db)
import BachLayout from "../layouts/BachLayout.astro";

const mermaidCode = `flowchart TD
    subgraph ZE ["1. Zentrale Exekutive & Messtechnik"]
        EXEC["Zentrale Exekutive (Aufsicht & Willensbildung / SAS)"]
        SENS["Sensoren & Messtechnik (Context-Reader, Token-Monitor, Stress-Detektor)"]
        EXEC -->|"Aufsichts-Auftrag"| SENS
    end

    subgraph SK ["2. Selbstkontroll-Mechanismen (Die eigentlichen Kontrolleure)"]
        DG["Deterministische Skript-Guards (P-001 Git-Sperre, Pfad-Locks, Regex-Filter)"]
        LG["Lebendige LLM-Guards (/goal Evaluator, Disambiguierung, Konsistenz)"]
        SENS -->|"Messdaten & Limits"| DG
        SENS -->|"CoT-Auszüge & Drift"| LG
    end

    subgraph GATE ["3. Berechtigungskontrolle (Decision Gate)"]
        DEC{"Injektion freigegeben?"}
        DG -->|"Skript-Check OK"| DEC
        LG -->|"Guard-Freigabe"| DEC
    end

    subgraph HOOK ["4. Hooker (Reine Injektoren / Zustell-Kanal)"]
        HK["Hooker Injektor-Pipeline (Reine Zustellung ohne eigene Kontrolllogik)"]
        DEC -->|"Autorisierter Payload (Gedanke / Faktenanker)"| HK
    end

    subgraph BOOT ["5. Startprompt-Synthese (Einmaliger Start)"]
        SP["Startprompt: Agent (Rolle + Persona + Skills + Governance) + System + Aufgabe"]
    end

    subgraph CTX ["6. Zentrum: Aktives Kontextfenster"]
        KW["Aktives Kontextfenster (Phonologische Schleife & CoT)"]
        SP -->|"Einmaliger Boot-Bus"| KW
        HK -->|"Einziger dynamischer Einlass"| KW
    end

    subgraph MEM ["7. Langzeitgedächtnis (bach.db)"]
        LTM[("Langzeitgedächtnis (Fakten, Sessions, Lessons)")]
        LTM -.->|"Pfad A: Boot-Kontext"| SP
        KW -->|"Pfad B: Aktiver Tool-Pull (z.B. bach mem query)"| LTM
        LTM -.->|"Pfad C: Reaktiv über Guards"| SK
    end

    subgraph LEARN ["8. Lern- & Konsolidierungssystem"]
        CL["Kognitives Lernen (76% Rauschfilter)"]
        KW -->|"Rohdaten-Strom"| CL
        CL -->|"Destilliertes Wissen"| LTM
    end`;
---

<BachLayout title="Kognitiver Memory-Schaltplan" currentPath="/memory">
  <!-- Header mit echten kognitiven Status-Indikatoren -->
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem;">
    <div>
      <h1 style="font-size:1.75rem;font-weight:800;letter-spacing:-0.02em;margin-bottom:0.25rem;color:var(--text);">
        🧠 Kognitiver Memory-Schaltplan & Prozess-Topologie
      </h1>
      <p style="color:var(--text-muted);font-size:0.875rem;">
        Arbeitsgedächtnismodell (Baddeley) • Zentrale Exekutive mit Sensoren & Messtechnik • Selbstkontroll-Guards • Hooker-Zustellpipeline • Langzeitgedächtnis (bach.db)
      </p>
    </div>

    <!-- Live Kognitions-Statuschips -->
    <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
      <span class="badge badge-success" id="chip-sys-status">● Kontextfenster Gesund</span>
      <span class="badge" style="background:color-mix(in srgb, var(--accent) 15%, transparent);color:var(--accent);border:1px solid color-mix(in srgb, var(--accent) 30%, transparent);">👑 Exekutive: SAS Aktiv</span>
      <span class="badge" style="background:color-mix(in srgb, var(--accent-blue) 15%, transparent);color:var(--accent-blue);border:1px solid color-mix(in srgb, var(--accent-blue) 30%, transparent);">🛡️ Guards: 2-Stufig</span>
      <span class="badge" style="background:color-mix(in srgb, var(--success) 15%, transparent);color:var(--success);border:1px solid color-mix(in srgb, var(--success) 30%, transparent);">💉 Hooker: Zustell-Bereit</span>
      <span class="badge" style="background:var(--bg-elevated);color:var(--text);border:1px solid var(--border);" id="chip-tokens">🗣️ 1.420 / 200k Tokens (0.7%)</span>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- 1. PROZESS-VISUALISIERUNG & SCHALTPLAN (THEME-AWARE SVG & MERMAID) -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <div class="card process-board" style="margin-bottom:2rem;border:1px solid var(--border);background:var(--bg-card);position:relative;overflow:hidden;padding:1.25rem;">

    <!-- Oberer Steuerungsbalken mit Darstellungs-Umschalter -->
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem;flex-wrap:wrap;gap:1rem;border-bottom:1px solid var(--border);padding-bottom:0.75rem;">
      <div style="display:flex;align-items:center;gap:0.6rem;">
        <span style="font-size:1.3rem;">⚡</span>
        <div>
          <h2 style="margin:0;font-size:1.1rem;font-weight:700;color:var(--text);">
            Kognitive Prozess-Topologie: Signale, Sensoren & Injektions-Engpass
          </h2>
          <span style="font-size:0.75rem;color:var(--text-muted);">
            Klick auf einen Baustein öffnet direkt den zugehörigen Inspektions- und Bearbeitungsbereich darunter.
          </span>
        </div>
      </div>

      <!-- Ansichten-Tabs -->
      <div class="view-switcher" style="display:flex;gap:0.35rem;background:var(--bg-panel);padding:3px;border-radius:var(--radius-sm);border:1px solid var(--border);">
        <button class="view-btn active" id="btn-view-svg" onclick="switchView('svg')" type="button">
          📊 Interaktiver Prozess-Graph
        </button>
        <button class="view-btn" id="btn-view-mermaid" onclick="switchView('mermaid')" type="button">
          🧜‍♀️ Mermaid Live-Diagramm
        </button>
        <button class="view-btn" id="btn-view-code" onclick="switchView('code')" type="button">
          📋 Mermaid-Code & Export
        </button>
      </div>
    </div>

    <!-- ANSICHT 1: INTERAKTIVER VEKTOR-PROZESS-GRAPH (SVG) -->
    <div id="view-svg-container" class="diagram-viewport" style="width:100%;overflow-x:auto;">
      <svg id="cognitive-svg" viewBox="0 0 1100 680" style="width:100%;min-width:960px;height:auto;display:block;">
        <defs>
          <!-- Marker für Pfeilspitzen (Standard, Accent, Success, Warning) -->
          <marker id="arrow-default" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--text-dim)"></path>
          </marker>
          <marker id="arrow-accent" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)"></path>
          </marker>
          <marker id="arrow-blue" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent-blue)"></path>
          </marker>
          <marker id="arrow-success" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--success)"></path>
          </marker>
          <marker id="arrow-warning" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--warning)"></path>
          </marker>
        </defs>

        <!-- ── VERBINDUNGSLINIEN (SIGNAL-BUSSE) ── -->
        <!-- ZE -> Sensoren -->
        <path d="M 550,56 L 550,86" stroke="var(--accent)" stroke-width="2.5" marker-end="url(#arrow-accent)" fill="none" class="flow-wire"></path>
        <text x="558" y="75" class="svg-wire-label" fill="var(--text-muted)" font-size="10">Aufsichts-Auftrag</text>

        <!-- Sensoren -> Guards -->
        <path d="M 450,135 L 350,175" stroke="var(--border-hover)" stroke-width="2" marker-end="url(#arrow-default)" fill="none" class="flow-wire"></path>
        <text x="355" y="152" class="svg-wire-label" fill="var(--text-muted)" font-size="9.5">Limits & PreTool</text>

        <path d="M 650,135 L 750,175" stroke="var(--border-hover)" stroke-width="2" marker-end="url(#arrow-default)" fill="none" class="flow-wire"></path>
        <text x="690" y="152" class="svg-wire-label" fill="var(--text-muted)" font-size="9.5">CoT-Auszüge & Drift</text>

        <!-- Guards -> Berechtigungskontrolle (Diamond) -->
        <path d="M 350,225 L 490,265" stroke="var(--border-hover)" stroke-width="2" marker-end="url(#arrow-default)" fill="none" class="flow-wire"></path>
        <path d="M 750,225 L 610,265" stroke="var(--border-hover)" stroke-width="2" marker-end="url(#arrow-default)" fill="none" class="flow-wire"></path>

        <!-- Berechtigungskontrolle -> Hooker (Injektor) -->
        <path d="M 550,300 L 550,345" stroke="var(--success)" stroke-width="2.5" marker-end="url(#arrow-success)" fill="none" class="flow-wire" stroke-dasharray="4 2"></path>
        <text x="558" y="325" class="svg-wire-label" fill="var(--success)" font-size="10" font-weight="600">Autorisierter Payload</text>

        <!-- Hooker -> Kontextfenster -->
        <path d="M 550,395 L 550,440" stroke="var(--success)" stroke-width="3" marker-end="url(#arrow-success)" fill="none" class="flow-wire"></path>
        <text x="558" y="420" class="svg-wire-label" fill="var(--success)" font-size="10.5" font-weight="bold">Physische Injektion</text>

        <!-- Startprompt -> Kontextfenster (Boot-Bus) -->
        <path d="M 170,395 L 170,470 L 370,470" stroke="var(--accent-blue)" stroke-width="2.5" marker-end="url(#arrow-blue)" fill="none" class="flow-wire"></path>
        <text x="180" y="462" class="svg-wire-label" fill="var(--accent-blue)" font-size="10" font-weight="600">Einmaliger Boot-Bus</text>

        <!-- Kontextfenster -> Lernen -->
        <path d="M 550,520 L 550,565" stroke="var(--accent)" stroke-width="2" marker-end="url(#arrow-accent)" fill="none" class="flow-wire"></path>
        <text x="558" y="546" class="svg-wire-label" fill="var(--text-muted)" font-size="10">Rohdaten-Strom</text>

        <!-- Lernen -> Langzeitgedächtnis -->
        <path d="M 670,590 L 890,590" stroke="var(--success)" stroke-width="2" marker-end="url(#arrow-success)" fill="none" class="flow-wire"></path>
        <text x="710" y="582" class="svg-wire-label" fill="var(--text-muted)" font-size="10">Destillierte Fakten & Lessons</text>

        <!-- Kontextfenster -> Langzeitgedächtnis (Aktiver Tool-Pull) -->
        <path d="M 730,475 L 890,475" stroke="var(--warning)" stroke-width="2" marker-end="url(#arrow-warning)" fill="none" class="flow-wire"></path>
        <text x="745" y="467" class="svg-wire-label" fill="var(--warning)" font-size="10" font-weight="600">Aktiver Tool-Pull (Pull-Request)</text>

        <!-- Langzeitgedächtnis -> Startprompt (Pfad A) -->
        <path d="M 975,445 L 975,340 L 250,340" stroke="var(--accent-blue)" stroke-width="1.5" stroke-dasharray="5 3" marker-end="url(#arrow-blue)" fill="none" class="flow-wire"></path>
        <text x="810" y="334" class="svg-wire-label" fill="var(--accent-blue)" font-size="9.5">Pfad A: Initiales Wissen</text>

        <!-- Langzeitgedächtnis -> Guards (Pfad C) -->
        <path d="M 975,445 L 975,200 L 870,200" stroke="var(--text-dim)" stroke-width="1.5" stroke-dasharray="4 2" marker-end="url(#arrow-default)" fill="none" class="flow-wire"></path>
        <text x="885" y="193" class="svg-wire-label" fill="var(--text-muted)" font-size="9">Pfad C: Reaktiv</text>

        <!-- ── KNOTEN & ELEMENTE ── -->

        <!-- 1. ZENTRALE EXEKUTIVE -->
        <g class="svg-node" data-target="ze" style="cursor:pointer;" onclick="selectInspector('ze')">
          <rect x="350" y="12" width="400" height="44" rx="8" class="node-box node-box-ze"></rect>
          <text x="550" y="32" text-anchor="middle" class="node-title" font-weight="700" font-size="13">👑 ZENTRALE EXEKUTIVE (Aufsicht & Willensbildung)</text>
          <text x="550" y="47" text-anchor="middle" class="node-sub" font-size="9.5">Norman & Shallice (SAS) • Miller TOTE (/plan, /goal) • Notfall-Circuit-Breaker</text>
        </g>

        <!-- 2. SENSOREN & MESSTECHNIK -->
        <g class="svg-node" data-target="sensors" style="cursor:pointer;" onclick="selectInspector('sensors')">
          <rect x="360" y="86" width="380" height="48" rx="8" class="node-box"></rect>
          <text x="550" y="105" text-anchor="middle" class="node-title" font-weight="600" font-size="12">📡 Sensoren & Messtechnik (der Exekutive)</text>
          <text x="550" y="122" text-anchor="middle" class="node-sub" font-size="9.5">Context-Reader Tool • Token- & Health-Monitor • CoT-Loop & Stress-Detektor</text>
        </g>

        <!-- 3A. DETERMINISTISCHE SKRIPT-GUARDS -->
        <g class="svg-node" data-target="guards" style="cursor:pointer;" onclick="selectInspector('guards')">
          <rect x="180" y="175" width="280" height="52" rx="8" class="node-box"></rect>
          <text x="320" y="196" text-anchor="middle" class="node-title" font-weight="600" font-size="11.5">⚙️ Deterministische Skript-Guards</text>
          <text x="320" y="213" text-anchor="middle" class="node-sub" font-size="9">P-001 Push-Sperre • Pfad-Locks • Regex & Limits</text>
        </g>

        <!-- 3B. LEBENDIGE LLM-GUARDS -->
        <g class="svg-node" data-target="guards" style="cursor:pointer;" onclick="selectInspector('guards')">
          <rect x="640" y="175" width="280" height="52" rx="8" class="node-box"></rect>
          <text x="780" y="196" text-anchor="middle" class="node-title" font-weight="600" font-size="11.5">🧠 Lebendige LLM-Guards (Aufsichts-Modell)</text>
          <text x="780" y="213" text-anchor="middle" class="node-sub" font-size="9">Goal-Evaluator (/goal) • Disambiguierung • Anti-Konfabulation</text>
        </g>

        <!-- 4. BERECHTIGUNGSKONTROLLE (DIAMOND) -->
        <g class="svg-node" data-target="auth" style="cursor:pointer;" onclick="selectInspector('auth')">
          <polygon points="550,250 630,280 550,310 470,280" class="node-diamond"></polygon>
          <text x="550" y="278" text-anchor="middle" class="node-title" font-weight="700" font-size="11">Entscheidung</text>
          <text x="550" y="291" text-anchor="middle" class="node-sub" font-size="8.5">Injektion erlaubt?</text>
        </g>

        <!-- 5. HOOKER (REINER INJEKTOR) -->
        <g class="svg-node" data-target="hooker" style="cursor:pointer;" onclick="selectInspector('hooker')">
          <rect x="400" y="345" width="300" height="50" rx="8" class="node-box node-box-hooker"></rect>
          <text x="550" y="366" text-anchor="middle" class="node-title" font-weight="700" font-size="12">💉 HOOKER (Reine Injektoren / Zustell-Kanal)</text>
          <text x="550" y="382" text-anchor="middle" class="node-sub" font-size="9.5">Reines Ausführungsorgan • Keine Kontrolllogik • Sichere Zustellung</text>
        </g>

        <!-- 6. STARTPROMPT-SYNTHESE (LINKS) -->
        <g class="svg-node" data-target="start" style="cursor:pointer;" onclick="selectInspector('start')">
          <rect x="50" y="345" width="280" height="50" rx="8" class="node-box node-box-start"></rect>
          <text x="190" y="365" text-anchor="middle" class="node-title" font-weight="700" font-size="11.5">🚀 Startprompt-Synthese (Boot-Bus)</text>
          <text x="190" y="381" text-anchor="middle" class="node-sub" font-size="9">Agent (Rolle+Skills+Governance) + System + Intent</text>
        </g>

        <!-- 7. DAS ZENTRUM: AKTIVES KONTEXTFENSTER -->
        <g class="svg-node active-node" data-target="ctx" style="cursor:pointer;" onclick="selectInspector('ctx')">
          <rect x="370" y="440" width="360" height="80" rx="14" class="node-box node-box-center"></rect>
          <text x="550" y="468" text-anchor="middle" class="node-title-center" font-weight="800" font-size="15">🗣️ ZENTRUM: AKTIVES KONTEXTFENSTER</text>
          <text x="550" y="488" text-anchor="middle" class="node-sub-center" font-size="10.5">Phonologische Schleife • CoT-Planung • Arbeitsgedächtnis</text>
          <text x="550" y="505" text-anchor="middle" class="node-sub-center" font-size="9" fill="var(--accent)">Einlass nur über Boot-Bus (Start) ODER autorisierte Hooker-Injektion!</text>
        </g>

        <!-- 8. LERN- & KONSOLIDIERUNGSSYSTEM -->
        <g class="svg-node" data-target="learn" style="cursor:pointer;" onclick="selectInspector('learn')">
          <rect x="430" y="565" width="240" height="52" rx="8" class="node-box"></rect>
          <text x="550" y="586" text-anchor="middle" class="node-title" font-weight="700" font-size="11.5">🌙 Kognitives Lernen & Konsolidierung</text>
          <text x="550" y="603" text-anchor="middle" class="node-sub" font-size="9.5">76% Rauschfilter • Lessons Learned • Best Practices</text>
        </g>

        <!-- 9. LANGZEITGEDÄCHTNIS (RECHTS UNTEN) -->
        <g class="svg-node" data-target="ltm" style="cursor:pointer;" onclick="selectInspector('ltm')">
          <rect x="890" y="445" width="170" height="172" rx="10" class="node-box node-box-db"></rect>
          <text x="975" y="475" text-anchor="middle" class="node-title" font-weight="700" font-size="12">💾 Langzeitgedächtnis</text>
          <text x="975" y="492" text-anchor="middle" class="node-sub" font-size="9.5" font-family="monospace">bach.db</text>
          <line x1="910" y1="504" x2="1040" y2="504" stroke="var(--border)"></line>
          <text x="920" y="525" class="node-sub" font-size="9">• 3 Zugriffspfade</text>
          <text x="920" y="545" class="node-sub" font-size="9">• memory_facts</text>
          <text x="920" y="565" class="node-sub" font-size="9">• memory_lessons</text>
          <text x="920" y="585" class="node-sub" font-size="9">• memory_sessions</text>
          <text x="920" y="605" class="node-sub" font-size="9">• memory_working</text>
        </g>
      </svg>
    </div>

    <!-- ANSICHT 2: MERMAID LIVE-DIAGRAMM -->
    <div id="view-mermaid-container" style="display:none;padding:1rem;background:var(--bg-panel);border-radius:var(--radius-md);overflow-x:auto;">
      <div id="mermaid-render-target" style="display:flex;justify-content:center;">
        <span style="color:var(--text-muted);font-size:0.875rem;">Lade Mermaid Prozess-Graph...</span>
      </div>
    </div>

    <!-- ANSICHT 3: MERMAID CODE & EXPORT -->
    <div id="view-code-container" style="display:none;padding:1rem;background:var(--bg-panel);border-radius:var(--radius-md);">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem;">
        <strong style="font-size:0.875rem;color:var(--text);">Mermaid Syntax (Vollständig & Valide):</strong>
        <button class="btn btn-secondary btn-sm" onclick="copyMermaidCode()" type="button" id="btn-copy-mermaid">
          📋 Code kopieren
        </button>
      </div>
      <pre id="mermaid-raw-code" style="background:var(--bg-dark);color:var(--text);padding:1rem;border-radius:var(--radius-sm);font-family:monospace;font-size:0.8rem;overflow-x:auto;border:1px solid var(--border);line-height:1.5;">{mermaidCode}</pre>
    </div>

  </div>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- 2. SYNCHRONISIERTE INSPEKTOR-TABS (TIEFENINSPEKTION & DETAILS) -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <div class="card" style="border:1px solid var(--border);padding:1.5rem;background:var(--bg-card);">

    <!-- Tab Navigation -->
    <div style="display:flex;gap:0.4rem;border-bottom:1px solid var(--border);padding-bottom:0.75rem;margin-bottom:1.5rem;overflow-x:auto;">
      <button class="insp-tab-btn active" id="tab-btn-ctx" onclick="selectInspector('ctx')">🗣️ 1. Kontextfenster</button>
      <button class="insp-tab-btn" id="tab-btn-ze" onclick="selectInspector('ze')">👑 2. Zentrale Exekutive</button>
      <button class="insp-tab-btn" id="tab-btn-sensors" onclick="selectInspector('sensors')">📡 3. Sensoren & Messtechnik</button>
      <button class="insp-tab-btn" id="tab-btn-guards" onclick="selectInspector('guards')">🛡️ 4. Selbstkontroll-Guards</button>
      <button class="insp-tab-btn" id="tab-btn-auth" onclick="selectInspector('auth')">⚖️ 5. Berechtigung & Hooker</button>
      <button class="insp-tab-btn" id="tab-btn-start" onclick="selectInspector('start')">🚀 6. Startprompt</button>
      <button class="insp-tab-btn" id="tab-btn-learn" onclick="selectInspector('learn')">🌙 7. Lernen</button>
      <button class="insp-tab-btn" id="tab-btn-ltm" onclick="selectInspector('ltm')">💾 8. Langzeitgedächtnis</button>
    </div>

    <!-- PANEL 1: ZENTRUM - AKTIVES KONTEXTFENSTER -->
    <div class="insp-panel" id="panel-ctx" style="display:block;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;flex-wrap:wrap;gap:0.5rem;">
        <div>
          <h3 style="margin:0;font-size:1.2rem;color:var(--text);">🗣️ Das Aktive Kontextfenster (Phonologische Schleife)</h3>
          <span style="font-size:0.8rem;color:var(--text-muted);">
            Das Herzstück des Modells: Arbeitsgedächtnismodell (Baddeley) • CoT-Planung & Innerer Monolog
          </span>
        </div>
        <span class="badge badge-accent">1.420 / 200.000 Tokens (0.71%)</span>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(320px, 1fr));gap:1rem;margin-bottom:1rem;">
        <div style="background:var(--bg-panel);border:1px solid var(--border);border-radius:var(--radius-md);padding:1rem;">
          <h4 style="margin:0 0 0.5rem 0;font-size:0.95rem;color:var(--text);">Mentale Gesundheit & Puffer</h4>
          <div style="display:flex;flex-direction:column;gap:0.5rem;font-size:0.85rem;">
            <div style="display:flex;justify-content:space-between;">
              <span style="color:var(--text-muted);">Token-Sparmodus:</span>
              <strong style="color:var(--success);">Normalbetrieb (&lt;10% belegt)</strong>
            </div>
