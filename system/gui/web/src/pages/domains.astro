---
// src/pages/domains.astro - Meine Domänen & Fachmodule Dashboard
import BachLayout from "../layouts/BachLayout.astro";
---

<BachLayout title="Meine Domänen" currentPath="/domains">
  <div class="domains-container">
    <div class="page-header">
      <div class="header-content">
        <h1><span class="icon">🌐</span> Meine Domänen & Fachmodule</h1>
        <p class="subtitle">Slot-Architektur für spezialisierte Fachdomänen, PC-Software & Entwickler-Werkzeuge</p>
      </div>
      <div class="header-actions">
        <span class="badge badge-accent">Slot-Architektur v2</span>
        <button class="btn btn-secondary" onclick="loadDomains()">🔄 Aktualisieren</button>
      </div>
    </div>

    <!-- Quick Stats -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-label">Installierte Fachmodule</div>
        <div class="stat-value" id="stat-count-modules">...</div>
        <div class="stat-sub">OneDrive .DOMAINS Slot</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Aktive Domänen</div>
        <div class="stat-value" id="stat-count-active">3</div>
        <div class="stat-sub">ATI, Steuer, Gesundheit</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">ControlCenter Status</div>
        <div class="stat-value">Aktiv</div>
        <div class="stat-sub">Lokale Software erkannt</div>
      </div>
    </div>

    <!-- Fachmodule Grid -->
    <div class="section-title">
      <h2><span class="icon">🧩</span> Installierte Fachmodule</h2>
      <p class="section-desc">Module aus <code>OneDrive\.TOPICS\.AI\.MODULES\.DOMAINS</code></p>
    </div>

    <div class="domains-grid" id="domains-grid">
      <p class="loading-state">Scanne Fachmodule...</p>
    </div>

    <!-- ATI Entwickler Taskboard Section -->
    <div class="section-title" style="margin-top:2rem;">
      <h2><span class="icon">🛠️</span> ATI Entwickler – Einheitliche Taskdatenbank</h2>
      <p class="section-desc">Gefilterte Aufgaben für Code- und Infrastruktur-Entwicklung</p>
    </div>

    <div class="glass-card">
      <div id="ati-tasks-container">
        <p class="loading-state">Lade ATI-Entwicklungsaufgaben...</p>
      </div>
    </div>
  </div>
</BachLayout>

<style>
  .domains-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.25rem;
  }
  .header-content h1 {
    font-size: 1.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.25rem 0;
  }
  .subtitle {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  .stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    text-align: center;
  }
  .stat-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .stat-value {
    font-size: 2rem;
    font-weight: 700;
    margin: 0.25rem 0;
    color: var(--accent);
  }
  .stat-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .section-title h2 {
    font-size: 1.35rem;
    margin: 0 0 0.2rem 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .section-desc {
    font-size: 0.825rem;
    color: var(--text-muted);
    margin: 0;
  }
  .domains-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.25rem;
  }
  .domain-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.2s ease;
  }
  .domain-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .domain-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .domain-icon {
    font-size: 1.75rem;
  }
  .domain-title-wrap h3 {
    margin: 0;
    font-size: 1.05rem;
  }
  .domain-type-badge {
    font-size: 0.7rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .domain-desc {
    font-size: 0.825rem;
    color: var(--text-muted);
    margin: 0 0 1rem 0;
    line-height: 1.4;
  }
  .domain-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255,255,255,0.05);
    padding-top: 0.75rem;
  }
  .glass-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .data-table th, .data-table td {
    padding: 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }
  .data-table th {
    color: var(--text-muted);
    font-weight: 500;
  }
</style>

<script is:inline>
  async function loadDomains() {
    const grid = document.getElementById('domains-grid');
    const statModules = document.getElementById('stat-count-modules');
    if (!grid) return;
    try {
      const res = await fetch('/api/domains/installed');
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      const domains = data.domains || [];
      if (statModules) statModules.textContent = domains.length;

      if (domains.length === 0) {
        grid.innerHTML = '<p class="text-muted">Keine Fachmodule gefunden.</p>';
        return;
      }

      grid.innerHTML = domains.map(d => `
        <div class="domain-card">
          <div>
            <div class="domain-header">
              <span class="domain-icon">${d.icon || '📦'}</span>
              <div class="domain-title-wrap">
                <h3>${d.name}</h3>
                <span class="domain-type-badge">${d.type || 'Fachmodul'}</span>
              </div>
            </div>
            <p class="domain-desc">${d.description || 'Spezifisches Fachmodul.'}</p>
          </div>
          <div class="domain-footer">
            <span class="badge ${d.status === 'active' ? 'badge-success' : 'badge-accent'}">${d.status}</span>
            <div style="display:flex;gap:0.4rem;">
              ${d.id === 'ati' ? '<a href="/ati" class="btn btn-sm btn-secondary">Workbench ↗</a>' : ''}
              ${d.id === 'theodor-steuer' ? '<a href="/steuer" class="btn btn-sm btn-secondary">Steuer ↗</a>' : ''}
              ${d.id === 'gesundheit' ? '<a href="/gesundheit" class="btn btn-sm btn-secondary">Klinik ↗</a>' : ''}
              ${!['ati', 'theodor-steuer', 'gesundheit'].includes(d.id) ? `<button class="btn btn-sm btn-secondary" onclick="alert('Fachmodul ${d.name} bereit am Pfad:\\n${d.folder}')">Info</button>` : ''}
            </div>
          </div>
        </div>
      `).join('');
    } catch (e) {
      grid.innerHTML = `<p class="text-danger">Fehler beim Laden: ${e.message}</p>`;
    }
  }

  async function loadAtiTasks() {
    const container = document.getElementById('ati-tasks-container');
    if (!container) return;
    try {
      const res = await fetch('/api/tasks?category=dev,code,ati&limit=15');
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      const tasks = data.tasks || [];
      if (tasks.length === 0) {
        container.innerHTML = '<p class="text-muted" style="padding:1rem;">Keine offenen Entwicklungsaufgaben verzeichnet.</p>';
        return;
      }
      container.innerHTML = `
        <table class="data-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Task</th>
              <th>Status</th>
              <th>Priorität</th>
              <th>Kategorie</th>
            </tr>
          </thead>
          <tbody>
            ${tasks.map(t => `
              <tr>
                <td>#${t.id}</td>
                <td><strong>${t.title}</strong></td>
                <td><span class="badge ${t.status === 'done' ? 'badge-success' : 'badge-accent'}">${t.status}</span></td>
                <td>${t.priority || 3}</td>
                <td>${t.category || 'dev'}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
    } catch (e) {
      container.innerHTML = `<p class="text-danger">Fehler: ${e.message}</p>`;
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    loadDomains();
    loadAtiTasks();
  });
</script>
