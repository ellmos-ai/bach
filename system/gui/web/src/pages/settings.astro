---
// src/pages/settings.astro - Einstellungen, Setup, Ocean Modulschaltplan & Installer
import BachLayout from "../layouts/BachLayout.astro";
import SystemClusterStatus from "../components/SystemClusterStatus.astro";
---

<BachLayout title="Einstellungen & Setup" currentPath="/settings">
  <div class="settings-container">
    <div class="page-header">
      <div class="header-content">
        <h1><span class="icon">⚙️</span> Einstellungen & System-Setup</h1>
        <p class="subtitle">Systemkonfiguration, Backend-Installer, Ocean Modulschaltplan & Autonomes Lernen</p>
      </div>
      <div class="header-actions">
        <span class="badge">Modulstatus ungeprüft</span>
        <button class="btn btn-secondary" onclick="loadOceanMap()">🔄 Aktualisieren</button>
      </div>
    </div>

    <!-- Tab Bar -->
    <div class="tab-bar">
      <button class="tab-btn active" data-tab="ocean-map">🌊 Ocean Modulschaltplan</button>
      <button class="tab-btn" data-tab="installer">📦 Installer & Erweiterungen</button>
      <button class="tab-btn" data-tab="learning">🧠 NemoFold & Hermes (Lernen)</button>
      <button class="tab-btn" data-tab="core">⚙️ Core & Repo-Klärung</button>
    </div>

    <!-- TAB 1: OCEAN MODULSCHALTPLAN -->
    <div class="tab-pane active" id="pane-ocean-map">
      <div class="glass-card">
        <h3><span class="icon">🌊</span> Ocean Architektur- & Modulschaltplan</h3>
        <p class="card-desc">Visuelle Topologie der Kernsysteme aus <code>ellmos-ai</code> (Trithon, Muschelgrund, Salt & Subsysteme)</p>

        <div class="ocean-components-grid" id="ocean-components-grid">
          <p class="loading-state">Lade Ocean Modulschaltplan...</p>
        </div>
      </div>
    </div>

    <!-- TAB 2: INSTALLER & ERWEITERUNGEN -->
    <div class="tab-pane" id="pane-installer">
      <div class="card-grid">
        <div class="glass-card">
          <h3><span class="icon">📦</span> Backend-Installer</h3>
          <p class="card-desc">In Arbeit: Paketquelle, Berechtigungsprüfung, Signatur, Installationsprotokoll und Rollback sind noch nicht angebunden.</p>
          <div class="installer-box">
            <label>Paket oder Modulname zur Nachinstallation</label>
            <div style="display:flex;gap:0.5rem;margin-top:0.4rem;">
              <input type="text" id="install-package-input" placeholder="Paketquelle noch nicht angebunden" disabled style="flex:1;padding:0.5rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text);" />
              <button class="btn btn-primary" disabled title="Installation erst nach überprüftem Backend-Vertrag möglich">Installieren</button>
            </div>
            <div id="install-log" style="margin-top:1rem;background:rgba(0,0,0,0.3);padding:0.75rem;border-radius:var(--radius-sm);font-family:monospace;font-size:0.8rem;display:none;"></div>
          </div>
        </div>

        <div class="glass-card">
          <h3><span class="icon">🔌</span> Verfügbare Erweiterungen</h3>
          <ul class="extension-list">
            <li>
              <div><strong>ellmos-voice-io</strong><p>Sprachein- und -ausgabe via Whisper & TTS</p></div>
              <span class="badge">Nicht geprüft</span>
            </li>
            <li>
              <div><strong>ellmos-blender-use-mcp</strong><p>3D-Visualisierung & automatische Geometrie-Generierung</p></div>
              <span class="badge">Nicht geprüft</span>
            </li>
            <li>
              <div><strong>media-editor-core</strong><p>High-Speed Renderengine für Windows & Mac Studio</p></div>
              <span class="badge">Nicht geprüft</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- TAB 3: NEMOFOLD & HERMES (LERNEN) -->
    <div class="tab-pane" id="pane-learning">
      <div class="card-grid">
        <div class="glass-card">
          <div class="learning-header">
            <span class="learning-icon">🧬</span>
            <div>
              <h3>NemoFold: Workflow-Lernen & Step-Ketten</h3>
              <p class="card-desc">Geplant: wiederkehrende Abläufe analysieren und geprüfte Step-Ketten vorschlagen. Es fehlen Beobachtungsquelle, Validierung und Freigabe.</p>
            </div>
          </div>
          <div class="learning-content">
            <div class="pipeline-step">
              <span class="step-num">1</span>
              <div>
                <strong>Ablaufbeobachtung & Heuristik-Detektor</strong>
                <p>Vorgesehen: Werkzeugfolgen über mehrere Sitzungen beobachten.</p>
              </div>
            </div>
            <div class="pipeline-step">
              <span class="step-num">2</span>
              <div>
                <strong>Ketten-Synthese & Skill-Generierung</strong>
                <p>Vorgesehen: wiederkehrende Muster zu überprüfbaren Step-Ketten bündeln.</p>
              </div>
            </div>
            <div class="pipeline-step">
              <span class="step-num">3</span>
              <div>
                <strong>Validierung & Rollback-Schutz</strong>
                <p>Offen: Workflow-TÜV und Freigabe vor einer Aufnahme in ein Register anbinden.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="glass-card">
          <div class="learning-header">
            <span class="learning-icon">📜</span>
            <div>
              <h3>Hermes: Skill-Lernen aus Chat-Sessions</h3>
              <p class="card-desc">Geplant: Wissen aus freigegebenen Dialogen gewinnen. Es fehlen Quellenfreigabe, Extraktion, Prüfung und Speichervertrag.</p>
            </div>
          </div>
          <div class="learning-content">
            <div class="pipeline-step">
              <span class="step-num">1</span>
              <div>
                <strong>Dialog-Mining & Transkript-Analyse</strong>
                <p>Vorgesehen: freigegebene Dialoge auf gelöste Probleme und Korrekturen prüfen.</p>
              </div>
            </div>
            <div class="pipeline-step">
              <span class="step-num">2</span>
              <div>
                <strong>Automatische Lessons Learned & Best Practices</strong>
                <p>Offen: Lösungswege validieren und an den autoritativen Lessons-Speicher anbinden.</p>
              </div>
            </div>
            <div class="pipeline-step">
              <span class="step-num">3</span>
              <div>
                <strong>Prozedurales Gedächtnis</strong>
                <p>Vorgesehen: nach Freigabe wiederverwendbare Skills vorschlagen.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 4: CORE & REPO-KLÄRUNG -->
    <div class="tab-pane" id="pane-core">
      <div class="card-grid">
        <SystemClusterStatus />

        <div class="glass-card">
          <h3><span class="icon">🏛️</span> Repo- & Architektur-Klassifizierung</h3>
          <p class="card-desc">Klare Trennung der Komponenten und Verantwortlichkeiten:</p>
          <div class="repo-box">
            <div class="repo-item">
              <span class="badge badge-accent">BACH/Ocean GUI</span>
              <strong>Gemeinsame Astro-Oberfläche (dieses Dashboard)</strong>
              <p>Eine GUI-Quelle; BACH und Ocean benötigen jeweils eigene geprüfte Backend-Adapter.</p>
            </div>
            <div class="repo-item">
              <span class="badge badge-secondary">Universal GUI</span>
              <strong>Eigenständige FastAPI-/Jinja-Konsole</strong>
              <p>Separater Operator-Zugang mit eigenem Modul; technischer Paketname derzeit <code>ellmos-unified-gui</code>.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BachLayout>

<style>
  .settings-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.25rem;
  }
  .header-content h1 {
    font-size: 1.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.25rem 0;
  }
  .subtitle {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0;
  }
  .tab-bar {
    display: flex;
    gap: 0.5rem;
  }
  .tab-btn {
    padding: 0.5rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .tab-btn:hover {
    background: var(--bg-hover);
    color: var(--text);
  }
  .tab-btn.active {
    background: var(--accent);
    color: #0b0d14;
    font-weight: 600;
    border-color: var(--accent);
  }
  .tab-pane {
    display: none;
    flex-direction: column;
    gap: 1.25rem;
  }
  .tab-pane.active {
    display: flex;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
    gap: 1.25rem;
  }
  .glass-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }
  .glass-card h3 {
    margin: 0 0 0.25rem 0;
    font-size: 1.15rem;
  }
  .card-desc {
    font-size: 0.825rem;
    color: var(--text-muted);
    margin: 0 0 1.25rem 0;
  }
  .ocean-components-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }
  .ocean-card {
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
  }
  .ocean-card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .ocean-card-icon {
    font-size: 1.5rem;
  }
  .ocean-card-title {
    font-weight: 600;
    font-size: 1rem;
  }
  .ocean-card-role {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0 0 0.75rem 0;
    line-height: 1.35;
  }
  .extension-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .extension-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-sm);
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--border);
  }
  .extension-list strong {
    font-size: 0.875rem;
  }
  .extension-list p {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: 0;
  }
  .learning-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .learning-icon {
    font-size: 2rem;
  }
  .pipeline-step {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    padding: 0.6rem;
    border-radius: var(--radius-sm);
    background: rgba(255,255,255,0.015);
  }
  .step-num {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--accent);
    color: #0b0d14;
    font-weight: 700;
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .pipeline-step strong {
    font-size: 0.875rem;
  }
  .pipeline-step p {
    font-size: 0.775rem;
    color: var(--text-muted);
    margin: 0.15rem 0 0 0;
  }
  .repo-box {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .repo-item {
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    background: rgba(255,255,255,0.02);
    border-left: 3px solid var(--accent);
  }
  .repo-item strong {
    display: block;
    margin: 0.35rem 0 0.15rem 0;
    font-size: 0.9rem;
  }
  .repo-item p {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .data-table th, .data-table td {
    padding: 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }
  .data-table th {
    color: var(--text-muted);
    font-weight: 500;
  }
</style>

<script is:inline>
  function setupTabs() {
    const tabButtons = document.querySelectorAll('.tab-btn');
    const tabPanes = document.querySelectorAll('.tab-pane');
    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab');
        tabButtons.forEach(b => b.classList.remove('active'));
        tabPanes.forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        const target = document.getElementById('pane-' + tab);
        if (target) target.classList.add('active');
      });
    });
  }

  async function loadOceanMap() {
    const grid = document.getElementById('ocean-components-grid');
    if (!grid) return;
    try {
      const res = await fetch('/api/setup/ocean-map');
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      const components = Array.isArray(data.core_components) ? data.core_components : [];
      grid.replaceChildren();
      for (const component of components) {
        const card = document.createElement('div');
        card.className = 'ocean-card';
        const header = document.createElement('div');
        header.className = 'ocean-card-header';
        const icon = document.createElement('span');
        icon.className = 'ocean-card-icon';
        icon.textContent = String(component.icon || '🌊');
        const title = document.createElement('div');
        title.className = 'ocean-card-title';
        title.textContent = String(component.name || 'Unbenanntes Modul');
        header.append(icon, title);
        const role = document.createElement('p');
        role.className = 'ocean-card-role';
        role.textContent = String(component.role || 'Rolle nicht beschrieben');
        const footer = document.createElement('div');
        footer.style.cssText = 'display:flex;justify-content:space-between;align-items:center';
        const status = document.createElement('span');
        status.className = 'badge';
        status.textContent = 'Laufstatus nicht geprüft';
        const type = document.createElement('span');
        type.style.cssText = 'font-size:0.75rem;color:var(--text-muted)';
        type.textContent = String(component.type || 'Modul');
        footer.append(status, type);
        card.append(header, role, footer);
        grid.append(card);
      }
      if (!components.length) grid.textContent = 'Keine Modulkonfiguration verfügbar.';
    } catch (e) {
      grid.textContent = 'Modulschaltplan nicht verfügbar; Backend-Anbindung prüfen.';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    setupTabs();
    loadOceanMap();
  });
</script>
