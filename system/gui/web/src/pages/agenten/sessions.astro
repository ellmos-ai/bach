---
// src/pages/agenten/sessions.astro - Sitzungsübersicht & Gedächtnisintegration (GUX-042)
import BachLayout from "../../layouts/BachLayout.astro";
---

<BachLayout title="Sessions & Protokolle" currentPath="/agenten/sessions">
  <div class="sessions-container">
    <div class="page-header">
      <div class="header-content">
        <h1><span class="icon">📜</span> Sessions, Protokolle & Gedächtnis</h1>
        <p class="subtitle">Quellengetreue Einsicht in vergangene Dialog-Sessions, Lessons Learned und Arbeitsgedächtnis (GUX-042)</p>
      </div>
      <div class="header-actions">
        <button class="btn btn-secondary" onclick="refreshCurrentTab()">🔄 Aktualisieren</button>
      </div>
    </div>

    <!-- Tab Bar -->
    <div class="tab-bar">
      <button class="tab-btn active" data-tab="sessions">📜 Sitzungsübersicht</button>
      <button class="tab-btn" data-tab="lessons">💡 Lessons Learned & Best Practices</button>
      <button class="tab-btn" data-tab="working">🧠 Aktives Arbeitsgedächtnis</button>
      <button class="tab-btn" data-tab="topology">📊 Kognitiver Schaltplan & Topologie</button>
      <button class="tab-btn" data-tab="agent-history">📜 Agenten-Verlauf</button>
    </div>

    <!-- TAB 1: SESSIONS -->
    <div class="tab-pane active" id="pane-sessions">
      <div class="glass-card">
        <h3>Historische Dialog- und Agenten-Sitzungen</h3>
        <p class="card-desc">Zeitpunkte und Zusammenfassungen aus <code>memory_sessions</code>; echte erfasste Dialoge ohne Konfabulation.</p>
        <div id="sessions-list">
          <p class="loading-state">Lade Sitzungen...</p>
        </div>
      </div>
    </div>

    <!-- TAB 2: LESSONS LEARNED -->
    <div class="tab-pane" id="pane-lessons">
      <div class="glass-card">
        <h3>Lessons Learned & Best Practices</h3>
        <p class="card-desc">Destilliertes Wissen aus NemoFold/Hermes und vergangenen Läufen (USMC/BACH safe reader).</p>
        <div id="lessons-list">
          <p class="loading-state">Lade Lessons...</p>
        </div>
      </div>
    </div>

    <!-- TAB 3: WORKING MEMORY -->
    <div class="tab-pane" id="pane-working">
      <div class="glass-card">
        <h3>Aktives Arbeitsgedächtnis (Baddeley Working Memory)</h3>
        <p class="card-desc">Flüchtige Notizen, Scratchpads und CoT-Zwischenspeicher aus <code>memory_working</code>.</p>
        <div id="working-list">
          <p class="loading-state">Lade Arbeitsgedächtnis...</p>
        </div>
      </div>
    </div>

    <!-- TAB 4: AGENT HISTORY -->
    <div class="tab-pane" id="pane-agent-history">
      <div class="glass-card">
        <h3>Agenten-Verlauf (Snapshots)</h3>
        <p class="card-desc">Gespeicherte Agenten-Läufe (Snapshots) mit Nachrichten, Werkzeugergebnissen und Kontext. Resume nur im Running-Modal.</p>
        <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;margin-bottom:0.75rem;">
          <select id="agent-history-archive-filter" onchange="loadAgentHistoryTab()">
            <option value="current">Aktuelle Läufe</option>
            <option value="archived">Archivierte Läufe</option>
            <option value="all">Alle</option>
          </select>
          <button class="btn btn-sm" type="button" onclick="loadAgentHistoryTab()">🔄 Neu laden</button>
        </div>
        <div id="agent-history-list-pane"><p class="loading-state">Läufe werden beim Öffnen des Tabs geladen…</p></div>
        <div id="agent-history-detail-pane"></div>
      </div>
    </div>

    <!-- TAB 4: TOPOLOGY -->
    <div class="tab-pane" id="pane-topology">
      <div class="glass-card">
        <h3>Kognitive Prozess-Topologie (8 Prozessblöcke)</h3>
        <p class="card-desc">Live-Telemetrie der 8 kognitiven Prozessblöcke gemäß GUX-032 bis GUX-041.</p>
        <div id="topology-grid" class="reports-grid">
          <p class="loading-state">Lade Topologie...</p>
        </div>
      </div>
    </div>
  </div>
</BachLayout>

<style>
  .sessions-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.25rem;
  }
  .header-content h1 {
    font-size: 1.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.25rem 0;
  }
  .subtitle {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0;
  }
  .tab-bar {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .tab-btn {
    padding: 0.5rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .tab-btn:hover {
    background: var(--bg-hover);
    color: var(--text);
  }
  .tab-btn.active {
    background: var(--accent);
    color: #0b0d14;
    font-weight: 600;
    border-color: var(--accent);
  }
  .tab-pane {
    display: none;
    flex-direction: column;
    gap: 1.25rem;
  }
  .tab-pane.active {
    display: flex;
  }
  .glass-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }
  .glass-card h3 {
    margin: 0 0 0.25rem 0;
    font-size: 1.15rem;
  }
  .card-desc {
    font-size: 0.825rem;
    color: var(--text-muted);
    margin: 0 0 1.25rem 0;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .data-table th, .data-table td {
    padding: 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }
  .data-table th {
    color: var(--text-muted);
    font-weight: 500;
  }
  .reports-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .report-card {
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .report-badge {
    font-size: 0.7rem;
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .report-card h4 {
    margin: 0.5rem 0;
    font-size: 1rem;
  }
  .report-card p {
    font-size: 0.825rem;
    color: var(--text-muted);
    margin: 0 0 1rem 0;
    line-height: 1.4;
  }
  .badge {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    background: var(--bg-panel, rgba(255,255,255,0.04));
    border: 1px solid var(--border);
  }
  .badge-accent {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>

<script is:inline>
  let activeTab = 'sessions';

  function escapeSessionText(value) {
    return String(value ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function setupTabs() {
    const tabButtons = document.querySelectorAll('.tab-btn');
    const tabPanes = document.querySelectorAll('.tab-pane');
    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab');
        activeTab = tab;
        tabButtons.forEach(b => b.classList.remove('active'));
        tabPanes.forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        const target = document.getElementById('pane-' + tab);
        if (target) target.classList.add('active');
        loadTabContent(tab);
      });
    });
  }

  function refreshCurrentTab() {
    loadTabContent(activeTab);
  }

  function loadTabContent(tab) {
    if (tab === 'sessions') loadSessions();
    else if (tab === 'lessons') loadLessons();
    else if (tab === 'working') loadWorking();
    else if (tab === 'topology') loadTopology();
    else if (tab === 'agent-history') loadAgentHistoryTab();
  }

  async function loadSessions() {
    const container = document.getElementById('sessions-list');
    if (!container) return;
    try {
      const res = await fetch('/api/memory/sessions?limit=25');
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      const sessions = data.sessions || [];
      if (sessions.length === 0) {
        container.innerHTML = '<p class="text-muted">Keine vergangenen Sitzungen gefunden.</p>';
        return;
      }
      container.innerHTML = `
        <table class="data-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Session ID</th>
              <th>Startzeit</th>
              <th>Endzeit</th>
              <th>Zusammenfassung</th>
            </tr>
          </thead>
          <tbody>
            ${sessions.map(s => `
              <tr>
                <td>#${escapeSessionText(s.id)}</td>
                <td><code>${escapeSessionText(s.session_id ? s.session_id.substring(0, 16) + '...' : '-')}</code></td>
                <td>${escapeSessionText(s.started_at || '-')}</td>
                <td>${escapeSessionText(s.ended_at || '-')}</td>
                <td><strong>${escapeSessionText(s.summary || 'Keine Zusammenfassung')}</strong></td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
    } catch (e) {
      container.textContent = 'Sitzungen konnten nicht geladen werden.';
    }
  }

  async function loadLessons() {
    const container = document.getElementById('lessons-list');
    if (!container) return;
    try {
      const res = await fetch('/api/memory/usmc-lessons-safe?limit=50');
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      const lessons = data.lessons || [];
      if (lessons.length === 0) {
        container.innerHTML = '<p class="text-muted">Keine Lessons Learned gefunden.</p>';
        return;
      }
      container.innerHTML = `
        <table class="data-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Kategorie</th>
              <th>Titel</th>
              <th>Lösung / Best Practice</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            ${lessons.map(l => `
              <tr>
                <td>#${escapeSessionText(l.id)}</td>
                <td><span class="badge">${escapeSessionText(l.category || 'general')}</span></td>
                <td><strong>${escapeSessionText(l.title)}</strong></td>
                <td>${escapeSessionText(l.solution)}</td>
                <td><span class="badge ${l.is_active ? 'badge-accent' : ''}">${l.is_active ? 'Aktiv' : 'Inaktiv'}</span></td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
    } catch (e) {
      container.textContent = 'Lessons Learned konnten nicht geladen werden.';
    }
  }

  async function loadWorking() {
    const container = document.getElementById('working-list');
    if (!container) return;
    try {
      const res = await fetch('/api/memory/working');
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      const items = data.working || [];
      if (items.length === 0) {
        container.innerHTML = '<p class="text-muted">Keine aktiven Arbeitsgedächtnis-Einträge vorhanden.</p>';
        return;
      }
      container.innerHTML = `
        <table class="data-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Typ</th>
              <th>Inhalt</th>
              <th>Erstellt am</th>
            </tr>
          </thead>
          <tbody>
            ${items.map(w => `
              <tr>
                <td>#${escapeSessionText(w.id)}</td>
                <td><span class="badge badge-accent">${escapeSessionText(w.type || 'scratchpad')}</span></td>
                <td>${escapeSessionText(w.content)}</td>
                <td><small>${escapeSessionText(w.created_at || '-')}</small></td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
    } catch (e) {
      container.textContent = 'Arbeitsgedächtnis konnte nicht geladen werden.';
    }
  }

  async function loadTopology() {
    const container = document.getElementById('topology-grid');
    if (!container) return;
    try {
      const res = await fetch('/api/cognitive/topology');
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      const blocks = data.blocks || {};
      const keys = Object.keys(blocks);
      if (keys.length === 0) {
        container.innerHTML = '<p class="text-muted">Keine Topologie-Daten verfügbar.</p>';
        return;
      }
      container.innerHTML = keys.map(k => {
        const b = blocks[k];
        return `
          <div class="report-card">
            <div>
              <span class="report-badge">${escapeSessionText(b.status).toUpperCase()}</span>
              <h4>${escapeSessionText(b.title)}</h4>
              <p style="font-size:0.75rem;color:var(--text-muted);">${escapeSessionText(b.sub)}</p>
              <p>${escapeSessionText(b.role)}</p>
            </div>
            <div style="font-size:0.75rem;color:var(--text-muted);border-top:1px solid var(--border);padding-top:0.5rem;">
              Quelle: <code>${escapeSessionText(b.data_source)}</code>
            </div>
          </div>
        `;
      }).join('');
    } catch (e) {
      container.textContent = 'Topologie konnte nicht geladen werden.';
    }
  }

  let agentHistoryPaneSnapshots = [];

  function loadAgentHistoryTab() {
    const filterSelect = document.getElementById('agent-history-archive-filter');
    const archive = filterSelect ? (filterSelect.value || 'current') : 'current';
    const listEl = document.getElementById('agent-history-list-pane');
    const detailEl = document.getElementById('agent-history-detail-pane');
    agentHistoryPaneSnapshots = [];
    if (detailEl) detailEl.innerHTML = '';
    if (listEl) listEl.innerHTML = '<p class="loading-state">Lade gespeicherte Läufe …</p>';
    fetch('/api/agent-history/sessions?limit=50&archive=' + encodeURIComponent(archive))
      .then((res) => { if (!res.ok) throw new Error('HTTP ' + res.status); return res.json(); })
      .then((data) => {
        const items = (data.page && data.page.items) || data.sessions || data.items || [];
        agentHistoryPaneSnapshots = Array.isArray(items) ? items : [];
        if (!listEl) return;
        if (!agentHistoryPaneSnapshots.length) {
          listEl.innerHTML = '<p class="text-muted">Keine gespeicherten Läufe gefunden.</p>';
          return;
        }
        listEl.innerHTML = agentHistoryPaneSnapshots.map((item, index) => {
          const record = item || {};
          const title = record.name || record.agent_id || record.snapshot_id || 'Lauf';
          const archivedBadge = (record.session_id && String(record.session_id).includes(':archived:'))
            ? ' <span class="badge badge-accent" style="color:#f59e0b;border-color:#f59e0b;">Archiviert</span>'
            : '';
          const metaParts = [];
          if (record.created_at) metaParts.push(escapeSessionText(record.created_at));
          if (record.stored_message_count !== undefined && record.stored_message_count !== null) metaParts.push(escapeSessionText(record.stored_message_count) + ' Nachrichten');
          return '<div style="display:flex;justify-content:space-between;gap:0.75rem;padding:0.55rem 0;border-bottom:1px solid var(--border);align-items:flex-start;flex-wrap:wrap;">' +
            '<div style="min-width:0;overflow-wrap:anywhere;"><strong>' + escapeSessionText(title) + '</strong>' + archivedBadge +
            (metaParts.length ? '<div style="font-size:0.75rem;color:var(--text-muted);">' + metaParts.join(' · ') + '</div>' : '') +
            '</div><button class="btn btn-sm" type="button" onclick="openAgentHistoryDetailPane(' + index + ')">Öffnen</button></div>';
        }).join('');
      })
      .catch(() => { if (listEl) listEl.innerHTML = '<p style="color:#f87171;">Verlauf konnte nicht geladen werden (Netzwerkfehler).</p>'; });
  }

  function openAgentHistoryDetailPane(index) {
    const item = agentHistoryPaneSnapshots[index];
    const detailEl = document.getElementById('agent-history-detail-pane');
    if (!item || !detailEl) return;
    const snapshotId = String(item.snapshot_id || '');
    if (!snapshotId) return;
    detailEl.innerHTML = '<p class="loading-state">Lade Verlauf …</p>';
    fetch('/api/agent-history/sessions/' + encodeURIComponent(snapshotId) + '?include_tools=1')
      .then((res) => { if (!res.ok) throw new Error('HTTP ' + res.status); return res.json(); })
      .then((session) => { renderAgentHistoryDetailPane(session || {}); })
      .catch(() => { detailEl.innerHTML = '<p style="color:#f87171;">Verlauf konnte nicht geladen werden.</p>'; });
  }

  function agentHistoryPanePreHtml(text) {
    return '<pre style="margin:0.35rem 0 0;padding:0.6rem;background:var(--bg-panel, rgba(255,255,255,0.04));border:1px solid var(--border);border-radius:6px;font-size:0.75rem;line-height:1.45;white-space:pre-wrap;overflow-wrap:anywhere;max-height:320px;overflow-y:auto;">' + escapeSessionText(text) + '</pre>';
  }

  function agentHistoryPaneToolPayloadHtml(content) {
    let text;
    if (typeof content === 'string') {
      try { text = JSON.stringify(JSON.parse(content), null, 2); }
      catch (_error) { text = content; }
    } else {
      try { text = JSON.stringify(content, null, 2); }
      catch (_error) { text = String(content); }
    }
    return agentHistoryPanePreHtml(text);
  }

  function renderAgentHistoryDetailPane(session) {
    const detailEl = document.getElementById('agent-history-detail-pane');
    if (!detailEl) return;
    const messages = Array.isArray(session.messages) ? session.messages : [];
    const metaBits = [];
    if (session.created_at) metaBits.push('Erstellt: ' + escapeSessionText(session.created_at));
    if (session.updated_at) metaBits.push('Aktualisiert: ' + escapeSessionText(session.updated_at));
    if (session.agent_id) metaBits.push('Agent: ' + escapeSessionText(session.agent_id));
    metaBits.push(escapeSessionText(messages.length) + ' Nachrichten');
    let html = '<div style="padding:0.6rem 0.75rem;border:1px solid var(--border);border-radius:8px;margin:0.75rem 0;background:var(--bg-panel, rgba(255,255,255,0.04));overflow-wrap:anywhere;">';
    html += '<strong>' + escapeSessionText(session.name || session.agent_id || 'Lauf') + '</strong> <code style="font-size:0.75rem;">' + escapeSessionText(session.snapshot_id || '') + '</code>';
    html += '<div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.25rem;">' + metaBits.join(' · ') + '</div>';
    html += '</div>';
    messages.forEach((msg) => {
      const record = msg || {};
      const role = String(record.role || 'unbekannt');
      let roleBadgeStyle = 'background:rgba(59,130,246,0.15);color:#60a5fa;';
      if (role === 'assistant') roleBadgeStyle = 'background:rgba(139,92,246,0.15);color:#a78bfa;';
      else if (role === 'user') roleBadgeStyle = 'background:rgba(16,185,129,0.15);color:#34d399;';
      else if (role === 'system') roleBadgeStyle = 'background:rgba(100,116,139,0.2);color:#94a3b8;';
      html += '<div style="padding:0.55rem 0;border-bottom:1px solid var(--border);">';
      html += '<div style="font-size:0.75rem;"><span style="padding:0.1rem 0.45rem;border-radius:999px;font-weight:600;' + roleBadgeStyle + '">' + escapeSessionText(role) + '</span>';
      if (role === 'assistant') {
        const status = String(record.answer_status || '');
        if (status) html += ' <span style="padding:0.1rem 0.45rem;border-radius:999px;font-size:0.7rem;background:' + (status === 'success' ? 'rgba(5,150,105,0.15)' : 'rgba(220,38,38,0.15)') + ';color:' + (status === 'success' ? '#059669' : '#dc2626') + ';">' + escapeSessionText(status) + '</span>';
        if (Array.isArray(record.completed_task_ids) && record.completed_task_ids.length) {
          html += ' <span style="font-size:0.7rem;color:var(--text-muted);">Tasks: ' + record.completed_task_ids.map((id) => escapeSessionText(id)).join(', ') + '</span>';
        }
      }
      html += '</div>';
      if (record.tool_result === true) {
        html += '<div style="margin-top:0.35rem;border-left:3px solid #f59e0b;padding-left:0.6rem;">';
        html += '<div style="font-size:0.8rem;font-weight:600;">🛠 Werkzeug: ' + escapeSessionText(String(record.tool_name || '').substring(0, 200)) + '</div>';
        html += agentHistoryPaneToolPayloadHtml(record.content);
        html += '</div>';
      } else if (typeof record.content === 'string') {
        html += '<div style="margin-top:0.35rem;white-space:pre-wrap;overflow-wrap:anywhere;">' + escapeSessionText(record.content) + '</div>';
      } else if (record.content !== undefined && record.content !== null) {
        html += agentHistoryPaneToolPayloadHtml(record.content);
      }
      html += '</div>';
    });
    if (session.context !== undefined && session.context !== null) {
      let contextText;
      if (typeof session.context === 'string') contextText = session.context;
      else { try { contextText = JSON.stringify(session.context, null, 2); } catch (_error) { contextText = String(session.context); } }
      html += '<details style="margin-top:0.75rem;"><summary style="cursor:pointer;color:var(--text-muted);">Kontext</summary>' + agentHistoryPanePreHtml(contextText) + '</details>';
    }
    detailEl.innerHTML = html;
  }

  document.addEventListener('DOMContentLoaded', () => {
    setupTabs();
    loadSessions();
  });
</script>
