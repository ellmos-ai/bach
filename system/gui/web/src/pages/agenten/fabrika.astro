  <!-- PANE 3: AGENTEN-STAFFEL (MARBLERUN) -->
  <div class="fab-pane" id="pane-staffel" style="display:none;flex-direction:column;gap:1.5rem;">
    <div class="card">
      <div class="card-header">
        <div>
          <h2 class="card-title">⛓️ Agenten-Staffel (MarbleRun) & Übergabe-Pipelines</h2>
          <p style="font-size:0.825rem;color:var(--text-muted);margin:0.25rem 0 0 0;">
            Sequenzielle Kette: Output von Agent A wird geprüft und dient als getypte Eingabe für Agent B
          </p>
