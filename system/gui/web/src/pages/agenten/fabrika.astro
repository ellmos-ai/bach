      <div class="staffel-flow" style="display:flex;align-items:center;gap:1rem;overflow-x:auto;padding:1.5rem 0;">
        <div class="staffel-step" style="background:var(--bg-dark);border:1px solid var(--border);border-radius:var(--radius-sm);padding:1rem;min-width:200px;">
          <span class="badge badge-accent">Station 1</span>
          <h4 style="margin:0.5rem 0 0.25rem 0;">Research & Extraktion</h4>
