        <div class="staffel-step" style="background:var(--bg-dark);border:1px solid var(--border);border-radius:var(--radius-sm);padding:1rem;min-width:200px;">
          <span class="badge badge-accent">Station 2</span>
          <h4 style="margin:0.5rem 0 0.25rem 0;">Struktur & Code</h4>
          <p style="font-size:0.75rem;color:var(--text-muted);margin:0;">Agent: Ati Architekt</p>
        </div>
        <span style="font-size:1.5rem;color:var(--accent);">➔</span>
        <div class="staffel-step" style="background:var(--bg-dark);border:1px solid var(--border);border-radius:var(--radius-sm);padding:1rem;min-width:200px;">
          <span class="badge badge-accent">Station 3</span>
          <h4 style="margin:0.5rem 0 0.25rem 0;">Audit & P-001 Check</h4>
