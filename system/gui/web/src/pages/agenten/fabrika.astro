---
import BachLayout from "../../layouts/BachLayout.astro";
---
<BachLayout title="Blueprint-Editor" currentPath="/agenten/blueprints">
  <h1>Der Editor ist jetzt bei den Blueprints</h1>
  <p>Rolle, Skills, Arbeitsvertrag und Modell werden dort gemeinsam bearbeitet.</p>
  <a class="btn btn-primary" href="/agenten/blueprints?new=1">Blueprint-Editor öffnen</a>
</BachLayout>
<script is:inline>
  const target = new URL("/agenten/blueprints", location.origin);
  const old = new URLSearchParams(location.search);
  const name = old.get("load") || old.get("blueprint");
  if (name) target.searchParams.set("blueprint", name);
  else if (old.get("tab") === "teams" || old.get("tab") === "teambuilding") target.searchParams.set("tab", "teams");
  else target.searchParams.set("new", "1");
  location.replace(target.pathname + target.search);
</script>
