  <!-- Modal: Beseelung an Animus -->
  <div id="modal-beseelen" class="hidden" style="position:fixed;inset:0;background:rgba(0,0,0,0.7);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;z-index:1000;">
    <div style="background:var(--bg-panel);border:1px solid var(--border);border-radius:var(--radius-md);width:100%;max-width:550px;padding:2rem;box-shadow:0 20px 50px rgba(0,0,0,0.5);">
      <h2 style="font-size:1.25rem;font-weight:700;margin-bottom:0.5rem;color:var(--text);">Schablone vormerken</h2>
      <p style="font-size:0.8rem;color:var(--text-muted);margin-bottom:1.25rem;">
        Die Schablone erscheint danach als konfiguriert in Living & Running. Ein Agentenprozess wird dadurch nicht gestartet.
      </p>

      <div style="display:flex;flex-direction:column;gap:1rem;">
        <p style="font-size:0.8rem;color:var(--text-muted);">Diese Auswahl wird als Konfiguration gespeichert. Ein Agentenprozess wertet sie derzeit noch nicht aus.</p>
        <div>
          <label style="display:block;font-size:0.8rem;color:var(--text-muted);margin-bottom:0.25rem;">Animus-Typ</label>
          <select id="animus-type" style="width:100%;padding:0.6rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text);font-size:0.9rem;">
            <option value="api">API (z. B. Anthropic Claude, OpenAI, Google)</option>
            <option value="mcp">MCP Worker (Lokales oder Cluster Tool)</option>
            <option value="cli">CLI Worker (z. B. claude-code CLI, agy CLI)</option>
            <option value="subscription">Subscription / Avatar Agent (Selbstwartend)</option>
          </select>
        </div>
        <div>
          <label style="display:block;font-size:0.8rem;color:var(--text-muted);margin-bottom:0.25rem;">Primäres Modell</label>
          <select id="animus-model" style="width:100%;padding:0.6rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text);font-size:0.9rem;">
            <option value="ollama/qwen2.5-coder:32b">🦙 Ollama: Qwen 2.5 Coder 32B (Mac Studio Local)</option>
            <option value="claude-3-7-sonnet">🧠 Claude 3.7 Sonnet (Anthropic API)</option>
            <option value="gemini-2.0-flash">⚡ Gemini 2.0 Flash (Google API)</option>
            <option value="codex-cli">💻 Codex CLI (OpenAI)</option>
          </select>
        </div>
        <div>
          <label style="display:block;font-size:0.8rem;color:var(--text-muted);margin-bottom:0.25rem;">Tokenlimit-Fallback</label>
          <select id="animus-fallback" style="width:100%;padding:0.6rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text);font-size:0.9rem;">
            <option value="ollama/qwen2.5-coder:32b" selected>Automatisch auf Mac Studio Ollama ausweichen</option>
            <option value="pause">Pausieren und Meldung an Governance</option>
            <option value="gemini-2.0-flash">Auf schnelles Flash-Modell wechseln</option>
          </select>
        </div>
        <div style="display:flex;justify-content:flex-end;gap:0.75rem;margin-top:1rem;">
          <button type="button" class="btn" onclick="document.getElementById('modal-beseelen').classList.add('hidden')">Abbrechen</button>
          <button type="button" class="btn btn-primary" onclick="confirmBeseelen()">Konfiguration vormerken</button>
        </div>
