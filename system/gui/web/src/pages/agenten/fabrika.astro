    </div>
  </div>

  <style>
    .hidden { display: none !important; }
    .fab-tab-btn {
      padding: 0.55rem 1.35rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
      background: transparent;
      border: 1px solid transparent;
      border-radius: 24px;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
    .fab-tab-btn:hover {
      color: var(--text);
      background: rgba(255, 255, 255, 0.06);
    }
    .fab-tab-btn.active {
      background: var(--accent);
      color: #0b0d14;
      font-weight: 700;
      border-color: var(--accent);
      box-shadow: 0 2px 10px rgba(56, 189, 248, 0.35);
    }
    .blueprint-chip {
      padding: 0.35rem 0.75rem;
      font-size: 0.78rem;
      border: 1px solid var(--border);
      border-radius: 20px;
      background: var(--bg-card);
      color: var(--text);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      transition: all 0.15s ease;
      user-select: none;
    }
    .blueprint-chip:hover {
      border-color: var(--accent);
      background: rgba(56, 189, 248, 0.1);
    }
    .blueprint-chip.selected {
      border-color: var(--accent);
      background: var(--accent);
      color: #0b0d14;
      font-weight: 600;
    }
  </style>

  <script is:inline>
    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    let _allBlueprints = [];
    let _selectedTeamMembers = new Set();

    function renderTeamBlueprintPicker(blueprints) {
      _allBlueprints = blueprints || [];
      const picker = document.getElementById('team-blueprint-picker');
      if (!picker) return;
      if (_allBlueprints.length === 0) {
        picker.innerHTML = '<span style="color:var(--text-muted);font-size:0.8rem;">Keine Schablonen vorhanden. Erstelle zuerst eine Schablone in Tab 1!</span>';
        return;
      }
      picker.innerHTML = _allBlueprints.map(b => {
        const isSel = _selectedTeamMembers.has(b.name);
        return `<button type="button" class="blueprint-chip ${isSel ? 'selected' : ''}" onclick="toggleTeamMemberById(${Number(b.id)})">
          <span>${isSel ? '✓' : '+'}</span>
          <span>${escapeHtml(b.name)}</span>
          <span style="opacity:0.7;font-size:0.7rem;">(${escapeHtml(b.persona_role || b.role || 'Agent')})</span>
        </button>`;
      }).join('');
    }

    function toggleTeamMemberById(id) {
      const blueprint = _allBlueprints.find(b => Number(b.id) === id);
      if (!blueprint) return;
      const name = blueprint.name;
      if (_selectedTeamMembers.has(name)) {
        _selectedTeamMembers.delete(name);
      } else {
        _selectedTeamMembers.add(name);
      }
      document.getElementById('team-members').value = Array.from(_selectedTeamMembers).join(', ');
      renderTeamBlueprintPicker(_allBlueprints);
    }


    const NEUTRAL_PERSONA_DRAFT = 'Du bist ein konfigurierbarer Assistent. Ergänze hier deine konkrete Rolle, Arbeitsweise und Grenzen. Diese Persona ersetzt keine Systemregeln und aktiviert keinen Worker.';
    let _corePromptData = null;

    function corePromptMessage(message) {
      document.getElementById('core-prompt-status').textContent = message;
    }

    function showCorePrompt() {
      const key = document.getElementById('core-prompt-key').value;
      const prompt = _corePromptData?.prompts?.[key];
      const editor = document.getElementById('core-prompt-text');
      editor.value = prompt?.effective || '';
      document.getElementById('core-prompt-default').value = prompt?.default || '';
      editor.disabled = !prompt;
      for (const id of ['core-prompt-save', 'core-prompt-reset', 'core-prompt-use']) {
        document.getElementById(id).disabled = !prompt ||
          (id === 'core-prompt-use' && _corePromptData?.source === 'in_memory_defaults') ||
          (id !== 'core-prompt-use' && _corePromptData?.mutation_supported !== true);
      }
      corePromptMessage(prompt ? (_corePromptData?.source === 'in_memory_defaults' ?
        'Nur unbestätigte Speicher-Defaults. Keine aktive Control-Konfiguration nachgewiesen; Übernahme und Schreiben gesperrt.' :
        _corePromptData?.mutation_supported !== true ?
        'Unversionierte Control-Antwort: Prompt zur ausdrücklichen Vorschau, aktive Konfiguration nicht bestätigt. Schreiben gesperrt.' :
        prompt.is_custom ? 'Aktive eigene Anpassung · Werkstandard bleibt separat erhalten.' :
        'Aktiver Werkstandard aus der Control-Quelle.') : 'Promptquelle nicht verfügbar.');
    }

    async function loadCorePromptLibrary() {
      try {
        const res = await fetch('/api/system/core-prompts');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        if (data.schema !== 'bach.core-prompts.v1' || !data.prompts?.system_default ||
            (data.mutation_supported === true && typeof data.configuration_version !== 'string')) throw new Error('Promptantwort ungültig');
        const select = document.getElementById('core-prompt-key');
        select.disabled = false;
        const previous = select.value;
        select.replaceChildren();
        for (const key of Object.keys(data.prompts)) {
          const option = document.createElement('option');
          option.value = key;
          option.textContent = key === 'system_default' ? 'Buddha-Systemprompt' :
            'Rolle: ' + key.slice('role_'.length).replaceAll('_', ' ');
          select.append(option);
        }
        _corePromptData = data;
        select.value = data.prompts[previous] ? previous : 'system_default';
        showCorePrompt();
      } catch (_error) {
        _corePromptData = null;
        document.getElementById('core-prompt-key').disabled = true;
        for (const id of ['core-prompt-save', 'core-prompt-reset', 'core-prompt-use']) {
          document.getElementById(id).disabled = true;
        }
        corePromptMessage('Promptquelle nicht erreichbar. Vorhandene Eingaben bleiben sichtbar; Speichern und Übernehmen sind bis zur erneuten Prüfung gesperrt.');
      }
    }

    async function saveCorePrompt() {
      if (!_corePromptData) return;
      const key = document.getElementById('core-prompt-key').value;
      const value = document.getElementById('core-prompt-text').value;
      if (!value.trim()) { corePromptMessage('Prompttext darf nicht leer sein.'); return; }
      corePromptMessage('Anpassung wird gespeichert…');
      try {
        const res = await fetch('/api/system/core-prompts/' + encodeURIComponent(key), {
          method: 'PUT', headers: {'Content-Type':'application/json'},
          body: JSON.stringify({configuration_version:_corePromptData.configuration_version,text:value})
        });
        const data = await res.json();
        if (!res.ok || data.ack?.configuration_saved !== true || data.ack?.worker_started !== false ||
            data.prompts?.[key]?.effective !== value || data.prompts?.[key]?.is_custom !== true) {
          throw new Error('Readback nicht bestätigt');
        }
        _corePromptData = data;
        showCorePrompt();
        corePromptMessage('Eigene Anpassung gespeichert und aus der Control-Konfiguration bestätigt.');
      } catch (_error) {
        corePromptMessage('Speicherung nicht bestätigt; Entwurf bleibt im Editor. Konfiguration vor erneutem Speichern prüfen.');
      }
    }

    async function resetCorePrompt() {
      if (!_corePromptData) return;
      const key = document.getElementById('core-prompt-key').value;
      if (!window.confirm('Nur die aktive eigene Anpassung dieser Promptvorlage entfernen?')) return;
      try {
        const res = await fetch('/api/system/core-prompts/' + encodeURIComponent(key) + '/reset', {
          method: 'POST', headers: {'Content-Type':'application/json'},
          body: JSON.stringify({configuration_version:_corePromptData.configuration_version})
        });
        const data = await res.json();
        const prompt = data.prompts?.[key];
        if (!res.ok || data.ack?.configuration_saved !== true || data.ack?.worker_started !== false ||
            !prompt || prompt.is_custom !== false || prompt.effective !== prompt.default) {
          throw new Error('Readback nicht bestätigt');
        }
        _corePromptData = data;
        showCorePrompt();
        corePromptMessage('Aktive Anpassung entfernt; unveränderlicher Werkstandard ist wieder wirksam.');
      } catch (_error) {
        corePromptMessage('Zurücksetzen nicht bestätigt. Bitte Status neu laden.');
      }
    }

    function useCorePromptAsPersona() {
      const key = document.getElementById('core-prompt-key').value;
      const prompt = _corePromptData?.prompts?.[key];
      if (!prompt) return;
      const target = document.getElementById('bp-persona');
      if (target.value.trim() && target.value !== NEUTRAL_PERSONA_DRAFT &&
          !window.confirm('Den vorhandenen Persona-Entwurf durch diesen Prompt ersetzen?')) return;
      target.value = prompt.effective;
      document.getElementById('bp-persona-source').textContent =
        'Entwurf aus Original-Control-Prompt ' + key + '. Für andere Agenten Identität und Brand vor dem Speichern anpassen.';
    }

    const PRESETS = {
      buddha: {
        name: "Buddha",
        persona: null, // Der echte Buddha-Prompt kommt ausschließlich aus der Control-Quelle.
        turns: 20,
        modus: "casualis"
      },
      wartung: {
        name: "Wartungs-Agent",
        persona: "Du bist der Wartungs-Agent. Deine Aufgabe ist die systematische System- und Repository-Hygiene: Tests ausführen, Linter prüfen, tote Dateien bereinigen und Statusberichte erstellen.",
        turns: 30,
        modus: "usus"
      },
      ati: {
        name: "Ati (Entwickler)",
        persona: "Du bist Ati, der Senior Software-Architekt in BACH. Du planst und implementierst robuste, modulare Softwarekomponenten unter strikter Beachtung von TDD, Security-Policies und Zero-Drift.",
        turns: 25,
        modus: "casualis"
      },
      research: {
        name: "Research Scout",
        persona: "Du bist der wissenschaftliche Recherche-Scout. Du durchsuchst arXiv, Crossref und lokale Wissensbestände nach validen Quellen und stellst evidenzbasierte Fact-Sheets zusammen.",
        turns: 15,
        modus: "impetus_causa"
      }
    };

    function loadPresetTemplate(key) {
      if (!key) return;
      if (key.startsWith('bp:')) {
        loadBlueprintByName(key.slice(3));
        return;
      }
      if (!PRESETS[key]) return;
      const p = PRESETS[key];
      const sourcePrompt = key === 'buddha' ? _corePromptData?.prompts?.system_default?.effective : null;
      if (key === 'buddha' && !sourcePrompt) {
        document.getElementById('bp-persona-source').textContent = 'Buddha-Originalprompt ist nicht verfügbar; keine Ersatzpersona eingesetzt.';
        return;
      }
      const currentPersona = document.getElementById('bp-persona').value;
      if (currentPersona && currentPersona !== NEUTRAL_PERSONA_DRAFT &&
          !window.confirm('Den bestehenden Persona-Entwurf durch diese Vorlage ersetzen?')) return;
      document.getElementById('bp-name').value = `${p.name} (eigene)`;
      document.getElementById('bp-name').readOnly = false;
      document.getElementById('bp-persona').value = sourcePrompt || p.persona;
      document.getElementById('bp-persona-source').textContent = key === 'buddha' ?
        'Original-Buddha-Prompt aus aktiver Control-Konfiguration. Eigene Änderungen bleiben editierbar.' :
        'Beispielpersona; fachliche Registry-Anbindung noch nicht geprüft.';
      document.getElementById('bp-turns').value = p.turns;
      document.getElementById('bp-modus').value = p.modus;
    }

    function resetForm() {
      document.getElementById('bp-name').value = '';
      document.getElementById('bp-name').readOnly = false;
      document.getElementById('bp-persona').value = NEUTRAL_PERSONA_DRAFT;
      document.getElementById('bp-persona-source').textContent = 'Neutrale Bearbeitungsvorlage; kein bestätigter Laufzeitprompt.';
      document.getElementById('bp-template-select').value = '';
      document.getElementById('bp-turns').value = 15;
      document.getElementById('bp-cooldown').value = 30;
      document.querySelectorAll('#skills-selector input[type="checkbox"]').forEach(box => box.checked = false);
    }

    async function loadBlueprints() {
      const container = document.getElementById('blueprints-list');
      try {
        const res = await fetch('/api/agent-studio/blueprints');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        const templates = data.templates || [];
        const custom = data.blueprints || [];
        _allBlueprints = [...templates, ...custom];
        document.getElementById('bp-count').textContent = _allBlueprints.length;
        renderTeamBlueprintPicker(_allBlueprints);

        if (_allBlueprints.length === 0) {
          container.innerHTML = '<p style="text-align:center;color:var(--text-muted);padding:1.5rem;">Keine Schablonen vorhanden.</p>';
          return;
        }

        container.innerHTML = _allBlueprints.map(b => `
          <div style="padding:0.75rem;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm);">
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <strong style="font-size:0.9rem;color:var(--text);">${escapeHtml(b.name)}</strong>
              <span class="badge badge-accent">${escapeHtml(b.persona_role || b.kind || 'Schablone')}</span>
            </div>
            <p style="font-size:0.75rem;color:var(--text-muted);margin:0.4rem 0;">${escapeHtml((b.persona_prompt || b.description || '').slice(0, 80))}...</p>
            <div style="display:flex;justify-content:flex-end;gap:0.4rem;margin-top:0.5rem;">
              <button class="btn" style="padding:0.2rem 0.5rem;font-size:0.7rem;" onclick="loadBlueprintToEditor(${Number(b.id)})">Bearbeiten</button>
              <button class="btn btn-primary" style="padding:0.2rem 0.5rem;font-size:0.7rem;" onclick="openBeseelenModal(${Number(b.id)})">Vormerken ✨</button>
            </div>
          </div>
        `).join('');
      } catch (e) {
        container.innerHTML = `<p style="color:var(--error);font-size:0.8rem;">Fehler: ${e.message}</p>`;
      }
    }

    function loadBlueprintByName(name) {
      if (!name) return;
      const bp = _allBlueprints.find(b => b.name.toLowerCase() === name.toLowerCase() || String(b.id) === String(name));
      if (bp) {
        loadBlueprintToEditor(bp.id);
      }
    }

    function loadBlueprintToEditor(id) {
      const blueprint = _allBlueprints.find(b => String(b.id) === String(id) || b.name.toLowerCase() === String(id).toLowerCase());
      if (!blueprint) { alert('Schablone nicht gefunden. Bitte Liste neu laden.'); return; }
      document.getElementById('bp-name').value = blueprint.name;
      document.getElementById('bp-name').readOnly = !!blueprint.is_template;
      document.getElementById('bp-persona').value = blueprint.persona_prompt || '';
      document.getElementById('bp-persona-source').textContent = `Blueprint ${blueprint.title || blueprint.name} geladen.`;
      document.getElementById('bp-turns').value = blueprint.contractus?.turns ?? 15;
      document.getElementById('bp-cooldown').value = blueprint.contractus?.cooldown_seconds ?? 0;
      document.getElementById('bp-modus').value = blueprint.modus || 'casualis';
      const profile = document.getElementById('bp-gov-profile');
      if (profile && blueprint.governance?.profile) profile.value = blueprint.governance.profile;
      const skills = new Set(blueprint.skills || []);
      document.querySelectorAll('#skills-selector input[type="checkbox"]').forEach(box => {
        box.checked = skills.has(box.value);
      });
      const tools = new Set(blueprint.governance?.tool_whitelist || []);
      document.getElementById('tool-read').checked = tools.has('read_files');
      document.getElementById('tool-write').checked = tools.has('write_files');
      document.getElementById('tool-cmd').checked = tools.has('execute_command');
      document.getElementById('tool-git').checked = tools.has('git_guarded_p001');
      document.getElementById('tool-mcp').checked = tools.has('mcp_cookbooks');
      document.getElementById('tool-web').checked = tools.has('web_fetch');
      document.getElementById('bp-name').focus();
    }

    let selectedBlueprintId = null;

    function selectConfiguredValue(id, value) {
      const field = document.getElementById(id);
      Array.from(field.options).filter(option => option.dataset.saved === 'true').forEach(option => option.remove());
      if (!value) { field.selectedIndex = 0; return; }
      if (!Array.from(field.options).some(option => option.value === value)) {
        const option = new Option(value + ' (gespeichert)', value);
        option.dataset.saved = 'true';
        field.add(option);
      }
      field.value = value;
    }

    async function fetchBlueprintById(id) {
      const response = await fetch('/api/agent-studio/blueprints');
      if (!response.ok) throw new Error('Readback HTTP ' + response.status);
      const data = await response.json();
      return (data.blueprints || []).find(b => Number(b.id) === id);
    }

    function openBeseelenModal(id) {
      const blueprint = id == null
        ? _allBlueprints.find(b => b.name === document.getElementById('bp-name').value.trim().toLowerCase())
        : _allBlueprints.find(b => Number(b.id) === id);
      if (!blueprint) { alert('Bitte speichere zuerst die Schablone.'); return; }
      selectedBlueprintId = Number(blueprint.id);
      selectConfiguredValue('animus-type', blueprint.animus_type);
      selectConfiguredValue('animus-model', blueprint.contractus?.model);
      selectConfiguredValue('animus-fallback', blueprint.contractus?.fallback);
      document.getElementById('modal-beseelen').classList.remove('hidden');
    }

    async function confirmBeseelen() {
      if (!Number.isInteger(selectedBlueprintId)) return;
      try {
        const blueprint = await fetchBlueprintById(selectedBlueprintId);
        if (!blueprint) throw new Error('Schablone nicht mehr vorhanden');
        const animusType = document.getElementById('animus-type').value;
        const model = document.getElementById('animus-model').value;
        const fallback = document.getElementById('animus-fallback').value;
        const configured = await fetch('/api/agent-studio/blueprints', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: blueprint.name,
            title: blueprint.title,
            description: blueprint.description,
            persona_role: blueprint.persona_role,
            persona_prompt: blueprint.persona_prompt,
            skills: blueprint.skills,
            animus_type: animusType,
            contractus: { ...blueprint.contractus, model, fallback },
            modus: blueprint.modus,
            governance: blueprint.governance
          })
        });
        if (!configured.ok || (await configured.json()).success !== true) {
          throw new Error('Konfiguration HTTP ' + configured.status);
        }
        const saved = await fetchBlueprintById(selectedBlueprintId);
        if (!saved || saved.animus_type !== animusType || saved.contractus?.model !== model || saved.contractus?.fallback !== fallback) {
          throw new Error('Modellkonfiguration nicht bestätigt');
        }
        const response = await fetch(`/api/agent-studio/blueprints/${selectedBlueprintId}/materialize`, { method: 'POST' });
        if (!response.ok) throw new Error('HTTP ' + response.status);
        const result = await response.json();
        if (result.success !== true || result.status !== 'configured') throw new Error('Keine Bestätigung der Konfiguration');
        const materialized = await fetchBlueprintById(selectedBlueprintId);
        if (!materialized || Number(materialized.is_materialized) !== 1) throw new Error('Konfiguration nicht bestätigt');
        document.getElementById('modal-beseelen').classList.add('hidden');
        alert('Modell, Typ und Fallback als Konfiguration gespeichert. Kein Agentenprozess gestartet.');
        window.location.href = '/agenten/running';
      } catch (error) {
        alert('Konfiguration konnte nicht bestätigt werden: ' + error.message);
      }
    }

    function applyGovProfile(profile) {
      const read = document.getElementById('tool-read');
      const write = document.getElementById('tool-write');
      const cmd = document.getElementById('tool-cmd');
      const git = document.getElementById('tool-git');
      const mcp = document.getElementById('tool-mcp');
      const web = document.getElementById('tool-web');

    let _allAvailableSkills = [];
    let _contractusPresets = [];

    async function loadDynamicSkills() {
      const catSelect = document.getElementById('skills-cat-filter');
      const badge = document.getElementById('skills-count-badge');
      try {
        const res = await fetch('/api/capabilities/skills');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        _allAvailableSkills = data.skills || [];
        if (badge) badge.textContent = `${_allAvailableSkills.length} Skills verifiziert`;

        if (catSelect) {
          catSelect.replaceChildren();
          const allOpt = document.createElement('option');
          allOpt.value = '';
          allOpt.textContent = 'Alle Kategorien';
          catSelect.append(allOpt);
          for (const cat of (data.categories || [])) {
            const opt = document.createElement('option');
            opt.value = cat;
            opt.textContent = cat;
            catSelect.append(opt);
          }
        }
        renderSkillsSelector(_allAvailableSkills);
      } catch (e) {
        if (badge) badge.textContent = 'Fallback aktiv';
        console.warn('Skills-Ladefehler:', e);
      }
    }

    function filterSkillsSelector() {
      const term = (document.getElementById('skills-filter-input')?.value || '').toLowerCase().trim();
      const cat = document.getElementById('skills-cat-filter')?.value || '';
      const filtered = _allAvailableSkills.filter(s => {
        if (cat && s.category !== cat) return false;
        if (term && !s.id.toLowerCase().includes(term) && !(s.name || '').toLowerCase().includes(term) && !(s.role || '').toLowerCase().includes(term)) return false;
        return true;
      });
      renderSkillsSelector(filtered);
    }

    function renderSkillsSelector(skills) {
      const container = document.getElementById('skills-selector');
      if (!container) return;
      const checked = new Set(Array.from(container.querySelectorAll('input[type="checkbox"]:checked'), box => box.value));
      container.innerHTML = skills.map(s => `
        <label title="${escapeHtml(s.role || s.description || s.name)}" style="display:flex;align-items:center;gap:0.4rem;font-size:0.78rem;cursor:pointer;background:rgba(255,255,255,0.03);padding:0.25rem 0.4rem;border-radius:4px;border:1px solid rgba(255,255,255,0.06);">
          <input type="checkbox" value="${escapeHtml(s.id)}" ${checked.has(s.id) ? 'checked' : ''} />
          <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escapeHtml(s.id)}</span>
        </label>
      `).join('');
    }

    async function loadContractusPresets() {
      const select = document.getElementById('bp-contractus-preset');
      if (!select) return;
      try {
        const res = await fetch('/api/agent-studio/contractus-presets');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        _contractusPresets = data.presets || [];
        select.replaceChildren();
        const defaultOpt = document.createElement('option');
        defaultOpt.value = '';
        defaultOpt.textContent = '-- Contractus-Preset wählen (GUX-023) --';
        select.append(defaultOpt);
        for (const p of _contractusPresets) {
          const opt = document.createElement('option');
          opt.value = p.id;
          opt.textContent = `${p.name} (${p.modus})`;
          select.append(opt);
        }
      } catch (e) {
        console.warn('Contractus-Presets Ladefehler:', e);
      }
    }

    function applyContractusPreset(presetId) {
      if (!presetId) return;
      const p = _contractusPresets.find(x => x.id === presetId);
      if (!p) return;
      if (p.turns) document.getElementById('bp-turns').value = p.turns;
      if (p.cooldown_seconds !== undefined) document.getElementById('bp-cooldown').value = p.cooldown_seconds;
      if (p.task_types && p.task_types.length > 0) {
        const taskTypeSelect = document.getElementById('bp-task-type');
        if (taskTypeSelect) {
          const matched = Array.from(taskTypeSelect.options).find(o => p.task_types.includes(o.value));
          if (matched) taskTypeSelect.value = matched.value;
        }
      }
      if (p.modus) {
        const modusSelect = document.getElementById('bp-modus');
        if (modusSelect) modusSelect.value = p.modus;
      }
      if (p.wake_behavior) {
        const wakeSelect = document.getElementById('bp-wake');
        if (wakeSelect) wakeSelect.value = p.wake_behavior;
      }
    }

    async function populateTemplateSelector() {
      const select = document.getElementById('bp-template-select');
      if (!select) return;
      try {
        const res = await fetch('/api/agent-studio/blueprints');
        if (!res.ok) return;
        const data = await res.json();
        const templates = data.templates || [];
        const custom = data.blueprints || [];
        select.replaceChildren();

        const noneOpt = document.createElement('option');
        noneOpt.value = '';
        noneOpt.textContent = '-- Eigene Persona schreiben / Blueprint laden --';
        select.append(noneOpt);

        if (templates.length > 0) {
          const groupTmpl = document.createElement('optgroup');
          groupTmpl.label = 'System-Vorlagen (Templates)';
          for (const t of templates) {
            const opt = document.createElement('option');
            opt.value = `bp:${t.name}`;
            opt.textContent = `⭐ ${t.title || t.name} (${t.kind || 'agent'})`;
            groupTmpl.append(opt);
          }
          select.append(groupTmpl);
        }

        if (custom.length > 0) {
          const groupCustom = document.createElement('optgroup');
          groupCustom.label = 'Eigene Blueprints';
          for (const c of custom) {
            const opt = document.createElement('option');
            opt.value = `bp:${c.name}`;
            opt.textContent = `📐 ${c.title || c.name}`;
            groupCustom.append(opt);
          }
          select.append(groupCustom);
        }
      } catch (e) {
        console.warn('Template selector population failed:', e);
      }
    }

    async function synthesizeAndPreviewPrompt() {
      const name = document.getElementById('bp-name').value.trim() || 'unbenannter_agent';
      const persona = document.getElementById('bp-persona').value.trim();
      const turns = parseInt(document.getElementById('bp-turns').value || '15', 10);
      const modus = document.getElementById('bp-modus').value;
      const selectedSkills = Array.from(document.querySelectorAll('#skills-selector input[type="checkbox"]:checked'), box => box.value);
      const govProfile = document.getElementById('bp-gov-profile')?.value || 'fail_closed_standard';

      if (!persona) {
        alert('❌ Validierungs-Gate abgewiesen (fail-closed): Persona-Prompt darf nicht leer sein (GUX-029).');
        return;
      }

      const bpData = {
        name,
        persona_role: name,
        persona_prompt: persona,
        skills: selectedSkills,
        contractus: { turns },
        modus,
        governance: { profile: govProfile }
      };

      try {
        const res = await fetch('/api/agent-studio/synthesize-prompt', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ blueprint: bpData })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.detail || 'Synthese fehlgeschlagen');
        alert(`🚀 Startprompt erfolgreich synthetisiert (${data.character_count} Zeichen):\n\n${data.start_prompt.slice(0, 500)}...\n\n(Vollständiger Prompt wird beim Boot injiziert)`);
      } catch (e) {
        alert(`❌ Validierungs-Gate abgewiesen (fail-closed): ${e.message}`);
      }
    }

    function applyGovProfile(profile) {
      const read = document.getElementById('tool-read');
      const write = document.getElementById('tool-write');
      const cmd = document.getElementById('tool-cmd');
      const git = document.getElementById('tool-git');
      const mcp = document.getElementById('tool-mcp');
      const web = document.getElementById('tool-web');

      if (profile === 'read_only_research') {
        if (read) read.checked = true;
        if (write) write.checked = false;
        if (cmd) cmd.checked = false;
        if (git) git.checked = false;
        if (mcp) mcp.checked = true;
        if (web) web.checked = true;
      } else if (profile === 'full_dev_guarded') {
        if (read) read.checked = true;
        if (write) write.checked = true;
        if (cmd) cmd.checked = true;
        if (git) git.checked = true;
        if (mcp) mcp.checked = true;
        if (web) web.checked = true;
      } else { // fail_closed_standard
        if (read) read.checked = true;
        if (write) write.checked = true;
        if (cmd) cmd.checked = true;
        if (git) git.checked = true;
        if (mcp) mcp.checked = true;
        if (web) web.checked = false;
      }
    }

    async function saveBlueprint() {
      const name = document.getElementById('bp-name').value.trim();
      const persona = document.getElementById('bp-persona').value.trim();
      const turns = parseInt(document.getElementById('bp-turns').value || '15', 10);
      const cooldown = parseInt(document.getElementById('bp-cooldown').value || '30', 10);
      const modus = document.getElementById('bp-modus').value;
      const govProfile = document.getElementById('bp-gov-profile') ? document.getElementById('bp-gov-profile').value : 'fail_closed_standard';

      if (!name) { alert('Bitte gib einen Schablonen-Namen an.'); return; }
      if (!persona) { alert('Persona-Prompt darf nicht leer sein (GUX-029).'); return; }

      const allowedTools = [];
      if (document.getElementById('tool-read')?.checked) allowedTools.push('read_files', 'search_content');
      if (document.getElementById('tool-write')?.checked) allowedTools.push('write_files');
      if (document.getElementById('tool-cmd')?.checked) allowedTools.push('execute_command', 'run_tests');
      if (document.getElementById('tool-git')?.checked) allowedTools.push('git_guarded_p001');
      if (document.getElementById('tool-mcp')?.checked) allowedTools.push('mcp_cookbooks');
      if (document.getElementById('tool-web')?.checked) allowedTools.push('web_fetch');

      const existing = _allBlueprints.find(b => b.name === name.toLowerCase());
      const selectedSkills = Array.from(document.querySelectorAll('#skills-selector input[type="checkbox"]:checked'), box => box.value);

      const governance = {
        profile: govProfile,
        tool_whitelist: allowedTools,
        hooker_auditing: true,
        policies: ["P-001 Fail-Closed Git", "P-004 Lock-Master"]
      };

      try {
        const res = await fetch('/api/agent-studio/blueprints', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            title: existing?.title || name,
            description: existing?.description || '',
            persona_role: existing?.persona_role || name,
            persona_prompt: persona,
            skills: selectedSkills,
            animus_type: existing?.animus_type || 'subscription',
            contractus: { ...(existing?.contractus || {}), turns, cooldown_seconds: cooldown },
            modus,
            governance: { ...(existing?.governance || {}), ...governance }
          })
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          await loadBlueprints();
          await populateTemplateSelector();
          alert(`Schablone & Governance gespeichert. Startprompt verifiziert (${data.character_count || 'aktiv'} Zeichen).`);
        } else {
          alert('Fehler beim Speichern: ' + (data.detail || 'HTTP ' + res.status));
        }
      } catch (err) {
        alert('Netzwerkfehler: ' + err.message);
      }
    }

    function setupFabrikaTabs() {
      const tabBtns = document.querySelectorAll('.fab-tab-btn');
      const tabPanes = document.querySelectorAll('.fab-pane');
      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const tab = btn.getAttribute('data-tab');
          tabBtns.forEach(b => b.classList.remove('active'));
          tabPanes.forEach(p => p.style.display = 'none');

          btn.classList.add('active');
          const pane = document.getElementById('pane-' + tab);
          if (pane) {
            pane.style.display = 'flex';
          }
          if (tab === 'teambuilding') {
            loadTeams();
            renderTeamBlueprintPicker(_allBlueprints);
          }
        });
      });
    }

    async function loadTeams() {
      const container = document.getElementById('teams-list-container');
      if (!container) return;
      try {
        const res = await fetch('/api/agenten/teams');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        const teams = data.teams || [];
        container.innerHTML = teams.map(t => `
          <div style="background:var(--bg-dark);border:1px solid var(--border);border-radius:var(--radius-sm);padding:1rem;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.25rem;">
              <strong>${escapeHtml(t.name)}</strong>
              <span class="badge badge-accent">${escapeHtml(t.strategy)}</span>
            </div>
            <p style="font-size:0.8rem;color:var(--text-muted);margin:0.25rem 0;">${escapeHtml(t.description || 'Keine Beschreibung')}</p>
            <div style="font-size:0.75rem;color:var(--accent);margin-top:0.5rem;">
              👑 Leader: <strong>${escapeHtml(t.leader_agent)}</strong> | 👥 Mitglieder: ${escapeHtml(t.member_agents)}
            </div>
            <div style="margin-top:0.75rem;display:flex;justify-content:flex-end;">
              <a href="/agenten/running#teams" class="btn btn-primary" style="padding:0.25rem 0.6rem;font-size:0.75rem;">
                ✨ Beseelen in Living & Running ➔
              </a>
            </div>
          </div>
        `).join('');
      } catch (err) {
        container.innerHTML = `<p class="text-danger">Fehler beim Laden: ${err.message}</p>`;
      }
    }

    async function assembleTeam() {
      const name = document.getElementById('team-name').value.trim();
      const description = document.getElementById('team-desc').value.trim();
      const leader_agent = document.getElementById('team-leader').value;
      const strategy = document.getElementById('team-strategy').value;
      const member_agents = document.getElementById('team-members').value.trim();

      if (!name || !member_agents) {
        alert('Name und Mitglieder erforderlich');
        return;
      }

      try {
        const res = await fetch('/api/agenten/teams', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, description, leader_agent, strategy, member_agents })
        });
        if (res.ok) {
          alert(`Team "${name}" erfolgreich assembliert!`);
          document.getElementById('team-name').value = '';
          document.getElementById('team-desc').value = '';
          document.getElementById('team-members').value = '';
          loadTeams();
        } else {
          alert('Fehler beim Assemblieren des Teams.');
        }
      } catch (e) {
        alert('Netzwerkfehler: ' + e.message);
      }
    }

    window.addEventListener('DOMContentLoaded', async () => {
      resetForm();
      await loadDynamicSkills();
      await loadContractusPresets();
      await loadCorePromptLibrary();
      await loadBlueprints();
      await populateTemplateSelector();
      setupFabrikaTabs();

      const urlParams = new URLSearchParams(window.location.search);
      const loadTarget = urlParams.get('load') || urlParams.get('blueprint');
      if (loadTarget) {
        loadBlueprintByName(loadTarget);
      }
    });
  </script>
</BachLayout>
