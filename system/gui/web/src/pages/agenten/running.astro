              </div>

              <div style="display:flex;justify-content:space-between;align-items:center;">
                <button class="btn btn-sm" style="font-size:0.72rem;color:var(--error);" onclick="deleteStaffelFromRunning(${c.id})">🗑️ Löschen</button>
                <div style="display:flex;gap:0.35rem;">
                  <button class="btn btn-sm" style="font-size:0.72rem;" onclick="runStaffelChain(${c.id})">▶ Losschicken</button>
                  <button class="btn btn-sm btn-primary" style="font-size:0.75rem;" onclick="saveStaffelBeseelung(${c.id})">
                    ✨ Speichern
                  </button>
                </div>
              </div>
            </div>
          `;
