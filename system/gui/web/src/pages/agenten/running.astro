                <div style="display:flex;justify-content:flex-end;gap:0.4rem;border-top:1px solid var(--border);padding-top:0.6rem;">
                  <button class="btn btn-sm" onclick="runWorkerAction('${escapeHtml(w.id)}', 'pause')">⏸ Pause</button>
                  <button class="btn btn-sm" style="color:var(--error);" onclick="runWorkerAction('${escapeHtml(w.id)}', 'stop')">⏹ Stoppen</button>
                </div>
              </div>
            `;
          }).join('');
        }
      } catch (error) {
        summary.textContent = 'Workerstatus konnte nicht geladen werden.';
      }
    }

    async function runWorkerAction(workerId, action, generation) {
      try {
        const response = await fetch(`/api/system/workers/${encodeURIComponent(workerId)}/${action}`, {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify(action === 'handoff' ? {generation} : {})
        });
        if (response.ok) {
          loadBackgroundWorkers();
        } else {
          alert('Aktion konnte nicht ausgeführt werden.');
        }
      } catch (e) {
        alert('Netzwerkfehler: ' + e.message);
      }
    }

    async function deleteWorker(workerId) {
      if (!confirm('Diesen Worker wirklich löschen?')) return;
      try {
        const res = await fetch(`/api/system/workers/${encodeURIComponent(workerId)}/delete`, {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({})
        });
        if (res.ok) {
          loadBackgroundWorkers();
        } else {
          alert('Fehler beim Löschen des Workers.');
        }
      } catch (e) {
        alert('Netzwerkfehler: ' + e.message);
      }
    }

