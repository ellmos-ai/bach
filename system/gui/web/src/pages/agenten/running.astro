---
// running.astro - Living & Running: Status Cockpit, Beseelung von Teams & Staffeln, Core Slots & Live Aktivitäten
import BachLayout from "../../layouts/BachLayout.astro";
---

<BachLayout title="Living & Running" currentPath="/agenten/running">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem;">
    <div>
      <h1 style="font-size:1.75rem;font-weight:800;letter-spacing:-0.02em;margin-bottom:0.25rem;">
        ⚡ Living & Running
      </h1>
      <p style="color:var(--text-muted);font-size:0.875rem;">
        Agentenprofile, Teams & Staffeln • Compute-Vorrang • Core-Slots & Live-Aktivitäten
      </p>
    </div>

    <div style="display:flex;gap:0.5rem;align-items:center;">
      <a href="/agenten/fabrika" class="btn">
        <span>🏭</span> Zur Agenten-Fabrik
      </a>
      <button class="btn btn-primary" onclick="refreshAll(true)">
        <span>🔄</span> Jetzt aktualisieren
      </button>
    </div>
  </div>

  <!-- Hardwarebeobachtung steht vor den Agentenkarten. Vorrang ist kein Besitz. -->
  <section class="card hardware-torch" aria-labelledby="hardware-torch-title">
    <div class="card-header">
      <div>
        <h2 class="card-title" id="hardware-torch-title">Hardware-Fackel & Compute-Vorrang</h2>
        <p class="torch-intro">Besitz, Vorrang, Compute-Meldung und Ollama-Belegung sind getrennte Nachweise.</p>
      </div>
      <span class="badge" id="torch-observed-at">Nicht geprüft</span>
    </div>
    <div class="torch-grid">
      <div class="torch-panel torch-owner" role="status" aria-live="polite">
        <svg id="hardware-flame" class="torch-svg" viewBox="0 0 64 80" role="img" aria-labelledby="torch-svg-title">
          <title id="torch-svg-title">Hardware-Fackel ohne bestätigten Besitz</title>
          <path class="torch-flame-outer" d="M31 4c7 14 5 22 2 28 10-3 13-12 14-16 17 18 17 42 4 55-11 11-32 11-43-1C-2 59 2 41 15 28c1 9 3 14 8 17-2-16 1-29 8-41Z"/>
          <path class="torch-flame-inner" d="M33 39c2 7 6 10 9 15 5 11-1 22-11 22-10 0-16-11-11-21 2-5 8-10 13-16Z"/>
        </svg>
        <div>
          <strong>Hardware-Besitz</strong>
          <p id="fackel-holder">Nicht geprüft</p>
          <small id="fackel-owner-reason">Ein aktueller Halternachweis fehlt.</small>
        </div>
      </div>
      <div class="torch-panel">
        <strong>Compute-Vorrang</strong>
        <p id="fackel-priority">Nicht geprüft</p>
        <button id="btn-toggle-fackel" class="btn btn-sm" type="button" onclick="toggleFackel()" disabled>Vorrang ändern</button>
        <small>Diese Einstellung erwirbt keine Fackel und startet keinen Agenten.</small>
      </div>
      <div class="torch-panel">
        <strong>Compute-Lock</strong>
        <p id="fackel-compute">Nicht geprüft</p>
        <small>Eine Meldung über Rechenjobs ist kein Besitznachweis.</small>
      </div>
      <div class="torch-panel">
        <strong>Ollama-Kapazität</strong>
        <p id="fackel-capacity">Nicht geprüft</p>
        <small>Geladene Modelle und belegte Einheiten sind kein globaler GPU-Zähler.</small>
      </div>
    </div>
    <p id="fackel-feedback" class="torch-feedback" role="status" aria-live="polite"></p>
  </section>

  <div class="card" style="margin-bottom:1.5rem;">
    <div class="card-header"><h2 class="card-title">Verifizierte Agentenprofile</h2></div>
    <p style="font-size:0.8rem;color:var(--text-muted);">Der Chat prüft Profil, Sitzung und Backend vor dem Senden. Start und Stopp eines Agentenprozesses sind hier derzeit nicht freigegeben.</p>
    <div id="trusted-profile-list" style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-top:0.75rem;" role="status">Profile werden geprüft…</div>
  </div>

  <!-- 2. TEAMS BESEELEn (SWARM-AI) & AGENTEN-STAFFELN (MARBLERUN) BESEELEn -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:1.5rem;align-items:start;">
    <!-- TEAMS BESEELEN -->
    <div class="card" id="teams">
      <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;">
        <div>
          <h2 class="card-title">👥 Teams Beseelen (Swarm-AI)</h2>
          <p style="font-size:0.8rem;color:var(--text-muted);margin:0.25rem 0 0 0;">
            Mitglieder mit Modellen ausstatten (Claude, Gemini, Codex, Ollama)
          </p>
        </div>
        <a href="/agenten/fabrika" class="btn btn-sm">+ Neues Team</a>
      </div>
      <div id="teams-beseelen-container" style="display:flex;flex-direction:column;gap:1rem;margin-top:1rem;">
        <p class="loading-state">Lade konfigurierte Teams...</p>
      </div>
    </div>

    <!-- AGENTEN-STAFFELN (MARBLERUN) BESEELEN -->
    <div class="card" id="staffeln">
      <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;">
        <div>
          <h2 class="card-title">⛓️ Agenten-Staffel (MarbleRun) Beseelen</h2>
          <p style="font-size:0.8rem;color:var(--text-muted);margin:0.25rem 0 0 0;">
            Stations-Gliedern der Ketten dedizierte Modelle und Backends zuweisen
          </p>
        </div>
        <a href="/agenten/marblerun" class="btn btn-sm">Ketten-Editor ↗</a>
      </div>
      <div id="staffel-beseelen-container" style="display:flex;flex-direction:column;gap:1rem;margin-top:1rem;">
        <p class="loading-state">Lade Agenten-Staffeln...</p>
      </div>
    </div>
  </div>

  <!-- Drei feste System-Agenten, direkt aus der vorhandenen Control-Konfiguration. -->
  <section class="card" aria-labelledby="core-agents-title">
    <div class="card-header">
      <h2 class="card-title" id="core-agents-title">System-Agenten</h2>
      <span class="badge badge-accent">Drei feste technische IDs</span>
    </div>
    <p class="core-explanation">Buddha Chat, Always-On und Connector verwenden die bestehende Slot-Konfiguration. Speichern ändert Einstellungen; Living und Running erfordern eigene Laufzeitnachweise.</p>
    <div id="core-agent-feedback" role="status" aria-live="polite"></div>
    <div id="core-agent-cards" class="core-grid"><p class="loading-state">System-Agenten werden geprüft…</p></div>
  </section>

  <section class="card" aria-labelledby="openrouter-title" style="margin-top:1.5rem;">
    <div class="card-header">
      <h2 class="card-title" id="openrouter-title">OpenRouter · kostenlose Modelle</h2>
      <span class="badge" id="openrouter-credential-state">Wird geprüft</span>
    </div>
    <p class="core-explanation">
      <code>openrouter/free</code> wird unverändert an OpenRouter gesendet. Die Liste zeigt nur den kostenlosen Router
      und Modelle, deren veröffentlichte Ein- und Ausgabepreise null sind. Ein konfigurierter Schlüssel gilt hier nicht
      als live geprüft.
    </p>
    <datalist id="openrouter-free-models"></datalist>
    <p id="openrouter-catalog-state" role="status" aria-live="polite">Modellkatalog wird geladen…</p>
    <div id="openrouter-model-list" class="openrouter-model-list" role="list"></div>
  </section>

  <section class="card" aria-labelledby="worker-status-title" style="margin-top:1.5rem;">
    <div class="card-header">
      <h2 class="card-title" id="worker-status-title">Hintergrundworker · Living & Running</h2>
      <button class="btn btn-sm" type="button" onclick="loadBackgroundWorkers()">Status aktualisieren</button>
    </div>
    <p class="core-explanation">Live-Auszug aus den gespeicherten BACH-Workern und der Control API. Ein Worker zählt als Running, wenn die Laufzeit ihn als aktiv meldet.</p>
    <div class="worker-blueprint-panel">
      <h3>Hintergrundworker-Blaupause</h3>
      <p id="worker-blueprint-description" class="worker-control-note">Vorlage wird aus der BACH-Rollendefinition geladen…</p>
      <form id="worker-blueprint-form" class="worker-blueprint-form">
        <label>Anzeigename<input id="worker-blueprint-name" type="text" maxlength="120" value="BACH Hintergrundworker" required></label>
        <label>Worker-Modus<select id="worker-blueprint-sub-mode" required disabled><option value="">Modi werden geladen…</option></select></label>
        <label>Ausführung<select id="worker-blueprint-run-mode"><option value="continuous">Fortlaufend bis Stopp</option><option value="once">Einzellauf</option></select></label>
        <label>Task-ID (optional)<input id="worker-blueprint-task-id" type="number" min="1" max="2147483647" inputmode="numeric" placeholder="Für einen gezielten Auftrag"></label>
        <label>Backend
          <select id="worker-blueprint-backend">
            <option value="ollama-cloud">Ollama Cloud</option>
            <option value="openrouter">OpenRouter · kostenlos</option>
            <option value="ollama">Ollama lokal</option>
          </select>
        </label>
        <label>Modell<select id="worker-blueprint-model" required disabled><option value="">Modellkatalog wird geladen…</option></select></label>
        <label>Arbeitsmodus
          <select id="worker-blueprint-mode">
            <option value="safe">Sicher</option>
            <option value="full">Voller Modus</option>
          </select>
        </label>
        <label>Think
          <select id="worker-blueprint-think">
            <option value="true">Aktiv</option>
            <option value="false">Aus</option>
          </select>
        </label>
        <label>Maximale Tool-Runden<input id="worker-blueprint-turns" type="number" min="1" max="100" value="25" required></label>
        <label>Pausenauslöser<select id="worker-blueprint-pause-basis"><option value="runs">Abgeschlossene Läufe</option><option value="tasks">Abgeschlossene Aufgaben</option></select></label>
        <label>Pause nach Anzahl Auslöser<input id="worker-blueprint-pause-after" type="number" min="0" max="100" value="5" required></label>
        <label>Pausendauer (Minuten)<input id="worker-blueprint-pause-minutes" type="number" min="0" max="1440" value="1" required></label>
        <label>Automatischer Stopp nach (Minuten, 0 = unbegrenzt)<input id="worker-blueprint-ttl" type="number" min="0" max="1440" value="0"></label>
        <div id="worker-blueprint-expert-fields" class="worker-blueprint-extra" hidden>
          <label>Fachrolle<select id="worker-blueprint-role" disabled><option value="">Rollen werden geladen…</option></select></label>
          <label class="worker-blueprint-check"><input id="worker-blueprint-multi-role" type="checkbox"> Flexibler Expertenrollen-Pool</label>
        </div>
        <div id="worker-blueprint-boss-fields" class="worker-blueprint-extra" hidden>
          <label>Maximale Unter-Experten<input id="worker-blueprint-max-experts" type="number" min="1" max="10" value="3" required></label>
          <label>Modellzuordnung je Experte (JSON, optional)<textarea id="worker-blueprint-expert-models" rows="2" maxlength="2000" placeholder='{"entwickler":"Modell-ID aus dem Katalog"}'></textarea></label>
        </div>
        <label class="worker-blueprint-prompt">Zusatzauftrag (optional)<textarea id="worker-blueprint-task-prompt" rows="3" maxlength="20000" placeholder="Leer lassen: Der Worker sucht nach dem Start eine offene BACH-Aufgabe."></textarea></label>
        <label class="worker-blueprint-check"><input id="worker-blueprint-system-prompt" type="checkbox" checked> BACH-Systemprompt einbinden</label>
        <label class="worker-blueprint-check"><input id="worker-blueprint-allow-tools" type="checkbox" checked> Werkzeuge erlauben</label>
        <div class="worker-blueprint-submit">
          <small id="worker-blueprint-model-status" role="status" aria-live="polite">Modellquelle wird geprüft…</small>
          <button class="btn btn-primary" id="worker-blueprint-create" type="submit" disabled>Blueprint als Living-Profil anlegen</button>
        </div>
      </form>
      <p class="worker-control-note">Anlegen erstellt nur ein idle-Profil. Erst „Start“ löst einen Modellaufruf aus. Fortlaufende Worker laufen bis zum Stopp; ein positiver Wert setzt zusätzlich ein Zeitlimit. Taskworker benötigen eine Task-ID oder einen Zusatzauftrag.</p>
    </div>
    <p id="worker-status-summary" role="status" aria-live="polite">Workerstatus wird geprüft…</p>
    <div id="background-worker-list" class="background-worker-list" role="list"></div>
    <p class="worker-control-note">Aktionen laufen geräteauthentifiziert über den lokalen Control-Dienst. Always-On des festen System-Agenten bleibt davon getrennt.</p>
  </section>

  <!-- 4. LIVE-AKTIVITÄT & WORKER TIMELINE -->
  <div class="card">
    <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;">
      <h2 class="card-title">📊 Live-Aktivitätsanzeige & Verlauf (Timeline)</h2>
      <button class="btn btn-sm" onclick="refreshActivity()">Neu laden</button>
    </div>

    <div style="overflow-x:auto;margin-top:0.75rem;">
      <table class="data-table" style="width:100%;">
        <thead>
          <tr>
            <th style="width:100px;">Zeit</th>
            <th style="width:160px;">Akteur / Slot</th>
            <th>Aktivität (Tool, Task, Runde)</th>
            <th style="width:140px;">Modell</th>
            <th style="width:90px;">Status</th>
          </tr>
        </thead>
        <tbody id="activity-tbody">
          <tr><td colspan="5" style="text-align:center;color:var(--text-muted);">Lade Aktivitäten...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <style>
    .hardware-torch { margin-bottom: 1.5rem; }
    .torch-intro, .core-explanation { color: var(--text-muted); font-size: .85rem; margin: .4rem 0 1rem; }
    .torch-grid, .core-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 245px), 1fr)); gap: .85rem; }
    .torch-panel, .core-agent-card { min-width: 0; padding: 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--bg-dark); }
    .torch-panel p { margin: .5rem 0; overflow-wrap: anywhere; }
    .torch-panel small, .core-agent-card small { display: block; color: var(--text-muted); line-height: 1.4; overflow-wrap: anywhere; }
    .torch-owner { display: flex; align-items: center; gap: 1rem; }
    .torch-svg { width: 52px; height: 68px; flex: none; fill: none; stroke: var(--text-muted); stroke-width: 2px; opacity: .65; }
    .torch-svg .torch-flame-inner { display: none; }
    .torch-svg.is-owned { opacity: 1; stroke: #f97316; fill: #fbbf24; }
    .torch-svg.is-owned .torch-flame-inner { display: block; fill: #fef08a; stroke: #f97316; }
    .torch-feedback { min-height: 1.4em; color: var(--text-muted); font-size: .8rem; margin: .8rem 0 0; }
    .core-agent-card { display: flex; flex-direction: column; gap: .7rem; }
    .core-agent-card h3 { margin: 0; overflow-wrap: anywhere; }
    .core-agent-card label { display: flex; flex-direction: column; gap: .25rem; font-size: .78rem; color: var(--text-muted); }
    .core-agent-card input, .core-agent-card select { min-width: 0; width: 100%; padding: .4rem; color: var(--text); background: var(--bg-card); border: 1px solid var(--border); border-radius: 4px; }
    .core-agent-card .core-check { flex-direction: row; align-items: center; }
    .core-agent-card .core-check input { width: auto; }
    .core-agent-card .core-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; }
    .core-agent-card .core-actions { display: flex; gap: .5rem; flex-wrap: wrap; margin-top: auto; }
    .openrouter-model-list { display: flex; flex-wrap: wrap; gap: .45rem; }
    .openrouter-model-list code { border: 1px solid var(--border); border-radius: 4px; padding: .25rem .45rem; overflow-wrap: anywhere; }
    .background-worker-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: .75rem; }
    .background-worker-card { border: 1px solid var(--border); border-radius: 8px; padding: .85rem; min-width: 0; }
    .background-worker-card h3 { margin: 0 0 .45rem; font-size: 1rem; }
    .background-worker-card p, .background-worker-card small { overflow-wrap: anywhere; }
    .worker-state { display: inline-block; border: 1px solid var(--border); border-radius: 999px; padding: .12rem .5rem; margin-bottom: .45rem; font-size: .78rem; }
    .worker-turn-warning { margin: .45rem 0; padding: .5rem .65rem; border-left: .2rem solid var(--accent-warning, #f59e0b); border-radius: 4px; background: color-mix(in srgb, var(--accent-warning, #f59e0b) 12%, transparent); }
    .worker-control-note { color: var(--text-muted); font-size: .84rem; margin-top: .8rem; }
    .worker-blueprint-panel { border: 1px solid var(--border); border-radius: 8px; padding: 1rem; margin: .75rem 0 1rem; }
    .worker-blueprint-panel h3 { margin: 0 0 .35rem; font-size: 1rem; }
    .worker-blueprint-form { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); gap: .75rem; align-items: end; }
    .worker-blueprint-form label { display: grid; gap: .35rem; color: var(--text-muted); font-size: .82rem; }
    .worker-blueprint-form input, .worker-blueprint-form select, .worker-blueprint-form textarea { width: 100%; min-width: 0; padding: .5rem; border: 1px solid var(--border); border-radius: 5px; background: var(--bg-input, var(--bg-card)); color: var(--text); }
    .worker-blueprint-extra { display: contents; }
    .worker-blueprint-extra[hidden] { display: none !important; }
    .worker-blueprint-check { display: flex !important; flex-direction: row; align-items: center; gap: .5rem !important; min-height: 2.4rem; }
    .worker-blueprint-check input { width: auto !important; }
    .worker-blueprint-prompt, .worker-blueprint-extra > label:last-child { grid-column: 1 / -1; }
    .worker-blueprint-submit { display: flex; align-items: center; justify-content: space-between; gap: .75rem; flex-wrap: wrap; grid-column: 1 / -1; }
    @media (max-width: 520px) { .core-agent-card .core-fields { grid-template-columns: 1fr; } }
    @media (prefers-reduced-motion: no-preference) {
      .torch-svg.is-owned { animation: torch-glow 1.8s ease-in-out infinite alternate; }
      @keyframes torch-glow { from { filter: drop-shadow(0 0 2px #f97316); } to { filter: drop-shadow(0 0 12px #f97316); } }
    }
  </style>

  <script is:inline>
    function escapeHtml(t) {
      if (t == null) return '';
      return String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    const AVAILABLE_MODELS = [
      { id: "claude-3-7-sonnet", label: "🧠 Claude 3.7 Sonnet (Anthropic)" },
      { id: "gemini-2.0-flash", label: "⚡ Gemini 2.0 Flash (Google)" },
      { id: "codex-cli", label: "💻 Codex / GPT-4o (OpenAI)" },
      { id: "ollama/qwen3.8:27b-mlx", label: "🦙 Ollama: Qwen 3.8 27B (Mac Studio)" },
      { id: "ollama/kimi-k3:cloud", label: "☁️ Kimi K3 Cloud (131k)" },
      { id: "ollama/gemma4:26b-mlx", label: "💻 Gemma 4 26B (MLX)" }
    ];

    let currentPriority = null;
    let coreConfigVersion = null;
    let coreAgents = [];
    let openRouterModels = [];
    let backgroundWorkerBlueprint = null;

    function setTorchUnknown(message) {
      currentPriority = null;
      const flame = document.getElementById('hardware-flame');
      flame.classList.remove('is-owned');
      document.getElementById('torch-svg-title').textContent = 'Hardware-Fackel ohne bestätigten Besitz';
      document.getElementById('fackel-holder').textContent = message;
      document.getElementById('fackel-owner-reason').textContent = 'Ein aktueller Halternachweis fehlt.';
      document.getElementById('fackel-priority').textContent = 'Nicht geprüft';
      document.getElementById('fackel-compute').textContent = 'Nicht geprüft';
      document.getElementById('fackel-capacity').textContent = 'Nicht geprüft';
      document.getElementById('btn-toggle-fackel').disabled = true;
      document.getElementById('torch-observed-at').textContent = 'Nicht geprüft';
    }

    async function loadClusterCockpit() {
      try {
        const res = await fetch('/api/system/cluster-cockpit');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        const f = data.fackel;
        if (!f || !f.ownership || !f.capacity || !f.compute_lock) throw new Error('Statusantwort unvollständig');
        const owner = f.ownership;
        const ownerTime = Date.parse(owner.observed_at || '');
        const freshOwner = Number.isFinite(ownerTime) && Math.abs(Date.now() - ownerTime) <= 300000;
        const owned = owner.state === 'owned_by_this_system' && owner.holder_is_this_system === true && owner.flame === true && freshOwner;
        const flame = document.getElementById('hardware-flame');
        flame.classList.toggle('is-owned', owned);
        document.getElementById('torch-svg-title').textContent = owned ? 'Hardware-Fackel: BACH rechnet ohne gemeldete Compute-Konkurrenz' : 'Hardware-Fackel ohne bestätigten eigenen Besitz';
        document.getElementById('fackel-holder').textContent = owned ? String(owner.holder || 'Eigenes System') :
          owner.state === 'foreign' && freshOwner ? String(owner.holder || 'Fremdes System') :
          owner.state === 'competing_compute_reported' && freshOwner ? 'Rechenjobs melden Konkurrenz' :
          owner.state === 'idle' && freshOwner ? 'Derzeit kein lokaler BACH-Lauf' :
          owner.state === 'stale' ? 'Status veraltet' : 'Nicht geprüft';
        document.getElementById('fackel-owner-reason').textContent = owned ? 'Frischer Halternachweis für dieses System.' :
          owner.state === 'foreign' && freshOwner ? 'Ein anderes System hält die Fackel.' :
          owner.state === 'competing_compute_reported' && freshOwner ? 'Ein lokaler Compute-Lock meldet konkurrierende Rechenjobs; BACH-Besitz wird deshalb nicht behauptet.' :
          owner.state === 'idle' && freshOwner ? 'Der lokale Control-Dienst bestätigt, dass BACH gerade keine Inferenz ausführt.' :
          owner.state === 'stale' ? 'Der letzte Halternachweis ist zu alt.' : 'Der Hardware-Halteradapter fehlt oder liefert keinen Beleg.';
        currentPriority = ['compute', 'ollama'].includes(f.priority?.value) ? f.priority.value : null;
        document.getElementById('fackel-priority').textContent = currentPriority === 'compute' ? 'Compute' :
          currentPriority === 'ollama' ? 'Ollama' : 'Nicht geprüft';
        const button = document.getElementById('btn-toggle-fackel');
        button.disabled = !currentPriority;
        button.textContent = currentPriority === 'compute' ? 'Ollama-Vorrang setzen' :
          currentPriority === 'ollama' ? 'Compute-Vorrang setzen' : 'Vorrang nicht verfügbar';
        const lock = f.compute_lock;
        document.getElementById('fackel-compute').textContent = lock.state === 'reported_unverified' ?
          `Lockdatei meldet ${Number(lock.reported_jobs) || 0} Job(s); Identität nicht geprüft` :
          lock.state === 'none_reported' ? 'Frische Lockdatei meldet keine Jobs' :
          lock.state === 'stale' ? 'Status veraltet' : 'Nicht geprüft';
        const cap = f.capacity;
        document.getElementById('fackel-capacity').textContent = cap.state === 'measured' ?
          `${Number(cap.loaded_model_count) || 0} geladene Modelle · ${Number(cap.occupied_units) || 0} Einheiten · ${Number(cap.used_gib) || 0} GiB` :
          cap.state === 'partial' ? 'Ollama antwortet; Speicher nicht messbar' : 'Nicht geprüft';
        const observed = Date.parse(data.observed_at || '');
        document.getElementById('torch-observed-at').textContent = Number.isFinite(observed) ?
          'Geprüft ' + new Date(observed).toLocaleTimeString('de-DE', {hour:'2-digit', minute:'2-digit'}) : 'Nicht geprüft';
      } catch (_error) {
        setTorchUnknown('Nicht geprüft');
      }
    }

    async function toggleFackel() {
      if (!currentPriority) return;
      const desired = currentPriority === 'compute' ? 'ollama' : 'compute';
      const button = document.getElementById('btn-toggle-fackel');
      const feedback = document.getElementById('fackel-feedback');
      button.disabled = true;
      feedback.textContent = 'Vorrang wird gespeichert…';
      try {
        const res = await fetch('/api/system/fackel', {
          method: 'POST', headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({preference: desired})
        });
        const data = await res.json();
        if (!res.ok || data.ok !== true || data.preference !== desired || data.ownership_changed !== false) {
          throw new Error('Speicherung nicht bestätigt');
        }
        await loadClusterCockpit();
        if (currentPriority !== desired) throw new Error('Readback weicht ab');
        feedback.textContent = 'Vorrang gespeichert. Der Fackelbesitz wurde nicht verändert.';
      } catch (_error) {
        feedback.textContent = 'Vorrang konnte nicht bestätigt werden.';
        await loadClusterCockpit();
      }
    }

    function coreElement(tag, text, className = '') {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = String(text);
      return node;
    }

    function coreField(card, field, labelText, value, type = 'text', options = [], backend = '') {
      const label = coreElement('label', labelText);
      let input;
      if (type === 'select') {
        input = document.createElement('select');
        const choices = options.map(choice => typeof choice === 'string'
          ? {value: choice, label: choice}
          : {value: String(choice.value), label: String(choice.label ?? choice.value)});
        const currentValue = String(value ?? '');
        const values = choices.some(choice => choice.value === currentValue)
          ? choices
          : [{value: currentValue, label: currentValue + ' · bestehend, nicht geprüft'}, ...choices];
        for (const choice of values) {
          const option = document.createElement('option');
          option.value = choice.value;
          option.textContent = choice.label;
          input.append(option);
        }
        input.value = currentValue;
      } else {
        input = document.createElement('input');
        input.type = type;
        if (type === 'checkbox') input.checked = value === true;
        else input.value = value == null ? '' : String(value);
        if (type === 'number') { input.min = field === 'max_tool_rounds' ? '0' : '1'; input.max = field === 'max_tool_rounds' ? '100' : '1440'; }
        if (type === 'text') input.maxLength = field === 'icon' ? 8 : 120;
        if (field === 'model' && backend === 'openrouter') input.setAttribute('list', 'openrouter-free-models');
      }
      input.dataset.coreField = field;
      label.append(input);
      if (type === 'checkbox') label.className = 'core-check';
      card.append(label);
    }

    function renderCoreAgents(data, changedId = null) {
      const target = document.getElementById('core-agent-cards');
      const previousCards = new Map([...target.querySelectorAll('[data-core-agent-id]')]
        .map(card => [card.dataset.coreAgentId, card]));
      const previousAgents = new Map(coreAgents.map(agent => [agent.id, agent]));
      coreConfigVersion = data.configuration_version;
      coreAgents = data.agents;
      if (!changedId) target.replaceChildren();
      for (const agent of coreAgents) {
        const existing = changedId ? previousCards.get(agent.id) : null;
        if (changedId && agent.id !== changedId && existing) {
          const before = previousAgents.get(agent.id);
          const keys = ['name', 'icon', 'backend', 'model', 'mode', 'think',
            'max_tool_rounds', 'pause_after', 'pause_minutes', 'pause_basis'];
          if (before && keys.some(key => before[key] !== agent[key])) existing.dataset.coreStale = 'true';
          continue;
        }
        const card = coreElement('article', undefined, 'core-agent-card');
        card.dataset.coreAgentId = agent.id;
        card.append(coreElement('h3', `${agent.icon || '◇'} ${agent.name || agent.id}`));
        card.append(coreElement('small', `Technische ID: ${agent.id} · nicht löschbar`));
        const state = agent.configured_enabled === true ? 'Konfiguration aktiviert' :
          agent.configured_enabled === false ? 'Konfiguration deaktiviert' : 'Konfiguration vorhanden';
        card.append(coreElement('small', `${state} · Living: nicht geprüft · Running: nicht geprüft`));
        const fields = coreElement('div', undefined, 'core-fields');
        coreField(fields, 'name', 'Anzeigename', agent.name);
        coreField(fields, 'icon', 'Icon', agent.icon);
        coreField(fields, 'backend', 'Backend-ID', agent.backend, 'select', data.supported_backend_ids || []);
        coreField(fields, 'model', 'Modell-ID', agent.model, 'text', [], agent.backend);
        coreField(fields, 'mode', 'Modus', agent.mode, 'select', ['safe', 'full']);
        coreField(fields, 'think', 'Think', agent.think, 'checkbox');
        coreField(fields, 'max_tool_rounds', 'Maximale Runden', agent.max_tool_rounds, 'number');
        coreField(fields, 'pause_after', 'Pause nach Runden', agent.pause_after, 'number');
        coreField(fields, 'pause_minutes', 'Pausendauer (Min)', agent.pause_minutes, 'number');
        coreField(fields, 'pause_basis', 'Pause auslösen nach', agent.pause_basis, 'select', [
          {value: 'runs', label: 'abgeschlossenen Läufen'},
          {value: 'tasks', label: 'abgeschlossenen Aufgaben'}
        ]);
        const backendInput = fields.querySelector('[data-core-field="backend"]');
        const modelInput = fields.querySelector('[data-core-field="model"]');
        backendInput?.addEventListener('change', () => {
          if (backendInput.value === 'openrouter') modelInput?.setAttribute('list', 'openrouter-free-models');
          else modelInput?.removeAttribute('list');
        });
        card.append(fields);
        const actions = coreElement('div', undefined, 'core-actions');
        const save = coreElement('button', 'Einstellungen speichern', 'btn btn-sm btn-primary');
        save.type = 'button';
        save.addEventListener('click', () => saveCoreSlot(agent.id));
        actions.append(save);
        const reset = coreElement('button', 'Standards wiederherstellen', 'btn btn-sm');
        reset.type = 'button';
        reset.addEventListener('click', () => resetCoreSlot(agent.id));
        actions.append(reset);
        card.append(actions);
        if (existing) existing.replaceWith(card);
        else target.append(card);
      }
    }

    async function loadCoreSlots() {
      const target = document.getElementById('core-agent-cards');
      try {
        const res = await fetch('/api/system/core-agents');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        if (data.schema !== 'bach.core-system-agents.v1' || !Array.isArray(data.agents) ||
            data.agents.length !== 3 || typeof data.configuration_version !== 'string') throw new Error('System-Agentenantwort ungültig');
        renderCoreAgents(data);
      } catch (error) {
        coreConfigVersion = null;
        target.replaceChildren(coreElement('p', error.message.includes('401') ?
          'Geräteanmeldung erforderlich. Einstellungen sind derzeit nicht verfügbar.' :
          'System-Agentenkonfiguration nicht verfügbar. Die vorhandenen Profile bleiben erhalten.'));
      }
    }

    async function loadOpenRouterCatalog() {
      const credentialState = document.getElementById('openrouter-credential-state');
      const catalogState = document.getElementById('openrouter-catalog-state');
      const list = document.getElementById('openrouter-model-list');
      const datalist = document.getElementById('openrouter-free-models');
      try {
        const [statusResponse, modelsResponse] = await Promise.all([
          fetch('/api/system/openrouter/status'),
          fetch('/api/system/openrouter/models')
        ]);
        if (!statusResponse.ok || !modelsResponse.ok) throw new Error('Geräteanmeldung oder Dienst fehlt');
        const [status, catalog] = await Promise.all([statusResponse.json(), modelsResponse.json()]);
        if (status.provider !== 'openrouter' || catalog.provider !== 'openrouter' || !Array.isArray(catalog.models)) {
          throw new Error('OpenRouter-Antwort ungültig');
        }
        credentialState.textContent = status.credential?.configured === true
          ? 'Schlüssel konfiguriert · nicht live geprüft' : 'Schlüssel fehlt';
        credentialState.className = 'badge ' + (status.credential?.configured === true ? 'badge-accent' : '');
        openRouterModels = catalog.models.filter(item => item && item.free === true && typeof item.id === 'string');
        datalist.replaceChildren(...openRouterModels.map(item => {
          const option = document.createElement('option');
          option.value = item.id;
          return option;
        }));
        list.replaceChildren(...openRouterModels.map(item => {
          const code = document.createElement('code');
          code.textContent = item.id;
          code.setAttribute('role', 'listitem');
          code.title = item.name || item.id;
          return code;
        }));
        const staleNote = catalog.stale === true ? ' · Katalog gerade nicht erreichbar; nur sichere Auswahl angezeigt' : '';
        catalogState.textContent = `${openRouterModels.length} kostenlose Auswahl(en) · Quelle: ${catalog.source || 'unbekannt'}${staleNote}`;
      } catch (_error) {
        credentialState.textContent = 'Status nicht verfügbar';
        credentialState.className = 'badge';
        catalogState.textContent = 'OpenRouter-Katalog ist nicht verfügbar. Es wird kein Modell als verbunden oder kostenfrei bestätigt.';
        list.replaceChildren();
        datalist.replaceChildren();
        openRouterModels = [];
      }
    }

    async function loadBackgroundWorkerBlueprint() {
      const description = document.getElementById('worker-blueprint-description');
      const create = document.getElementById('worker-blueprint-create');
      try {
        const response = await fetch('/api/system/workers/blueprint');
        if (!response.ok) throw new Error('HTTP ' + response.status);
        const data = await response.json();
        if (data.schema !== 'bach.worker-blueprint.v1' || data.blueprint_id !== 'system:hintergrundworker' ||
            data.requires_explicit_start !== true || data.creation_state !== 'idle' || !data.defaults) {
          throw new Error('Vorlagenantwort nicht bestätigt');
        }
        backgroundWorkerBlueprint = data;
        const modeSelect = document.getElementById('worker-blueprint-sub-mode');
        if (!Array.isArray(data.sub_modes) || !data.sub_modes.length ||
            !Array.isArray(data.expert_roles) || !data.expert_roles.length) {
          throw new Error('Modus- oder Rollenliste fehlt');
        }
        modeSelect.replaceChildren(...data.sub_modes.map(item => new Option(item.label, item.id)));
        modeSelect.value = data.sub_mode || 'hintergrund_worker';
        modeSelect.disabled = false;
        const roleSelect = document.getElementById('worker-blueprint-role');
        roleSelect.replaceChildren(...data.expert_roles.map(item => new Option(item.label, item.id)));
        roleSelect.disabled = false;
        document.getElementById('worker-blueprint-name').value = data.name || 'BACH Hintergrundworker';
        document.getElementById('worker-blueprint-turns').value = data.defaults.max_tool_rounds ?? 25;
        document.getElementById('worker-blueprint-mode').value = data.defaults.mode === 'safe' ? 'safe' : 'full';
        document.getElementById('worker-blueprint-think').value = data.defaults.think === true ? 'true' : 'false';
        document.getElementById('worker-blueprint-pause-after').value = data.defaults.pause_after ?? 5;
        document.getElementById('worker-blueprint-pause-basis').value =
          data.defaults.pause_basis === 'tasks' ? 'tasks' : 'runs';
        document.getElementById('worker-blueprint-pause-minutes').value = data.defaults.pause_minutes ?? 1;
        document.getElementById('worker-blueprint-run-mode').value = data.defaults.type === 'once' ? 'once' : 'continuous';
        document.getElementById('worker-blueprint-ttl').value = data.defaults.ttl_minutes ?? 0;
        document.getElementById('worker-blueprint-backend').value = data.defaults.backend || 'ollama-cloud';
        document.getElementById('worker-blueprint-system-prompt').checked = data.defaults.include_system_prompt === true;
        document.getElementById('worker-blueprint-allow-tools').checked = data.defaults.allow_tools === true;
        updateWorkerRunModeFields();
        updateWorkerCreationModeFields();
        description.textContent = `${data.description} Konfigurationsquelle: ${data.defaults_source}. Profil wird idle angelegt; die Vorlage startet keinen Worker.`;
        create.disabled = false;
        await loadWorkerBlueprintModels();
      } catch (_error) {
        backgroundWorkerBlueprint = null;
        description.textContent = 'Die echte BACH-Rollenvorlage konnte nicht gelesen werden. Ohne bestätigte Vorlage ist das Anlegen gesperrt.';
        create.disabled = true;
        document.getElementById('worker-blueprint-model-status').textContent = 'Vorlage nicht verfügbar';
      }
    }

    async function loadWorkerBlueprintModels() {
      const backend = document.getElementById('worker-blueprint-backend').value;
      const modelSelect = document.getElementById('worker-blueprint-model');
      const status = document.getElementById('worker-blueprint-model-status');
      const create = document.getElementById('worker-blueprint-create');
      modelSelect.replaceChildren(new Option('Modellkatalog wird geladen…', ''));
      modelSelect.disabled = true;
      create.disabled = true;
      status.textContent = 'Aktueller Modellkatalog wird geprüft…';
      try {
        const response = await fetch('/api/system/workers/models?backend=' + encodeURIComponent(backend));
        if (!response.ok) throw new Error('HTTP ' + response.status);
        const data = await response.json();
        if (data.provider !== backend || !Array.isArray(data.models)) throw new Error('Modellantwort ungültig');
        const models = [...new Set(data.models.filter(model => typeof model === 'string' && model.trim()))];
        modelSelect.replaceChildren(...models.map(model => new Option(model, model)));
        modelSelect.disabled = models.length === 0;
        if (!models.length) modelSelect.replaceChildren(new Option('Keine Modelle gemeldet', ''));
        const credential = backend === 'openrouter'
          ? (data.credential_configured === true ? ' · Schlüssel konfiguriert, Verbindung nicht live geprüft' : ' · Schlüssel fehlt')
          : '';
        const stale = data.stale === true ? ' · Katalog veraltet; nur openrouter/free bleibt verfügbar' : '';
        status.textContent = `${models.length} Modell(e) aus ${data.source || 'unbekannter Quelle'}${credential}${stale}`;
        create.disabled = !backgroundWorkerBlueprint || models.length === 0;
      } catch (_error) {
        modelSelect.replaceChildren(new Option('Modellkatalog nicht verfügbar', ''));
        modelSelect.disabled = true;
        status.textContent = 'Keine aktuelle Modellliste; Workerprofil kann nicht angelegt werden.';
        create.disabled = true;
      }
    }

    async function createWorkerFromBlueprint(event) {
      event.preventDefault();
      if (!backgroundWorkerBlueprint) return;
      const button = document.getElementById('worker-blueprint-create');
      const status = document.getElementById('worker-blueprint-model-status');
      const ttlMinutes = Number(document.getElementById('worker-blueprint-ttl').value);
      const runMode = document.getElementById('worker-blueprint-run-mode').value;
      const backend = document.getElementById('worker-blueprint-backend').value;
      const model = document.getElementById('worker-blueprint-model').value;
      const defaults = backgroundWorkerBlueprint.defaults;
      const subMode = document.getElementById('worker-blueprint-sub-mode').value;
      const taskIdValue = document.getElementById('worker-blueprint-task-id').value.trim();
      const taskId = taskIdValue ? Number(taskIdValue) : null;
      const taskPrompt = document.getElementById('worker-blueprint-task-prompt').value.trim();
      const multiRole = document.getElementById('worker-blueprint-multi-role').checked;
      let expertModels = {};
      const expertModelsText = document.getElementById('worker-blueprint-expert-models').value.trim();
      if (expertModelsText) {
        try {
          expertModels = JSON.parse(expertModelsText);
          if (!expertModels || Array.isArray(expertModels) || typeof expertModels !== 'object') throw new Error();
        } catch (_error) {
          status.textContent = 'Experten-Modellzuordnung muss ein gültiges JSON-Objekt sein.';
          return;
        }
      }
      if (subMode === 'task_worker' && !taskId && !taskPrompt) {
        status.textContent = 'Taskworker benötigen eine Task-ID oder einen Zusatzauftrag.';
        return;
      }
      const payload = {
        name: document.getElementById('worker-blueprint-name').value.trim(),
        backend,
        model,
        sub_mode: subMode,
        role_id: subMode === 'expert_role' && !multiRole ? document.getElementById('worker-blueprint-role').value : '',
        multi_role: subMode === 'expert_role' && multiRole,
        max_experts: subMode === 'boss_routing' ? Number(document.getElementById('worker-blueprint-max-experts').value) : 3,
        expert_models: subMode === 'boss_routing' ? expertModels : {},
        task_id: taskId,
        max_tool_rounds: Number(document.getElementById('worker-blueprint-turns').value),
        mode: document.getElementById('worker-blueprint-mode').value,
        think: document.getElementById('worker-blueprint-think').value === 'true',
        pause_after: Number(document.getElementById('worker-blueprint-pause-after').value),
        pause_minutes: Number(document.getElementById('worker-blueprint-pause-minutes').value),
        pause_basis: document.getElementById('worker-blueprint-pause-basis').value,
        type: runMode,
        ttl_minutes: runMode === 'continuous' ? ttlMinutes : 0,
        task_prompt: taskPrompt,
        include_system_prompt: document.getElementById('worker-blueprint-system-prompt').checked,
        allow_tools: document.getElementById('worker-blueprint-allow-tools').checked
      };
      button.disabled = true;
      status.textContent = 'Workerprofil wird angelegt…';
      try {
        const response = await fetch('/api/system/workers', {
          method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload)
        });
        const data = await response.json();
        if (!response.ok || data.ok !== true || data.worker?.status !== 'idle') {
          throw new Error(data.detail || 'Idle-Readback des neuen Profils fehlt');
        }
        status.textContent = `Profil ${data.worker.name} als Living/idle bestätigt. Es wurde kein Modellaufruf gestartet.`;
        document.getElementById('worker-blueprint-task-prompt').value = '';
        document.getElementById('worker-blueprint-task-id').value = '';
        await loadBackgroundWorkers();
      } catch (error) {
        status.textContent = error.message || 'Profil konnte nicht bestätigt werden.';
      } finally {
        button.disabled = !backgroundWorkerBlueprint || document.getElementById('worker-blueprint-model').disabled;
      }
    }

    function updateWorkerCreationModeFields() {
      const subMode = document.getElementById('worker-blueprint-sub-mode').value;
      const expertFields = document.getElementById('worker-blueprint-expert-fields');
      const bossFields = document.getElementById('worker-blueprint-boss-fields');
      const roleSelect = document.getElementById('worker-blueprint-role');
      const multiRole = document.getElementById('worker-blueprint-multi-role');
      expertFields.hidden = subMode !== 'expert_role';
      bossFields.hidden = subMode !== 'boss_routing';
      roleSelect.required = subMode === 'expert_role' && !multiRole.checked;
      roleSelect.disabled = subMode !== 'expert_role' || multiRole.checked;
    }

    function updateWorkerRunModeFields() {
      const once = document.getElementById('worker-blueprint-run-mode').value === 'once';
      const ttl = document.getElementById('worker-blueprint-ttl');
      ttl.disabled = once;
      if (once) ttl.value = '0';
    }

    async function runWorkerAction(workerId, action, generation) {
      const summary = document.getElementById('worker-status-summary');
      const safeActions = new Set(['start', 'pause', 'stop', 'handoff']);
      if (!safeActions.has(action)) return;
      summary.textContent = action === 'start' ? 'Start wird angefordert…' :
        action === 'pause' ? 'Kooperative Pause wird angefordert…' :
        action === 'handoff' ? 'Kontextübergabe wird angefordert…' : 'Kooperativer Stopp wird angefordert…';
      try {
        const response = await fetch(`/api/system/workers/${encodeURIComponent(workerId)}/${action}`, {
          method: 'POST', headers: {'Content-Type': 'application/json'},
          body: JSON.stringify(action === 'handoff' ? {generation} : {})
        });
        const data = await response.json();
        if (!response.ok || data.ok !== true) throw new Error(data.detail || 'Aktion nicht bestätigt');
        if (action === 'start') {
          summary.textContent = `Start angenommen · Laufzeit-Readback: ${data.runtime_state || 'unbekannt'}`;
        } else if (action === 'handoff') {
          summary.textContent = data.receipt?.state === 'confirmed'
            ? 'Kontextübergabe durch die Laufzeit bestätigt.'
            : 'Kontextübergabe angefordert · Bestätigung folgt im Workerstatus.';
        } else {
          summary.textContent = action === 'pause' ? 'Pause durch Control API bestätigt.' : 'Stopp durch Control API bestätigt.';
        }
        await loadBackgroundWorkers();
      } catch (error) {
        summary.textContent = error.message || 'Workeraktion konnte nicht bestätigt werden.';
        await loadBackgroundWorkers();
      }
    }

    async function loadBackgroundWorkers() {
      const summary = document.getElementById('worker-status-summary');
      const container = document.getElementById('background-worker-list');
      try {
        const response = await fetch('/api/system/workers');
        if (!response.ok) throw new Error(response.status === 401
          ? 'Geräteanmeldung für den Workerstatus erforderlich.'
          : response.status === 503 ? 'Control API nicht erreichbar; Workerstatus derzeit unbekannt.'
          : 'Workerstatus konnte nicht geprüft werden (HTTP ' + response.status + ').');
        const data = await response.json();
        if (data.schema !== 'bach.workers.status.v1' || data.availability !== 'available' ||
            !Array.isArray(data.workers) || data.count !== data.workers.length) {
          throw new Error('Control API lieferte keinen gültigen Workerstatus.');
        }
        const labels = {
          running: 'Running · arbeitet', idle: 'Living · bereit', paused: 'Living · pausiert',
          stopping: 'Beendigung läuft', expired: 'Abgelaufen', stopped: 'Beendet', error: 'Fehler'
        };
        const counts = data.workers.reduce((result, worker) => {
          const state = typeof worker.status === 'string' ? worker.status : 'unknown';
          result[state] = (result[state] || 0) + 1;
          return result;
        }, {});
        summary.textContent = `${data.count} echte Workerprofile · ${counts.running || 0} Running · ${counts.idle || 0} Living/bereit · ${counts.paused || 0} pausiert · geprüft ${new Date(data.observed_at).toLocaleTimeString('de-DE', {hour:'2-digit', minute:'2-digit'})}`;
        container.replaceChildren(...data.workers.map(worker => {
          const state = String(worker.status || '').toLowerCase();
          const card = coreElement('article', undefined, 'background-worker-card');
          card.setAttribute('role', 'listitem');
          card.append(coreElement('h3', worker.name || worker.id));
          const stateLabel = state === 'paused' && worker.auto_paused === true
            ? 'Living · automatische Pause'
            : (labels[worker.status] || `Status: ${worker.status || 'unbekannt'}`);
          card.append(coreElement('span', stateLabel, 'worker-state'));
          card.append(coreElement('p', `${worker.backend || 'Backend unbekannt'} · ${worker.model || 'Modell unbekannt'}`));
          const detail = [];
          const modeLabels = {
            hintergrund_worker: 'Hintergrundworker',
            task_worker: 'Taskworker',
            boss_routing: 'Bossrouting',
            expert_role: 'Expertenrolle'
          };
          if (worker.sub_mode) detail.push(modeLabels[worker.sub_mode] || worker.sub_mode);
          if (worker.role_id) detail.push('Rolle: ' + worker.role_id);
          if (worker.task_id !== undefined) detail.push(`Task #${worker.task_id}`);
          if (worker.max_tool_rounds !== undefined) detail.push(`Limit: ${worker.max_tool_rounds} Toolrunden`);
          if (worker.pause_after !== undefined && worker.pause_basis) {
            const basisLabel = worker.pause_basis === 'tasks' ? 'Aufgaben' : 'Läufe';
            detail.push(`Pause nach ${worker.pause_after} ${basisLabel} · ${worker.pause_minutes ?? 0} Min`);
          }
          if (worker.expires_at) detail.push(`Lease bis ${worker.expires_at}`);
          if (detail.length) card.append(coreElement('small', detail.join(' · ')));
          const maxToolRounds = Number(worker.max_tool_rounds);
          const toolRound = Number(worker.tool_round);
          if (state === 'running' && Number.isInteger(toolRound) && toolRound >= 0 &&
              Number.isInteger(maxToolRounds) && maxToolRounds > 0) {
            card.append(coreElement('small', `Toolrunden: ${toolRound}/${maxToolRounds} · letzter Laufzeitbeleg`));
            const remaining = maxToolRounds - toolRound;
            if (remaining <= 2) {
              const warning = coreElement('p', remaining > 0
                ? `⚠️ Tool-Rundenlimit naht: noch ${remaining} Runde${remaining === 1 ? '' : 'n'}.`
                : '⚠️ Tool-Rundenlimit erreicht; die Fortsetzung wird vom Workerprozess verwaltet.',
              'worker-turn-warning');
              warning.setAttribute('role', 'status');
              warning.setAttribute('aria-live', 'polite');
              card.append(warning);
            }
          }
          if (worker.current_activity) card.append(coreElement('p', worker.current_activity));
          if (worker.handoff_receipt) {
            const handoffLabels = {pending: 'angefordert', running: 'wird verarbeitet',
              confirmed: 'bestätigt', error: 'fehlgeschlagen', cancelled: 'abgebrochen'};
            card.append(coreElement('p', 'Kontextübergabe: ' +
              (handoffLabels[worker.handoff_receipt.state] || 'unbekannt')));
          }
          const actions = coreElement('div', undefined, 'core-actions');
          if (['idle', 'paused', 'completed', 'error'].includes(state) && worker.auto_paused !== true) {
            const start = coreElement('button', state === 'paused' ? '▶ Fortsetzen' : '▶ Start', 'btn btn-sm btn-primary');
            start.type = 'button';
            start.addEventListener('click', () => runWorkerAction(worker.id, 'start'));
            actions.append(start);
          }
          if (state === 'running' || (state === 'paused' && worker.auto_paused === true)) {
            if (state === 'running') {
              if (typeof worker.generation === 'string' &&
                  !['pending', 'running'].includes(worker.handoff_receipt?.state)) {
                const handoff = coreElement('button', 'Kontext übergeben', 'btn btn-sm');
                handoff.type = 'button';
                handoff.addEventListener('click', () => runWorkerAction(worker.id, 'handoff', worker.generation));
                actions.append(handoff);
              }
              const pause = coreElement('button', '⏸ Pause', 'btn btn-sm');
              pause.type = 'button';
              pause.addEventListener('click', () => runWorkerAction(worker.id, 'pause'));
              actions.append(pause);
            }
            const stop = coreElement('button', '⏹ Stop', 'btn btn-sm');
            stop.type = 'button';
            stop.addEventListener('click', () => runWorkerAction(worker.id, 'stop'));
            actions.append(stop);
          }
          if (actions.childElementCount) card.append(actions);
          return card;
        }));
        if (!data.workers.length) container.append(coreElement('p', 'Die Control API meldet derzeit keine Workerprofile.'));
      } catch (error) {
        summary.textContent = error.message || 'Workerstatus nicht verfügbar.';
        container.replaceChildren();
      }
    }

    function showCoreSaveFailure(message) {
      const feedback = document.getElementById('core-agent-feedback');
      const reload = coreElement('button', 'Zustand neu laden (verwirft Eingaben)', 'btn btn-sm');
      reload.type = 'button';
      reload.addEventListener('click', () => loadCoreSlots());
      feedback.replaceChildren(coreElement('span', message + ' Eingaben bleiben bis zum Neuladen erhalten. '), reload);
    }

    async function saveCoreSlot(slotId) {
      const card = [...document.querySelectorAll('[data-core-agent-id]')].find(node => node.dataset.coreAgentId === slotId);
      if (!card || !coreConfigVersion) return;
      if (card.dataset.coreStale === 'true') {
        showCoreSaveFailure('Serverkonfiguration dieses Agenten hat sich verändert.');
        return;
      }
      const original = coreAgents.find(item => item.id === slotId);
      if (!original) return;
      const changes = {};
      for (const input of card.querySelectorAll('[data-core-field]')) {
        const field = input.dataset.coreField;
        const previous = original[field];
        if (input.type === 'checkbox') {
          if (previous == null && !input.checked) continue;
          if (input.checked !== previous) changes[field] = input.checked;
        } else if (input.type === 'number') {
          if (input.value.trim() === '' && previous == null) continue;
          const current = input.value.trim() === '' ? null : Number(input.value);
          if (current !== previous) changes[field] = current;
        } else {
          const current = input.value.trim();
          if (current !== String(previous ?? '').trim()) changes[field] = current;
        }
      }
      const feedback = document.getElementById('core-agent-feedback');
      if (Object.keys(changes).length === 0) {
        feedback.textContent = 'Keine Änderungen zum Speichern.';
        return;
      }
      feedback.textContent = 'Einstellungen werden gespeichert…';
      try {
        const res = await fetch('/api/system/core-agents/' + encodeURIComponent(slotId), {
          method: 'PUT', headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({configuration_version: coreConfigVersion, changes})
        });
        const data = await res.json();
        const saved = data.agents?.find(item => item.id === slotId);
        if (!res.ok || data.ack?.configuration_saved !== true || data.ack?.worker_started !== false ||
            !saved || Object.entries(changes).some(([key, value]) => saved[key] !== value)) throw new Error('Speicherung nicht bestätigt');
        renderCoreAgents(data, slotId);
        feedback.textContent = 'Konfiguration gespeichert. Andere Eingaben bleiben erhalten. Kein Agent wurde dadurch gestartet.';
      } catch (_error) {
        showCoreSaveFailure('Speicherung nicht bestätigt. Bei einem Versionskonflikt müssen Sie vor erneutem Speichern den Zustand laden.');
      }
    }

    async function resetCoreSlot(slotId) {
      if (!coreConfigVersion || !window.confirm('Nur die editierbaren Einstellungen dieses System-Agenten zurücksetzen?')) return;
      const card = [...document.querySelectorAll('[data-core-agent-id]')].find(node => node.dataset.coreAgentId === slotId);
      if (card?.dataset.coreStale === 'true') {
        showCoreSaveFailure('Serverkonfiguration dieses Agenten hat sich verändert.');
        return;
      }
      const feedback = document.getElementById('core-agent-feedback');
      feedback.textContent = 'Standards werden wiederhergestellt…';
      try {
        const res = await fetch('/api/system/core-agents/' + encodeURIComponent(slotId) + '/reset', {
          method: 'POST', headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({configuration_version: coreConfigVersion})
        });
        const data = await res.json();
        if (!res.ok || data.ack?.configuration_saved !== true || data.ack?.worker_started !== false ||
            !data.agents?.some(item => item.id === slotId)) throw new Error('Reset nicht bestätigt');
        renderCoreAgents(data, slotId);
        feedback.textContent = 'Einstellungen zurückgesetzt. Andere Eingaben, Aufgaben, Sitzungen und Geräte bleiben erhalten.';
      } catch (_error) {
        showCoreSaveFailure('Reset nicht bestätigt. Bitte Serverzustand prüfen.');
      }
    }

    // ── 2. TEAMS BESEELEn ──
    async function loadTeamsBeseelen() {
      const container = document.getElementById('teams-beseelen-container');
      try {
        const res = await fetch('/api/agenten/teams');
        const data = await res.json();
        const teams = data.teams || [];

        if (teams.length === 0) {
          container.innerHTML = '<p style="color:var(--text-muted);font-size:0.85rem;">Keine Teams vorhanden. Erstelle eines in Tab 2 der Fabrik!</p>';
          return;
        }

        container.innerHTML = teams.map(t => {
          const members = (t.member_agents || '').split(',').map(m => m.trim()).filter(Boolean);
          const modelsMap = t.member_models || {};

          return `
            <div style="background:var(--bg-dark);border:1px solid var(--border);border-radius:var(--radius-sm);padding:1rem;">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;">
                <strong style="color:var(--text);font-size:0.95rem;">${escapeHtml(t.name)}</strong>
                <span class="badge badge-accent">${escapeHtml(t.strategy)}</span>
              </div>
              <p style="font-size:0.78rem;color:var(--text-muted);margin:0 0 0.75rem 0;">${escapeHtml(t.description || '')}</p>

              <div style="display:flex;flex-direction:column;gap:0.5rem;background:var(--bg-card);padding:0.75rem;border-radius:4px;border:1px solid var(--border);">
                <div style="font-size:0.75rem;color:var(--accent);font-weight:600;margin-bottom:0.25rem;">Mitglieder & Modell-Zuweisung (Beseelung):</div>
                ${members.map(m => {
                  const curMod = modelsMap[m] || 'ollama/qwen3.8:27b-mlx';
                  return `
                    <div style="display:flex;justify-content:space-between;align-items:center;gap:0.5rem;">
                      <span style="font-size:0.8rem;color:var(--text);font-weight:500;">🤖 ${escapeHtml(m)}</span>
                      <select class="team-member-model-select" data-team="${t.id}" data-member="${escapeHtml(m)}" style="padding:0.25rem 0.5rem;font-size:0.75rem;background:var(--bg-dark);color:var(--text);border:1px solid var(--border);border-radius:4px;">
                        ${AVAILABLE_MODELS.map(mod => `<option value="${mod.id}" ${mod.id === curMod ? 'selected' : ''}>${mod.label}</option>`).join('')}
                      </select>
                    </div>
                  `;
                }).join('')}
              </div>

              <div style="display:flex;justify-content:flex-end;margin-top:0.75rem;">
                <button class="btn btn-sm btn-primary" onclick="saveTeamBeseelung(${t.id})">
                  ✨ Team-Beseelung speichern
                </button>
              </div>
            </div>
          `;
        }).join('');
      } catch (e) {
        container.innerHTML = `<p style="color:var(--error);font-size:0.8rem;">Fehler: ${e.message}</p>`;
      }
    }

    async function saveTeamBeseelung(teamId) {
      const selects = document.querySelectorAll(`.team-member-model-select[data-team="${teamId}"]`);
      const member_models = {};
      selects.forEach(sel => {
        const mem = sel.getAttribute('data-member');
        member_models[mem] = sel.value;
      });

      try {
        const res = await fetch(`/api/agenten/teams/${teamId}/beseelen`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ member_models })
        });
        if (res.ok) {
          alert('Team-Beseelung erfolgreich gespeichert!');
          loadTeamsBeseelen();
        } else {
          alert('Fehler beim Beseelen des Teams.');
        }
      } catch (e) {
        alert('Netzwerkfehler: ' + e.message);
      }
    }

    // ── 3. AGENTEN-STAFFELN (MARBLERUN) BESEELEN ──
    async function loadStaffelnBeseelen() {
      const container = document.getElementById('staffel-beseelen-container');
      try {
        const res = await fetch('/api/marblerun/chains');
        const data = await res.json();
        const chains = data.chains || [];

        if (chains.length === 0) {
          container.innerHTML = '<p style="color:var(--text-muted);font-size:0.85rem;">Keine Ketten vorhanden. Erstelle eine in MarbleRun!</p>';
          return;
        }

        container.innerHTML = chains.map(c => {
          let steps = [];
          try { steps = typeof c.steps_json === 'string' ? JSON.parse(c.steps_json) : (c.steps_json || []); } catch(e) {}

          return `
            <div style="background:var(--bg-dark);border:1px solid var(--border);border-radius:var(--radius-sm);padding:1rem;">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;">
                <strong style="color:var(--text);font-size:0.95rem;">⛓️ ${escapeHtml(c.title || c.name)}</strong>
                <span class="badge badge-accent">${steps.length} Stationen</span>
              </div>

              <div style="display:flex;flex-direction:column;gap:0.5rem;background:var(--bg-card);padding:0.75rem;border-radius:4px;border:1px solid var(--border);">
                ${steps.map(s => {
                  const curMod = s.model || 'claude-3-7-sonnet';
                  return `
                    <div style="display:flex;justify-content:space-between;align-items:center;gap:0.5rem;">
                      <span style="font-size:0.78rem;color:var(--text);">Station ${s.step}: <strong>${escapeHtml(s.action)}</strong> (${escapeHtml(s.agent || 'Agent')})</span>
                      <select class="chain-step-model-select" data-chain="${c.id}" data-step="${s.step}" style="padding:0.25rem 0.5rem;font-size:0.75rem;background:var(--bg-dark);color:var(--text);border:1px solid var(--border);border-radius:4px;">
                        ${AVAILABLE_MODELS.map(mod => `<option value="${mod.id}" ${mod.id === curMod ? 'selected' : ''}>${mod.label}</option>`).join('')}
                      </select>
                    </div>
                  `;
                }).join('')}
              </div>

              <div style="display:flex;justify-content:flex-end;margin-top:0.75rem;">
                <button class="btn btn-sm btn-primary" onclick="saveStaffelBeseelung(${c.id})">
                  ✨ Staffel-Beseelung speichern
                </button>
              </div>
            </div>
          `;
        }).join('');
      } catch (e) {
        container.innerHTML = `<p style="color:var(--error);font-size:0.8rem;">Fehler: ${e.message}</p>`;
      }
    }

    async function saveStaffelBeseelung(chainId) {
      const selects = document.querySelectorAll(`.chain-step-model-select[data-chain="${chainId}"]`);
      const step_models = {};
      selects.forEach(sel => {
        const step = sel.getAttribute('data-step');
        step_models[step] = sel.value;
      });

      try {
        const res = await fetch(`/api/marblerun/chains/${chainId}/beseelen`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ step_models })
        });
        if (res.ok) {
          alert('Staffel-Beseelung erfolgreich gespeichert!');
          loadStaffelnBeseelen();
        } else {
          alert('Fehler beim Beseelen der Staffel.');
        }
      } catch (e) {
        alert('Netzwerkfehler: ' + e.message);
      }
    }

    // ── 5. LIVE AKTIVITÄT ──
    async function refreshActivity() {
      const tbody = document.getElementById('activity-tbody');
      try {
        const res = await fetch('/api/tasks?limit=6');
        const data = await res.json();
        const tasks = data.tasks || [];

        if (tasks.length === 0) {
          tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--text-muted);">Keine aktuellen Tasks</td></tr>';
          return;
        }

        tbody.innerHTML = tasks.slice(0, 6).map(t => {
          const timeStr = t.created_at ? t.created_at.slice(11, 16) : '--:--';
          const akteur = t.assigned_to || t.assigned_agent || 'Operator';
          const model = t.required_model || 'Nicht angegeben';
          const st = t.status || 'todo';
          const badgeClass = st === 'completed' || st === 'done' ? 'badge-success' : (st === 'running' ? 'badge-accent' : 'badge-warning');

          return `
            <tr>
              <td style="color:var(--text-muted);font-family:monospace;font-size:0.8rem;">${escapeHtml(timeStr)}</td>
              <td><strong>${escapeHtml(akteur)}</strong></td>
              <td>${escapeHtml(t.title || 'Task')}</td>
              <td><span style="font-family:monospace;font-size:0.75rem;color:var(--accent);">${escapeHtml(model)}</span></td>
              <td><span class="badge ${badgeClass}">${escapeHtml(st)}</span></td>
            </tr>
          `;
        }).join('');
      } catch (e) {
        tbody.innerHTML = `<tr><td colspan="5" style="color:var(--error);text-align:center;">Aktivitäten konnten nicht geladen werden.</td></tr>`;
      }
    }

    async function loadTrustedProfiles() {
      const container = document.getElementById('trusted-profile-list');
      try {
        const response = await fetch('/api/agents');
        if (!response.ok) throw new Error('HTTP ' + response.status);
        const data = await response.json();
        if (data.success !== true || !Array.isArray(data.agents)) throw new Error('Profilantwort ungültig');
        const profiles = data.agents.filter(agent => agent.profile_chat_ready === true &&
          Number.isSafeInteger(Number(agent.id)) && Number(agent.id) > 0);
        let runtimeById = new Map();
        let runtimeNote = 'Geräteanmeldung für Prozessstatus erforderlich';
        try {
          const runtimeResponse = await fetch('/api/agents/runtime');
          if (runtimeResponse.ok) {
            const runtimeData = await runtimeResponse.json();
            if (runtimeData.success === true && Array.isArray(runtimeData.agents)) {
              runtimeById = new Map(runtimeData.agents.map(item => [Number(item.agent_id), item.process_state]));
              runtimeNote = 'Prozessstatus nicht prüfbar';
            }
          }
        } catch (_error) {
          runtimeNote = 'Prozessstatus nicht prüfbar';
        }
        const stateLabels = { running: 'Prozess läuft', not_started: 'Kein Prozess bestätigt',
          ended: 'Prozess beendet', unverified: 'Identität nicht bestätigt',
          mismatch: 'Prozessabweichung', unavailable: 'Prozessstatus nicht prüfbar' };
        container.innerHTML = profiles.length
          ? profiles.map(agent => `<span><a class="btn" href="/chat?agent_id=${Number(agent.id)}">💬 ${escapeHtml(agent.display_name || agent.name)}</a><small style="display:block;margin-top:0.3rem;color:var(--text-muted);">${stateLabels[runtimeById.get(Number(agent.id))] || runtimeNote}</small></span>`).join('')
          : '<span style="color:var(--text-muted);font-size:0.8rem;">Keine verifizierten Chatprofile verfügbar.</span>';
      } catch (error) {
        container.textContent = 'Profile können derzeit nicht geprüft werden: ' + error.message;
      }
    }

    async function refreshAll(interactive = false) {
      await Promise.all([
        loadTrustedProfiles(),
        loadClusterCockpit(),
        loadTeamsBeseelen(),
        loadStaffelnBeseelen(),
        refreshActivity(),
        loadCoreSlots(),
        loadOpenRouterCatalog(),
        loadBackgroundWorkers()
      ]);
      if (interactive) {
        // Subtle confirmation
        console.log("Living & Running Daten aktualisiert");
      }
    }

    window.addEventListener('DOMContentLoaded', () => {
      document.getElementById('worker-blueprint-backend')?.addEventListener('change', loadWorkerBlueprintModels);
      document.getElementById('worker-blueprint-sub-mode')?.addEventListener('change', updateWorkerCreationModeFields);
      document.getElementById('worker-blueprint-run-mode')?.addEventListener('change', updateWorkerRunModeFields);
      document.getElementById('worker-blueprint-multi-role')?.addEventListener('change', updateWorkerCreationModeFields);
      document.getElementById('worker-blueprint-form')?.addEventListener('submit', createWorkerFromBlueprint);
      loadBackgroundWorkerBlueprint();
      refreshAll();
      // Observe hardware and task activity without resetting editable forms.
      setInterval(loadClusterCockpit, 15000);
      setInterval(refreshActivity, 4000);
      setInterval(loadBackgroundWorkers, 5000);
    });
  </script>
</BachLayout>
