          container.innerHTML = '<p style="color:var(--text-muted);font-size:0.85rem;">Keine Ketten vorhanden. Erstelle eine im Ketten-Editor!</p>';
          return;
        }

        container.innerHTML = chains.map(c => {
          let steps = [];
          try { steps = typeof c.steps_json === 'string' ? JSON.parse(c.steps_json) : (c.steps || []); } catch(e) {}

          return `
            <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm);padding:0.85rem;">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.4rem;">
                <strong style="color:var(--text);font-size:0.95rem;">⛓️ ${escapeHtml(c.title || c.name)}</strong>
                <span class="badge badge-accent" style="font-size:0.7rem;">${steps.length} Stationen</span>
              </div>
              <p style="font-size:0.75rem;color:var(--text-muted);margin:0 0 0.6rem 0;">${escapeHtml(c.description || '')}</p>

              <div style="display:flex;flex-direction:column;gap:0.4rem;background:var(--bg-dark);padding:0.6rem;border-radius:4px;border:1px solid var(--border);margin-bottom:0.6rem;">
                ${steps.map(s => {
                  const curMod = s.model || 'claude-3-7-sonnet';
                  return `
                    <div style="display:flex;justify-content:space-between;align-items:center;gap:0.4rem;">
                      <span style="font-size:0.75rem;color:var(--text);">St. ${s.step}: <strong>${escapeHtml(s.action)}</strong></span>
                      <select class="chain-step-model-select" data-chain="${c.id}" data-step="${s.step}" style="padding:0.2rem 0.4rem;font-size:0.72rem;background:var(--bg-card);color:var(--text);border:1px solid var(--border);border-radius:4px;">
                        ${AVAILABLE_MODELS.map(mod => `<option value="${mod.id}" ${mod.id === curMod ? 'selected' : ''}>${mod.label}</option>`).join('')}
                      </select>
                    </div>
                  `;
