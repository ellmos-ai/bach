      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .balance-header {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
      margin-bottom: 0.35rem;
    }
    .progress-bar {
      height: 8px;
      background: rgba(255,255,255,0.06);
      border-radius: 4px;
      overflow: hidden;
    }
    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--accent) 0%, var(--success) 100%);
      border-radius: 4px;
    }
  </style>

  <script is:inline>
    function escapeHtml(t) {
      if (t == null) return '';
      return String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function lifeApiFetch(path, options = {}) {
      let token = '';
      try { token = localStorage.getItem('bach_device_token') || ''; } catch (_) {}
      const headers = new Headers(options.headers || {});
      if (token) headers.set('Authorization', `Bearer ${token}`);
      return fetch(path, { ...options, headers });
    }

    function localDateKey(date) {
      return `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`;
    }

    function visibleCalendarEvents() {
      const allowed = new Set();
      for (const source of ['user', 'system', 'unknown']) {
        if (document.getElementById(`cal-source-${source}`)?.checked) allowed.add(source);
      }
      return _loadedEvents.filter(event => allowed.has(['user','system'].includes(event.origin) ? event.origin : 'unknown'));
    }

    // ── CALENDAR STATE & 4-VIEW RENDERER ──
    let _calView = 'month'; // 'day' | 'week' | 'month' | 'year'
    let _currentDate = new Date();
    let _loadedEvents = [];

    const MONTH_NAMES = ["Januar", "Februar", "März", "April", "Mai", "Juni", "Juli", "August", "September", "Oktober", "November", "Dezember"];
    const WEEKDAY_NAMES = ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"];

    async function loadCalendarEvents() {
      try {
        const dateStr = localDateKey(_currentDate);
        const status = document.getElementById('calendar-load-status');
        status.textContent = 'Lade Termine …';
        const res = await lifeApiFetch(`/api/calendar/events?view=${_calView}&date=${dateStr}&include_routines=false`);
        if (res.ok) {
          const data = await res.json();
          _loadedEvents = Array.isArray(data.events) ? data.events : [];
          status.textContent = _loadedEvents.length ? '' : 'Für diesen Zeitraum sind keine Termine eingetragen.';
        } else {
          _loadedEvents = [];
          status.textContent = res.status === 401 || res.status === 403
            ? 'Termine konnten nicht geladen werden. Bitte über die Geräteanmeldung anmelden.'
            : `Termine konnten nicht geladen werden (HTTP ${res.status}).`;
        }
      } catch (e) {
        _loadedEvents = [];
        document.getElementById('calendar-load-status').textContent = 'Termine konnten wegen eines Netzwerkfehlers nicht geladen werden.';
      }
      renderActiveCalendarView();
    }

    function renderActiveCalendarView() {
      updatePeriodHeading();
      if (_calView === 'day') renderDayView();
      else if (_calView === 'week') renderWeekView();
      else if (_calView === 'month') renderMonthView();
      else if (_calView === 'year') renderYearView();
    }

    function updatePeriodHeading() {
      const heading = document.getElementById('cal-period-heading');
      if (!heading) return;
      const y = _currentDate.getFullYear();
      const m = MONTH_NAMES[_currentDate.getMonth()];
      const d = _currentDate.getDate();

      if (_calView === 'day') {
        const wd = WEEKDAY_NAMES[(_currentDate.getDay() + 6) % 7];
        heading.textContent = `${wd}, ${d}. ${m} ${y}`;
      } else if (_calView === 'week') {
        const monday = getMonday(_currentDate);
        const sunday = new Date(monday);
        sunday.setDate(monday.getDate() + 6);
        heading.textContent = `KW ${getWeekNumber(_currentDate)} (${monday.getDate()}.${monday.getMonth()+1}. - ${sunday.getDate()}.${sunday.getMonth()+1}.${y})`;
      } else if (_calView === 'month') {
        heading.textContent = `${m} ${y}`;
      } else if (_calView === 'year') {
        heading.textContent = `Jahr ${y}`;
      }
    }

    function navigateCalendar(delta) {
      if (delta === 0) {
        _currentDate = new Date();
      } else {
        if (_calView === 'day') {
          _currentDate.setDate(_currentDate.getDate() + delta);
        } else if (_calView === 'week') {
          _currentDate.setDate(_currentDate.getDate() + (delta * 7));
        } else if (_calView === 'month') {
          _currentDate = new Date(_currentDate.getFullYear(), _currentDate.getMonth() + delta, 1);
        } else if (_calView === 'year') {
          _currentDate = new Date(_currentDate.getFullYear() + delta, _currentDate.getMonth(), 1);
        }
      }
      loadCalendarEvents();
    }

    // ── 1. TAGESANSICHT ──
    function renderDayView() {
      const container = document.getElementById('day-timeline-slots');
      const title = document.getElementById('day-view-date-title');
      const badge = document.getElementById('day-event-count');
      if (!container) return;

      const y = _currentDate.getFullYear();
      const m = String(_currentDate.getMonth() + 1).padStart(2, '0');
      const d = String(_currentDate.getDate()).padStart(2, '0');
      const datePrefix = `${y}-${m}-${d}`;

      const dayEvents = visibleCalendarEvents().filter(e => (e.start_datetime || '').startsWith(datePrefix));
      badge.textContent = `${dayEvents.length} Termine`;
      title.textContent = `${d}. ${MONTH_NAMES[_currentDate.getMonth()]} ${y}`;

      let html = '';
      for (let hour = 0; hour <= 23; hour++) {
        const hourStr = String(hour).padStart(2, '0') + ':00';
        const slotEvents = dayEvents.filter(e => {
          const t = (e.start_datetime || '').slice(11, 16);
          const h = parseInt(t.split(':')[0] || '-1', 10);
          return h === hour;
        });

        html += `
          <div class="day-slot ${datePrefix === localDateKey(new Date()) && hour === new Date().getHours() ? 'current-hour' : ''}">
            <div class="day-slot-time">${hourStr}</div>
            <div class="day-slot-content">
              ${slotEvents.map(e => `
                <div style="background:var(--bg-card);border:1px solid var(--accent);border-left:4px solid var(--accent);padding:0.4rem 0.75rem;border-radius:4px;font-size:0.8rem;">
                  <strong style="color:var(--text);">${escapeHtml(e.title)}</strong>
                  ${e.location ? `<span style="color:var(--text-muted);font-size:0.75rem;"> @ ${escapeHtml(e.location)}</span>` : ''}
                  <span class="badge badge-accent" style="margin-left:0.5rem;font-size:0.65rem;">${escapeHtml(e.origin === 'user' ? 'Nutzertermin' : e.origin === 'system' ? 'Systemtermin' : 'Herkunft unbekannt')}</span>
                </div>
              `).join('')}
            </div>
          </div>
        `;
      }
      container.innerHTML = html;
    }

    // ── 2. WOCHENANSICHT ──
    function renderWeekView() {
      const grid = document.getElementById('week-columns-grid');
      if (!grid) return;
      const monday = getMonday(_currentDate);
      const todayStr = localDateKey(new Date());
      const days = [];
      for (let i = 0; i < 7; i++) {
        const cur = new Date(monday);
        cur.setDate(monday.getDate() + i);
        days.push({ date: localDateKey(cur), label: `${WEEKDAY_NAMES[i]} ${cur.getDate()}.${cur.getMonth()+1}.` });
      }
      let html = '<div class="week-time" aria-hidden="true"></div>';
      html += days.map(d => `<div class="week-day-heading ${d.date === todayStr ? 'today' : ''}">${d.label}</div>`).join('');
      for (let hour = 0; hour < 24; hour++) {
        html += `<div class="week-time">${String(hour).padStart(2, '0')}:00</div>`;
        for (const day of days) {
          const events = visibleCalendarEvents().filter(e => (e.start_datetime || '').startsWith(day.date)
            && Number.parseInt((e.start_datetime || '').slice(11,13),10) === hour);
          html += `<div class="week-hour-cell ${day.date === todayStr ? 'today' : ''} ${day.date === todayStr && hour === new Date().getHours() ? 'current-hour' : ''}">
            ${events.map(e => `<div class="cal-event-chip chip-termin" title="${escapeHtml(e.title)}"><strong>${escapeHtml((e.start_datetime || '').slice(11,16))}</strong> ${escapeHtml(e.title)}</div>`).join('')}
          </div>`;
        }
      }
      grid.innerHTML = html;
    }

    // ── 3. MONATSANSICHT ──
    function renderMonthView() {
      const grid = document.getElementById('month-days-grid');
      if (!grid) return;

      const year = _currentDate.getFullYear();
      const month = _currentDate.getMonth();
      const firstDay = new Date(year, month, 1);
      const lastDay = new Date(year, month + 1, 0);

      // Monday offset (0=Mo, 6=So)
      const startOffset = (firstDay.getDay() + 6) % 7;
      const totalDays = lastDay.getDate();

      const todayStr = localDateKey(new Date());
      let html = '';

      // Leading empty cells
      for (let i = 0; i < startOffset; i++) {
        html += `<div class="month-day-cell other-month"></div>`;
      }

      for (let day = 1; day <= totalDays; day++) {
        const dStr = String(day).padStart(2, '0');
        const mStr = String(month + 1).padStart(2, '0');
        const iso = `${year}-${mStr}-${dStr}`;
        const isToday = iso === todayStr;

        const dayEvents = visibleCalendarEvents().filter(e => (e.start_datetime || '').startsWith(iso));

        html += `
          <button type="button" class="month-day-cell ${isToday ? 'today' : ''}" data-date="${iso}" aria-label="${day}. ${MONTH_NAMES[month]} ${year}, ${dayEvents.length} Termine">
            <div class="month-day-num" style="${isToday ? 'color:var(--accent);font-weight:800;' : ''}">${day}</div>
            <div style="flex:1;overflow-y:auto;">
              ${dayEvents.slice(0, 3).map(e => {
                const chipClass = e.is_routine ? 'chip-routine' : (e.event_type === 'fokusblock' ? 'chip-fokus' : 'chip-termin');
                return `<div class="cal-event-chip ${chipClass}">${escapeHtml(e.title)}</div>`;
              }).join('')}
              ${dayEvents.length > 3 ? `<div style="font-size:0.65rem;color:var(--text-muted);text-align:right;">+${dayEvents.length - 3} weitere</div>` : ''}
            </div>
          </button>
        `;
      }
      for (let i = startOffset + totalDays; i < 42; i++) {
        html += '<div class="month-day-cell other-month" aria-hidden="true"></div>';
      }
      grid.innerHTML = html;
      grid.querySelectorAll('button[data-date]').forEach(button => button.addEventListener('click', () => selectDayFromMonth(button.dataset.date)));
    }

    function selectDayFromMonth(iso) {
      const [year, month, day] = iso.split('-').map(Number);
      _currentDate = new Date(year, month - 1, day);
      switchCalendarView('day');
    }

    // ── 4. JAHRESÜBERBLICK ──
    function renderYearView() {
      const container = document.getElementById('year-quarters-container');
      const yearTitle = document.getElementById('year-title');
      if (!container) return;
      const year = _currentDate.getFullYear();
      if (yearTitle) yearTitle.textContent = `Jahresüberblick ${year}`;

      let html = '';
      for (let m = 0; m < 12; m++) {
        const mName = MONTH_NAMES[m];
        const daysInMonth = new Date(year, m + 1, 0).getDate();
        const mPrefix = `${year}-${String(m+1).padStart(2, '0')}`;
        const mEvents = visibleCalendarEvents().filter(e => (e.start_datetime || '').startsWith(mPrefix));
        const startOffset = (new Date(year, m, 1).getDay() + 6) % 7;

        html += `
          <div class="mini-month-card">
            <div class="mini-month-title">
              <span>${mName}</span>
              <span class="badge ${mEvents.length ? 'badge-accent' : 'badge-secondary'}" style="font-size:0.65rem;">${mEvents.length} Termine</span>
            </div>
            <div class="mini-month-grid">
              ${Array.from({length: startOffset}, () => '<span class="mini-day empty" aria-hidden="true"></span>').join('')}
              ${Array.from({length: daysInMonth}, (_, i) => {
                const day = i + 1;
                const dStr = String(day).padStart(2, '0');
                const iso = `${mPrefix}-${dStr}`;
                const hasEv = mEvents.some(e => (e.start_datetime || '').startsWith(iso));
                 return `<div class="mini-day ${hasEv ? 'has-event' : ''}" title="${day}. ${mName}">${day}</div>`;
              }).join('')}
            </div>
          </div>
        `;
      }
      container.innerHTML = html;
    }

    function switchCalendarView(viewName) {
      _calView = viewName;
      document.querySelectorAll('.cal-view-btn').forEach(b => b.classList.remove('active'));
      const activeBtn = document.querySelector(`.cal-view-btn[data-view="${viewName}"]`);
      if (activeBtn) activeBtn.classList.add('active');

      document.querySelectorAll('.cal-view-pane').forEach(p => p.style.display = 'none');
      const activePane = document.getElementById('view-' + viewName);
      if (activePane) activePane.style.display = 'block';

      loadCalendarEvents();
    }

    function getMonday(d) {
      const date = new Date(d);
      const day = date.getDay();
      const diff = date.getDate() - day + (day === 0 ? -6 : 1);
      return new Date(date.setDate(diff));
    }

    function getWeekNumber(d) {
      const date = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
      const dayNum = date.getUTCDay() || 7;
      date.setUTCDate(date.getUTCDate() + 4 - dayNum);
      const yearStart = new Date(Date.UTC(date.getUTCFullYear(),0,1));
      return Math.ceil((((date - yearStart) / 86400000) + 1)/7);
    }

    // ── MODAL ADD EVENT ──
    function openAddEventModal() {
      const todayStr = localDateKey(_currentDate);
      document.getElementById('ne-date').value = todayStr;
      document.getElementById('modal-add-event').classList.remove('hidden');
    }

    function closeAddEventModal() {
      document.getElementById('modal-add-event').classList.add('hidden');
    }

    async function submitNewEvent() {
      const title = document.getElementById('ne-title').value.trim();
      const date = document.getElementById('ne-date').value;
      const time = document.getElementById('ne-time').value;
      const event_type = document.getElementById('ne-type').value;
      const location = document.getElementById('ne-location').value.trim();
      const description = document.getElementById('ne-description').value.trim();

      const start_datetime = `${date} ${time}:00`;

      try {
        const res = await lifeApiFetch('/api/calendar/events', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, start_datetime, event_type, location, description })
        });
        if (res.ok) {
          const saved = await res.json();
          if (!saved.ok || !Number.isInteger(saved.id)) throw new Error('Speicherung wurde nicht bestätigt.');
          closeAddEventModal();
          await loadCalendarEvents();
        } else {
          alert(res.status === 401 || res.status === 403 ? 'Bitte über die Geräteanmeldung anmelden.' : `Termin konnte nicht gespeichert werden (HTTP ${res.status}).`);
        }
      } catch (e) {
        alert('Netzwerkfehler: ' + e.message);
      }
    }

    // ── PERSÖNLICHE ROUTINEN: tatsächlicher /api/routines-Vertrag ──
    let _allPersonalRoutines = [];
    const routineStatus = () => document.getElementById('routine-load-status');

    async function loadPersonalRoutines() {
      routineStatus().textContent = 'Lade Routinen …';
      try {
        const res = await lifeApiFetch('/api/routines');
        if (!res.ok) throw new Error(res.status === 401 || res.status === 403 ? 'Bitte über die Geräteanmeldung anmelden.' : `HTTP ${res.status}`);
        const data = await res.json();
        if (data.success !== true || !Array.isArray(data.routines)) throw new Error('Routinen konnten nicht geladen werden.');
        _allPersonalRoutines = data.routines;
        for (const key of ['total', 'active', 'due_today', 'overdue']) {
          const label = key === 'due_today' ? 'due' : key;
          document.getElementById(`routine-stat-${label}`).textContent = String(data.stats?.[key] ?? '–');
        }
        const filter = document.getElementById('filter-routine-cat');
        const prior = filter.value;
        filter.replaceChildren(new Option('Alle Kategorien', ''));
        for (const category of [...new Set(data.routines.map(r => r.category).filter(Boolean))].sort()) {
          filter.add(new Option(String(category), String(category)));
        }
        filter.value = prior;
        routineStatus().textContent = '';
        renderPersonalRoutines();
        return data.routines;
      } catch (error) {
        _allPersonalRoutines = [];
        document.getElementById('personal-routines-list').replaceChildren();
        routineStatus().textContent = error.message || 'Routinen konnten nicht geladen werden.';
        return null;
      }
    }

    function routineButton(label, action) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'btn btn-secondary btn-sm';
      button.textContent = label;
      button.addEventListener('click', action);
      return button;
    }

    function renderPersonalRoutines() {
      const container = document.getElementById('personal-routines-list');
      container.replaceChildren();
      const category = document.getElementById('filter-routine-cat').value;
      const routines = _allPersonalRoutines.filter(r => !category || r.category === category);
      if (!routines.length) {
        const empty = document.createElement('p');
        empty.textContent = 'Keine Routinen für diese Auswahl vorhanden.';
        container.append(empty);
        return;
      }
      for (const routine of routines) {
        const id = Number(routine.id);
        if (!Number.isSafeInteger(id) || id < 1) continue;
        const row = document.createElement('article');
        row.className = 'routine-row';
        const info = document.createElement('div');
        const title = document.createElement('strong');
        title.textContent = String(routine.name ?? 'Unbenannte Routine');
        const meta = document.createElement('span');
        meta.className = 'routine-meta';
        meta.textContent = [routine.category, routine.interval_type, routine.next_due_at ? `Nächste Fälligkeit: ${routine.next_due_at}` : 'Keine Fälligkeit', routine.is_active ? 'Aktiv' : 'Inaktiv'].filter(Boolean).join(' · ');
        info.append(title, meta);
        const actions = document.createElement('div');
        actions.className = 'routine-actions';
        if (routine.is_active && (routine.is_due_today || routine.is_overdue)) actions.append(routineButton('Erledigt', () => changeRoutine(`/api/routines/${id}/complete`, 'POST', id, 'Routine erledigt.')));
        actions.append(routineButton('Bearbeiten', () => openRoutineForm(routine)));
        actions.append(routineButton('Löschen', () => { if (confirm('Routine wirklich löschen?')) changeRoutine(`/api/routines/${id}`, 'DELETE', id, 'Routine gelöscht.'); }));
        row.append(info, actions);
        container.append(row);
      }
    }

    function openRoutineForm(routine = null) {
      const form = document.getElementById('life-routine-form');
      form.reset();
      document.getElementById('routine-edit-id').value = routine ? String(routine.id) : '';
      document.getElementById('life-routine-form-title').textContent = routine ? 'Routine bearbeiten' : 'Neue Routine';
      for (const [field, value] of Object.entries({
        name: routine?.name || '', description: routine?.description || '', category: routine?.category || 'Haushalt',
        priority: routine?.priority || 2, interval: routine?.interval_type || 'woechentlich',
        'interval-value': routine?.interval_value || 1, 'specific-day': routine?.specific_day || '',
        duration: routine?.duration_minutes ?? '',
      })) document.getElementById(`routine-${field}`).value = value;
      form.classList.remove('hidden');
      document.getElementById('routine-name').focus();
    }

    async function changeRoutine(path, method, id, successText, body = null) {
      try {
        const res = await lifeApiFetch(path, { method, headers: body ? { 'Content-Type': 'application/json' } : {}, body: body ? JSON.stringify(body) : undefined });
        if (!res.ok) throw new Error(res.status === 401 || res.status === 403 ? 'Bitte über die Geräteanmeldung anmelden.' : `HTTP ${res.status}`);
        const ack = await res.json();
        if (ack.success !== true) throw new Error('Die Änderung wurde nicht bestätigt.');
        const recordId = method === 'POST' && path === '/api/routines' ? Number(ack.id) : id;
        if (body && (!Number.isSafeInteger(recordId) || recordId < 1)) throw new Error('Die Speicherung hat keine gültige Routine-ID bestätigt.');
        const readback = await loadPersonalRoutines();
        if (!readback) throw new Error('Änderung bestätigt, aber die aktuelle Liste konnte nicht gelesen werden.');
        if (method === 'DELETE' && readback.some(r => Number(r.id) === id)) throw new Error('Die gelöschte Routine ist noch vorhanden.');
        if (body && !readback.some(r => Number(r.id) === recordId && r.name === body.name)) throw new Error('Die gespeicherte Routine konnte nicht zurückgelesen werden.');
        routineStatus().textContent = successText;
        document.getElementById('life-routine-form').classList.add('hidden');
      } catch (error) { routineStatus().textContent = error.message || 'Änderung fehlgeschlagen.'; }
    }

    function savePersonalRoutine(event) {
      event.preventDefault();
      const idText = document.getElementById('routine-edit-id').value;
      const id = idText ? Number(idText) : null;
      const title = document.getElementById('routine-name').value.trim();
      const intervalValue = Number(document.getElementById('routine-interval-value').value);
      if (!title || !Number.isSafeInteger(intervalValue) || intervalValue < 1) {
        routineStatus().textContent = 'Name und gültiges Intervall sind erforderlich.';
        return;
      }
      const body = {
        name: title, description: document.getElementById('routine-description').value,
        category: document.getElementById('routine-category').value.trim() || 'Haushalt',
        priority: Number(document.getElementById('routine-priority').value),
        interval_type: document.getElementById('routine-interval').value, interval_value: intervalValue,
        specific_day: document.getElementById('routine-specific-day').value.trim() || null,
        duration_minutes: document.getElementById('routine-duration').value ? Number(document.getElementById('routine-duration').value) : null,
      };
      changeRoutine(id ? `/api/routines/${id}` : '/api/routines', id ? 'PUT' : 'POST', id, 'Routine gespeichert.', body);
    }

    // ── MEINE AUFGABEN ──
    async function loadUserTasks() {
      const container = document.getElementById('user-tasks-container');
      const statusFilter = document.getElementById('filter-user-tasks-status')?.value || '';
      if (!container) return;

      try {
        let url = '/api/tasks?assigned_to=user&limit=30';
        if (statusFilter) url += `&status=${statusFilter}`;
        const res = await fetch(url);
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        const tasks = data.tasks || [];

        if (tasks.length === 0) {
          container.innerHTML = '<p style="color:var(--text-muted);padding:1rem;text-align:center;">Keine offenen Aufgaben für Benutzer gefunden.</p>';
          return;
        }

        container.innerHTML = `
          <table class="data-table">
            <thead>
              <tr>
                <th style="width:60px;">ID</th>
                <th>Titel & Beschreibung</th>
                <th style="width:110px;">Status</th>
                <th style="width:80px;">Priorität</th>
                <th style="width:120px;">Kategorie</th>
              </tr>
            </thead>
            <tbody>
              ${tasks.map(t => `
                <tr>
                  <td style="font-family:monospace;color:var(--text-muted);">#${t.id}</td>
                  <td>
                    <strong>${escapeHtml(t.title || 'Ohne Titel')}</strong>
                    ${t.description ? `<p style="font-size:0.75rem;color:var(--text-muted);margin:0.2rem 0 0 0;">${escapeHtml(t.description.slice(0, 80))}...</p>` : ''}
                  </td>
                  <td><span class="badge ${t.status === 'done' || t.status === 'completed' ? 'badge-success' : 'badge-accent'}">${escapeHtml(t.status || 'todo')}</span></td>
                  <td style="font-weight:600;color:var(--text);">${t.priority || 2}</td>
                  <td><span class="badge badge-secondary" style="font-size:0.7rem;">${escapeHtml(t.category || '-')}</span></td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        `;
      } catch (e) {
        container.innerHTML = `<p style="color:var(--error);padding:1rem;">Fehler beim Laden: ${e.message}</p>`;
      }
    }

    // ── MAIN TAB SETUP ──
    function setupTabs() {
      const tabButtons = document.querySelectorAll('.tab-btn');
      const tabPanes = document.querySelectorAll('.tab-pane');

      tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const tab = btn.getAttribute('data-tab');
          tabButtons.forEach(b => b.classList.remove('active'));
          tabPanes.forEach(p => p.classList.remove('active'));

          btn.classList.add('active');
          const targetPane = document.getElementById('pane-' + tab);
          if (targetPane) targetPane.classList.add('active');

          const url = new URL(window.location);
          url.searchParams.set('tab', tab);
          window.history.replaceState({}, '', url);

          if (tab === 'kalender') loadCalendarEvents();
          if (tab === 'routinen') loadPersonalRoutines();
          if (tab === 'aufgaben') loadUserTasks();
        });
      });

      // View Buttons in Kalender
      document.querySelectorAll('.cal-view-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const view = btn.getAttribute('data-view');
          switchCalendarView(view);
        });
      });
      document.querySelectorAll('.calendar-source-filters input').forEach(input => {
        input.addEventListener('change', renderActiveCalendarView);
      });

      // Handle query param
      const urlParams = new URLSearchParams(window.location.search);
      const initialTab = urlParams.get('tab');
      if (initialTab) {
        const matchBtn = document.querySelector(`.tab-btn[data-tab="${initialTab}"]`);
        if (matchBtn) matchBtn.click();
      }
    }

    // ── TIMER ──
    let timerInterval = null;
    let secondsLeft = 25 * 60;
    let timerDeadline = null;
    let focusPopup = null;

    function updateTimerDisplay() {
      const display = document.getElementById('timer-display');
      if (!display) return;
      const m = Math.floor(secondsLeft / 60).toString().padStart(2, '0');
      const s = (secondsLeft % 60).toString().padStart(2, '0');
      display.textContent = `${m}:${s}`;
    }

    function stopTimer() {
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = null;
      timerDeadline = null;
    }

    function tickTimer() {
      if (timerDeadline === null) return;
      secondsLeft = Math.max(0, Math.ceil((timerDeadline - performance.now()) / 1000));
      updateTimerDisplay();
      if (secondsLeft === 0) {
        stopTimer();
        document.getElementById('btn-timer-start').textContent = 'Start';
        document.getElementById('focus-window-status').textContent = 'Intervall beendet.';
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      setupTabs();
      loadCalendarEvents();
      document.getElementById('routine-add')?.addEventListener('click', () => openRoutineForm());
      document.getElementById('routine-refresh')?.addEventListener('click', loadPersonalRoutines);
      document.getElementById('routine-cancel')?.addEventListener('click', () => document.getElementById('life-routine-form').classList.add('hidden'));
      document.getElementById('filter-routine-cat')?.addEventListener('change', renderPersonalRoutines);
      document.getElementById('life-routine-form')?.addEventListener('submit', savePersonalRoutine);

      const btnStart = document.getElementById('btn-timer-start');
      const btnReset = document.getElementById('btn-timer-reset');
      btnStart?.addEventListener('click', () => {
        if (timerInterval) {
          tickTimer();
          stopTimer();
          btnStart.textContent = 'Weiter';
        } else {
          if (secondsLeft <= 0) secondsLeft = Number(document.querySelector('.timer-tag.active')?.dataset.seconds || 1500);
          timerDeadline = performance.now() + secondsLeft * 1000;
          btnStart.textContent = 'Pause';
          tickTimer();
          timerInterval = setInterval(tickTimer, 250);
        }
      });
      btnReset?.addEventListener('click', () => {
        stopTimer();
        secondsLeft = Number(document.querySelector('.timer-tag.active')?.dataset.seconds || 1500);
        updateTimerDisplay();
        btnStart.textContent = 'Start';
        document.getElementById('focus-window-status').textContent = 'Timer bereit.';
      });
      document.querySelectorAll('.timer-tag').forEach(button => button.addEventListener('click', () => {
        stopTimer();
        document.querySelectorAll('.timer-tag').forEach(tag => tag.classList.remove('active'));
        button.classList.add('active');
        secondsLeft = Number(button.dataset.seconds);
        updateTimerDisplay();
        btnStart.textContent = 'Start';
      }));
      if (new URLSearchParams(location.search).get('focus') === '1') {
        document.querySelector('.life-container')?.classList.add('standalone-focus');
        document.getElementById('focus-window-status').textContent = 'Eigenständiger Browser-Timer. Er wird nicht mit dem Hauptfenster synchronisiert.';
      } else {
        document.getElementById('btn-focus-window')?.addEventListener('click', () => {
          const url = new URL('/life?tab=selbstmanagement&focus=1', location.origin);
          if (url.origin !== location.origin) return;
          focusPopup = window.open(url.href, 'life-focus-timer', 'width=500,height=580');
          const status = document.getElementById('focus-window-status');
          if (!focusPopup) { status.textContent = 'Das Browserfenster wurde blockiert. Bitte Pop-ups für diese Seite erlauben.'; return; }
          try {
            focusPopup.focus();
            status.textContent = 'Fokusfenster geöffnet. Beide Timer laufen unabhängig.';
          } catch (_) {
            focusPopup.close();
            status.textContent = 'Fokusfenster konnte nicht sicher geöffnet werden.';
          }
        });
        setInterval(() => {
          if (focusPopup && focusPopup.closed) {
            focusPopup = null;
            document.getElementById('focus-window-status').textContent = 'Fokusfenster geschlossen. Der Timer hier ist unabhängig.';
          } else if (focusPopup) {
            try {
              if (focusPopup.location.origin !== location.origin) {
                focusPopup = null;
                document.getElementById('focus-window-status').textContent = 'Fokusfenster ist nicht mehr mit dieser Seite verbunden.';
              }
            } catch (_) {
              focusPopup = null;
              document.getElementById('focus-window-status').textContent = 'Fokusfenster ist nicht mehr mit dieser Seite verbunden.';
            }
          }
        }, 1000);
      }
    });
  </script>
</BachLayout>
