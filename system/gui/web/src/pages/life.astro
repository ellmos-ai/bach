---
// src/pages/life.astro - Life-Zentrale (Kalender mit 4 Ansichten, Deine Routinen, Meine Aufgaben, Selbstmanagement)
import BachLayout from "../layouts/BachLayout.astro";
---

<BachLayout title="Life-Zentrale" currentPath="/life">
  <div class="life-container">
    <div class="page-header">
      <div class="header-content">
        <h1><span class="icon">🌱</span> Life-Zentrale</h1>
        <p class="subtitle">Ganzheitliches Selbstmanagement, 4-Ansichten-Kalender, Deine Routinen und Lebensbereiche</p>
      </div>
      <div class="header-badges">
        <span class="badge badge-accent">BACH Life OS</span>
        <span class="badge badge-secondary">Persönliche Bereiche</span>
      </div>
    </div>

    <!-- Tab Bar -->
    <div class="tab-bar">
      <button class="tab-btn active" data-tab="kalender">📅 Kalender (4 Ansichten)</button>
      <button class="tab-btn" data-tab="routinen">⏰ Deine Routinen</button>
      <button class="tab-btn" data-tab="aufgaben">👤 Meine Aufgaben</button>
      <button class="tab-btn" data-tab="selbstmanagement">🎯 Selbstmanagement & ADHS</button>
      <button class="tab-btn" data-tab="finanzen">💰 Finanzen</button>
      <button class="tab-btn" data-tab="balance">☯️ Lebensbereiche</button>
      <button class="tab-btn" data-tab="gesundheit">🩺 Gesundheit</button>
    </div>

    <!-- TAB 1: KALENDER MIT 4 ANSICHTEN -->
    <div class="tab-pane active" id="pane-kalender">
      <div class="calendar-controls-bar">
        <!-- 4 Ansichten Switcher (Segmented Pills) -->
        <div class="cal-views-segmented">
          <button class="cal-view-btn" data-view="day">📅 Tagesansicht</button>
          <button class="cal-view-btn" data-view="week">🗓️ Wochenansicht</button>
          <button class="cal-view-btn active" data-view="month">📆 Monatsansicht</button>
          <button class="cal-view-btn" data-view="year">🌐 Jahresüberblick</button>
        </div>

        <!-- Date Navigation Controls -->
        <div class="cal-nav-group">
          <button class="btn btn-secondary btn-sm" onclick="navigateCalendar(-1)">◀ Vorheriger</button>
          <button class="btn btn-secondary btn-sm" onclick="navigateCalendar(0)">Heute</button>
          <button class="btn btn-secondary btn-sm" onclick="navigateCalendar(1)">Nächster ▶</button>
          <h2 id="cal-period-heading" style="margin:0 0.5rem;font-size:1.15rem;font-weight:700;color:var(--text);">Oktober 2026</h2>
        </div>

        <!-- Add Event Button -->
        <button class="btn btn-primary btn-sm" onclick="openAddEventModal()">
          <span>+</span> Neuer Termin
        </button>
      </div>
      <div class="calendar-source-filters" role="group" aria-label="Terminquellen">
        <label><input id="cal-source-user" type="checkbox" checked /> Nutzertermine</label>
        <label><input id="cal-source-system" type="checkbox" checked /> BACH/Ocean-Systemtermine</label>
        <label><input id="cal-source-unknown" type="checkbox" checked /> Ältere Termine ohne Herkunft</label>
      </div>
      <p id="calendar-load-status" class="load-status" role="status" aria-live="polite"></p>

      <!-- VIEW 1: TAGESANSICHT (24h Timeline) -->
      <div class="cal-view-pane" id="view-day" style="display:none;">
        <div class="glass-card">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;border-bottom:1px solid var(--border);padding-bottom:0.75rem;">
            <div>
              <h3 id="day-view-date-title" style="margin:0;font-size:1.1rem;color:var(--text);">Heute</h3>
              <p style="font-size:0.8rem;color:var(--text-muted);margin:0.2rem 0 0 0;">Stunden-Raster & fällige Tagesblöcke</p>
            </div>
            <span class="badge badge-accent" id="day-event-count">0 Termine</span>
          </div>

          <div class="day-timeline-container" id="day-timeline-slots">
            <!-- Hourly slots injected by JS -->
          </div>
        </div>
      </div>

      <!-- VIEW 2: WOCHENANSICHT (7-Spalten) -->
      <div class="cal-view-pane" id="view-week" style="display:none;">
        <div class="glass-card" style="padding:1rem;">
          <div class="week-grid-container" id="week-columns-grid">
            <!-- 7 columns Mo-So injected by JS -->
          </div>
        </div>
      </div>

      <!-- VIEW 3: MONATSANSICHT (Matrix Raster) -->
      <div class="cal-view-pane active" id="view-month">
        <div class="glass-card" style="padding:1rem;">
          <div class="month-weekdays-header">
            <span>Mo</span><span>Di</span><span>Mi</span><span>Do</span><span>Fr</span><span>Sa</span><span>So</span>
          </div>
          <div class="month-days-matrix" id="month-days-grid">
            <!-- Days 1..31 injected by JS -->
          </div>
        </div>
      </div>

      <!-- VIEW 4: JAHRESÜBERBLICK (12 Mini-Monate in 4 Quartalen) -->
      <div class="cal-view-pane" id="view-year" style="display:none;">
        <div class="glass-card">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem;">
            <div>
              <h3 id="year-title" style="margin:0;font-size:1.2rem;color:var(--text);">Jahresüberblick 2026</h3>
               <p style="font-size:0.8rem;color:var(--text-muted);margin:0.25rem 0 0 0;">Jeder Kalendertag als eigenes Kästchen</p>
            </div>
            <div style="display:flex;gap:0.75rem;font-size:0.8rem;">
               <span class="badge badge-secondary">12 Monate</span>
            </div>
          </div>

          <div class="year-quarters-grid" id="year-quarters-container">
            <!-- 12 mini months injected by JS -->
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 2: DEINE ROUTINEN -->
    <div class="tab-pane" id="pane-routinen">
      <div class="glass-card">
        <div class="card-header-action">
          <div>
            <h3><span class="icon">⏰</span> Deine Routinen</h3>
            <p class="card-desc">Persönliche Routinen aus deiner Nutzerdatenbank. Systemjobs von BACH und Ocean werden getrennt verwaltet.</p>
          </div>
          <div class="routine-actions">
            <button type="button" id="routine-add" class="btn btn-primary btn-sm">+ Neue Routine</button>
            <button type="button" id="routine-refresh" class="btn btn-secondary btn-sm">Aktualisieren</button>
          </div>
        </div>
        <p id="routine-load-status" class="load-status" role="status" aria-live="polite">Lade Routinen …</p>
        <div class="routine-stats" aria-label="Routinenstatus">
          <span>Gesamt: <strong id="routine-stat-total">–</strong></span>
          <span>Aktiv: <strong id="routine-stat-active">–</strong></span>
          <span>Heute fällig: <strong id="routine-stat-due">–</strong></span>
          <span>Überfällig: <strong id="routine-stat-overdue">–</strong></span>
        </div>
        <label class="routine-filter">Kategorie
          <select id="filter-routine-cat"><option value="">Alle Kategorien</option></select>
        </label>
        <div id="personal-routines-list" class="routine-list"></div>
        <form id="life-routine-form" class="routine-form hidden" aria-label="Routine bearbeiten">
          <h4 id="life-routine-form-title">Neue Routine</h4>
          <input id="routine-edit-id" type="hidden" />
          <label>Name * <input id="routine-name" required maxlength="200" /></label>
          <label>Beschreibung <textarea id="routine-description" rows="2"></textarea></label>
          <div class="routine-form-grid">
            <label>Kategorie <input id="routine-category" value="Haushalt" /></label>
            <label>Priorität <select id="routine-priority"><option value="1">Hoch</option><option value="2" selected>Mittel</option><option value="3">Niedrig</option></select></label>
            <label>Intervall <select id="routine-interval"><option value="taeglich">Täglich</option><option value="woechentlich" selected>Wöchentlich</option><option value="monatlich">Monatlich</option><option value="jaehrlich">Jährlich</option></select></label>
            <label>Alle X Einheiten <input id="routine-interval-value" type="number" min="1" value="1" required /></label>
            <label>Spezifischer Tag <input id="routine-specific-day" /></label>
            <label>Dauer in Minuten <input id="routine-duration" type="number" min="0" /></label>
          </div>
          <div class="routine-actions"><button type="submit" class="btn btn-primary btn-sm">Speichern</button><button id="routine-cancel" type="button" class="btn btn-secondary btn-sm">Abbrechen</button></div>
        </form>
        <div class="routine-adapters">
          <a href="/routinen?tab=bach">BACH/Ocean-Systemjobs getrennt öffnen ↗</a>
          <button type="button" disabled title="Routinika ist als Desktop-App belegt; ein verifizierter Web-Startvertrag und eine Installation auf diesem Gerät fehlen.">Routinika öffnen – Anbindung in Arbeit</button>
        </div>
      </div>
    </div>

    <!-- TAB 3: MEINE AUFGABEN -->
    <div class="tab-pane" id="pane-aufgaben">
      <div class="glass-card">
        <div class="card-header-action" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
          <div>
            <h3><span class="icon">👤</span> Meine persönlichen Aufgaben</h3>
            <p class="card-desc">Gefiltert auf: <code>assigned_to = 'user'</code> (Aus dem zentralen Task-Repository)</p>
          </div>
          <div style="display:flex;gap:0.5rem;">
            <select id="filter-user-tasks-status" onchange="loadUserTasks()" style="padding:0.4rem 0.6rem;background:var(--bg-dark);color:var(--text);border:1px solid var(--border);border-radius:4px;font-size:0.825rem;">
              <option value="">Alle Status</option>
              <option value="todo" selected>Offen / Todo</option>
              <option value="in_progress">In Bearbeitung</option>
              <option value="done">Erledigt</option>
            </select>
            <a href="/tasks?assigned_to=user" class="btn btn-secondary btn-sm">Im Taskboard öffnen ↗</a>
          </div>
        </div>
        <div id="user-tasks-container">
          <p class="loading-state">Lade persönliche Aufgaben aus bach.db...</p>
        </div>
      </div>
    </div>

    <!-- TAB 4: SELBSTMANAGEMENT & ADHS -->
    <div class="tab-pane" id="pane-selbstmanagement">
      <div class="card-grid">
        <div class="glass-card">
          <h3><span class="icon">🧠</span> Neurodivergenz & Exekutiv-Entlastung</h3>
          <p class="card-desc">Praktische Hilfen für selbst gewählte Arbeitsschritte</p>
          <div class="feature-item">
            <strong>1. Kurzes Fokusintervall</strong>
            <p>Wähle eine überschaubare Dauer und lege den nächsten Schritt fest. Der Timer läuft ausschließlich in deinem Browser.</p>
          </div>
          <div class="feature-item">
            <strong>2. Reize reduzieren</strong>
            <p>Schließe alle Tabs, die nicht zum aktuellen Schritt gehören. Nutze das Denkarium als Zwischenablage für spontane Impulse.</p>
          </div>
          <div class="feature-item">
            <strong>3. Begleitung bei Bedarf</strong>
            <p>Ein begleiteter Arbeitsmodus benötigt noch eine überprüfte Chat- und Datenschutzanbindung. Der Timer funktioniert bereits ohne Agentenaufruf.</p>
          </div>
          <button type="button" disabled title="Für UpToday ist keine installierte Web-Oberfläche mit verifiziertem Startvertrag belegt.">UpToday öffnen – Anbindung in Arbeit</button>
        </div>

        <div class="glass-card">
          <h3><span class="icon">⏱️</span> Fokus-Timer & Arbeits-Intervall</h3>
          <div class="timer-widget">
            <div class="timer-display" id="timer-display" role="timer" aria-live="off">25:00</div>
            <div class="timer-controls">
              <button class="btn btn-primary" id="btn-timer-start">Start</button>
              <button class="btn btn-secondary" id="btn-timer-reset">Reset</button>
              <button class="btn btn-secondary" id="btn-focus-window" type="button">Eigenes Fokusfenster öffnen</button>
            </div>
            <div class="timer-modes">
              <button type="button" class="timer-tag active" data-seconds="1500">25 Minuten Fokus</button>
              <button type="button" class="timer-tag" data-seconds="300">5 Minuten Pause</button>
              <button type="button" class="timer-tag" data-seconds="900">15 Minuten Erholung</button>
            </div>
            <p id="focus-window-status" class="load-status" role="status" aria-live="polite">Timer bereit.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 5: FINANZEN -->
    <div class="tab-pane" id="pane-finanzen">
      <div class="glass-card">
        <div class="card-header-action" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
          <div>
            <h3><span class="icon">💰</span> Finanzen & Budget-Dashboard</h3>
            <p class="card-desc">Finanzdaten und Auswertungen im vorhandenen Finanzbereich</p>
          </div>
          <a href="/financial" class="btn btn-secondary">Vollständiges Finanzmodul ↗</a>
        </div>
        <p class="load-status">Für Monatsbudget, Belege und Rücklagen gibt es hier noch keinen belegten, gemeinsamen Auswertungsvertrag. Im Finanzbereich sind die vorhandenen Konten-, Abonnement- und Finanzmail-Funktionen erreichbar.</p>
      </div>
    </div>

    <!-- TAB 6: LEBENSBEREICHE -->
    <div class="tab-pane" id="pane-balance">
      <div class="glass-card">
        <p class="card-desc">In Arbeit. Für persönliche Balancewerte fehlen eine freiwillige Eingabe, ein nachvollziehbares Bewertungsverfahren und eine geschützte Speicherung. Es werden keine Prozentwerte geschätzt.</p>
      </div>
    </div>

    <!-- TAB 7: GESUNDHEIT -->
    <div class="tab-pane" id="pane-gesundheit">
      <div class="glass-card">
        <div class="card-header-action" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
          <div>
             <h3><span class="icon">🩺</span> Gesundheit</h3>
             <p class="card-desc">Gesundheitsbereich im Life-Tab – Fachanbindung in Arbeit</p>
           </div>
         </div>
         <p>Die bisherige Gesundheitsansicht enthält nur geplante Funktionen. Für Vitalwerte, Arzttermine und Medikamente fehlen ein geprüfter Fachadapter, ein Datenvertrag und ein Gerätezugriffsvertrag. Hier werden keine Gesundheitsdaten gelesen oder angezeigt.</p>
         <ul><li>Fachmodul und installierte Web-Oberfläche verifizieren</li><li>Autorisierte Gesundheits-API anbinden</li><li>Erst danach Eingabe und Anzeige ergänzen</li></ul>
      </div>
    </div>
  </div>

  <!-- MODAL: NEUER TERMIN ANLEGEN -->
  <div id="modal-add-event" class="hidden" style="position:fixed;inset:0;background:rgba(0,0,0,0.7);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;z-index:2000;">
    <div style="background:var(--bg-panel);border:1px solid var(--border);border-radius:var(--radius-md);width:100%;max-width:500px;padding:1.75rem;box-shadow:0 20px 50px rgba(0,0,0,0.5);">
      <h3 style="font-size:1.25rem;font-weight:700;margin-bottom:0.5rem;color:var(--text);">📅 Neuer Kalendertermin</h3>
      <p style="font-size:0.8rem;color:var(--text-muted);margin-bottom:1.25rem;">
        Wird in <code>assistant_calendar</code> gespeichert.
      </p>

      <form id="form-new-cal-event" onsubmit="event.preventDefault(); submitNewEvent();" style="display:flex;flex-direction:column;gap:1rem;">
        <div>
          <label style="display:block;font-size:0.8rem;color:var(--text-muted);margin-bottom:0.25rem;">Titel des Termins *</label>
          <input type="text" id="ne-title" required placeholder="z. B. System-Review & Testing" style="width:100%;padding:0.6rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text);font-size:0.9rem;" />
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;">
          <div>
            <label style="display:block;font-size:0.8rem;color:var(--text-muted);margin-bottom:0.25rem;">Datum *</label>
            <input type="date" id="ne-date" required style="width:100%;padding:0.55rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text);font-size:0.85rem;" />
          </div>
          <div>
            <label style="display:block;font-size:0.8rem;color:var(--text-muted);margin-bottom:0.25rem;">Start-Uhrzeit *</label>
            <input type="time" id="ne-time" value="10:00" required style="width:100%;padding:0.55rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text);font-size:0.85rem;" />
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;">
          <div>
            <label style="display:block;font-size:0.8rem;color:var(--text-muted);margin-bottom:0.25rem;">Kategorie</label>
            <select id="ne-type" style="width:100%;padding:0.55rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text);font-size:0.85rem;">
              <option value="termin">Termin / Meeting</option>
              <option value="fokusblock">Fokusblock (Deep Work)</option>
              <option value="privat">Privat / Erholung</option>
              <option value="gesundheit">Gesundheit / Sport</option>
            </select>
          </div>
          <div>
            <label style="display:block;font-size:0.8rem;color:var(--text-muted);margin-bottom:0.25rem;">Ort / Tool</label>
            <input type="text" id="ne-location" placeholder="z. B. Remote / Zoom / Office" style="width:100%;padding:0.55rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text);font-size:0.85rem;" />
          </div>
        </div>

        <div>
          <label style="display:block;font-size:0.8rem;color:var(--text-muted);margin-bottom:0.25rem;">Notiz / Agenda</label>
          <textarea id="ne-description" rows="2" placeholder="Optionale Details zum Ablauf..." style="width:100%;padding:0.55rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text);font-size:0.85rem;"></textarea>
        </div>

        <div style="display:flex;justify-content:flex-end;gap:0.5rem;margin-top:0.5rem;">
          <button type="button" class="btn btn-secondary" onclick="closeAddEventModal()">Abbrechen</button>
          <button type="submit" class="btn btn-primary">Termin speichern ➔</button>
        </div>
      </form>
    </div>
  </div>

  <style>
    .hidden { display: none !important; }
    .life-container {
      padding: 1.5rem;
      max-width: 1400px;
      margin: 0 auto;
    }
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .page-header h1 {
      margin: 0;
      font-size: 1.75rem;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .subtitle {
      color: var(--text-muted);
      margin: 0.25rem 0 0 0;
      font-size: 0.875rem;
    }
    .tab-bar {
      display: flex;
      gap: 0.4rem;
      border-bottom: 1px solid var(--border);
      margin-bottom: 1.5rem;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .tab-btn {
      padding: 0.65rem 1.15rem;
      background: none;
      border: none;
      border-bottom: 2px solid transparent;
      color: var(--text-muted);
      font-size: 0.88rem;
      font-weight: 500;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.2s;
    }
    .tab-btn:hover {
      color: var(--text);
    }
    .tab-btn.active {
      color: var(--accent);
      border-bottom-color: var(--accent);
      font-weight: 700;
    }
    .tab-pane {
      display: none;
    }
    .tab-pane.active {
      display: block;
    }
    .glass-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.5rem;
    }
    .card-header-action, .routine-actions, .routine-adapters { display:flex; justify-content:space-between; align-items:center; gap:.6rem; flex-wrap:wrap; }
    .routine-actions, .routine-adapters { justify-content:flex-start; }
    .routine-stats { display:flex; flex-wrap:wrap; gap:.65rem 1.25rem; padding:.75rem; background:var(--bg-dark); border:1px solid var(--border); border-radius:var(--radius-sm); }
    .routine-filter { display:flex; align-items:center; gap:.5rem; margin:1rem 0; }
    .routine-filter select, .routine-form input, .routine-form textarea, .routine-form select { min-width:0; max-width:100%; padding:.5rem; background:var(--bg-dark); color:var(--text); border:1px solid var(--border); border-radius:var(--radius-sm); font:inherit; }
    .routine-list { display:grid; gap:.65rem; }
    .routine-row { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:.65rem; padding:.85rem; border:1px solid var(--border); border-radius:var(--radius-sm); background:var(--bg-dark); }
    .routine-row strong { overflow-wrap:anywhere; }
    .routine-meta { display:block; color:var(--text-muted); font-size:.82rem; margin-top:.2rem; overflow-wrap:anywhere; }
    .routine-form { margin-top:1.25rem; padding:1rem; border:1px solid var(--accent); border-radius:var(--radius-sm); }
    .routine-form label { display:flex; flex-direction:column; gap:.3rem; margin:.5rem 0; }
    .routine-form-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:.5rem 1rem; }
    .routine-adapters { margin-top:1.25rem; border-top:1px solid var(--border); padding-top:1rem; font-size:.83rem; }
    .routine-adapters button:disabled { opacity:.7; cursor:not-allowed; }

    /* Calendar Controls Bar */
    .calendar-controls-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.25rem;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .cal-views-segmented {
      display: inline-flex;
      background: var(--bg-dark);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 3px;
      gap: 3px;
    }
    .cal-view-btn {
      padding: 0.4rem 0.9rem;
      border: none;
      background: transparent;
      color: var(--text-muted);
      border-radius: 20px;
      font-size: 0.825rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .cal-view-btn:hover {
      color: var(--text);
    }
    .cal-view-btn.active {
      background: var(--accent);
      color: #0b0d14;
      box-shadow: 0 2px 8px rgba(56, 189, 248, 0.35);
    }
    .cal-nav-group {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      flex-wrap: wrap;
    }
