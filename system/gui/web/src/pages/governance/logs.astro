---
// src/pages/governance/logs.astro - Live Logs & Audit Stream
import BachLayout from "../../layouts/BachLayout.astro";
---

<BachLayout title="Logs & Audit | Governance" currentPath="/governance/logs">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem;">
    <div>
      <h1 style="font-size:1.75rem;font-weight:800;letter-spacing:-0.02em;margin-bottom:0.25rem;">
        📜 System Logs & Audit
      </h1>
      <p style="color:var(--text-muted);font-size:0.875rem;">
        Logquellen und Audit-Einträge, soweit der aktuelle Backend-Adapter sie bereitstellt
      </p>
    </div>

    <div style="display:flex;gap:0.5rem;align-items:center;">
      <span class="badge">Status nicht geprüft</span>
      <button class="btn btn-sm btn-primary" onclick="refreshLog()">Aktualisieren</button>
    </div>
  </div>

  <!-- Governance Modul-Tabs -->
  <div style="display:flex;gap:0.5rem;margin-bottom:1.5rem;border-bottom:1px solid var(--border);padding-bottom:0.5rem;flex-wrap:wrap;">
    <a href="/governance" class="btn btn-sm">🏛️ Control Room</a>
    <a href="/governance/funk" class="btn btn-sm">📻 Agentenfunk</a>
    <a href="/governance/usecases" class="btn btn-sm">📑 Use Cases & Workflows</a>
    <a href="/governance/logs" class="btn btn-sm btn-primary">📜 Logs & Audit</a>
  </div>

  <div style="display:grid;grid-template-columns:260px 1fr;gap:1.5rem;height:calc(100vh - 260px);min-height:550px;">
    <!-- Log-Dateien Sidebar -->
    <div class="card" style="padding:1rem;display:flex;flex-direction:column;overflow-y:auto;">
      <h3 style="font-size:0.85rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;margin:0 0 0.75rem 0;letter-spacing:0.05em;">
        Vorgesehene Logquellen
      </h3>

      <div style="display:flex;flex-direction:column;gap:0.35rem;" id="log-file-list">
        <button class="btn btn-sm btn-primary log-btn" style="text-align:left;justify-content:flex-start;" onclick="switchLog('ANTIGRAVITY-LOG.txt')">
          ⚡ ANTIGRAVITY-LOG.txt
        </button>
        <button class="btn btn-sm log-btn" style="text-align:left;justify-content:flex-start;" onclick="switchLog('gui-server.log')">
          🖥️ gui-server.log
        </button>
        <button class="btn btn-sm log-btn" style="text-align:left;justify-content:flex-start;" onclick="switchLog('gui-server.err.log')">
          ⚠️ gui-server.err.log
        </button>
        <button class="btn btn-sm log-btn" style="text-align:left;justify-content:flex-start;" onclick="switchLog('tray.err.log')">
          🛠️ tray.err.log
        </button>
        <button class="btn btn-sm log-btn" style="text-align:left;justify-content:flex-start;" onclick="switchLog('git-harvester.log')">
          🌾 git-harvester.log
        </button>
        <button class="btn btn-sm log-btn" style="text-align:left;justify-content:flex-start;" onclick="switchLog('bach.log')">
          🎵 bach.log
        </button>
      </div>

      <div style="margin-top:auto;padding-top:1rem;border-top:1px solid var(--border);font-size:0.75rem;color:var(--text-muted);">
        Quelle: <code>GET /api/logs</code> · Anzeige nur bei erfolgreichem Abruf
      </div>
    </div>

    <!-- Log-Viewer Hauptfenster -->
    <div class="card" style="padding:1rem;display:flex;flex-direction:column;overflow:hidden;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem;flex-wrap:wrap;gap:0.5rem;">
        <div style="display:flex;align-items:center;gap:0.5rem;">
          <strong id="current-log-title" style="font-size:0.95rem;color:var(--text);">ANTIGRAVITY-LOG.txt</strong>
          <span class="badge" id="log-lines-badge">Nicht geprüft</span>
        </div>
        <div style="display:flex;gap:0.5rem;align-items:center;">
          <input type="text" id="log-filter" placeholder="Filtere Zeilen..." oninput="filterLogLines()" style="padding:0.35rem 0.6rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:4px;color:var(--text);font-size:0.8rem;width:180px;" />
          <button class="btn btn-sm" onclick="copyLog()">Kopieren</button>
        </div>
      </div>

      <!-- Log Terminal Box -->
      <pre id="log-terminal" style="flex:1;background:var(--bg-dark);border:1px solid var(--border);border-radius:6px;padding:1rem;margin:0;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:0.78rem;line-height:1.45;color:#e2e8f0;overflow-y:auto;white-space:pre-wrap;word-break:break-all;"></pre>
    </div>
  </div>

  <script is:inline>
    let currentLog = 'ANTIGRAVITY-LOG.txt';
    let currentContent = '';
    let logAvailable = false;

    function switchLog(filename) {
      currentLog = filename;
      document.getElementById('current-log-title').textContent = filename;
      document.querySelectorAll('.log-btn').forEach(btn => {
        if (btn.textContent.includes(filename)) {
          btn.classList.add('btn-primary');
        } else {
          btn.classList.remove('btn-primary');
        }
      });
      refreshLog();
    }

    async function refreshLog() {
      const badge = document.getElementById('log-lines-badge');
      try {
        const res = await fetch(`/api/logs?file=${encodeURIComponent(currentLog)}`, { cache: 'no-store' });
        if (!res.ok) throw new Error('Logquelle nicht erreichbar');
        const data = await res.json();
        if (typeof data.content !== 'string') throw new Error('Logantwort ungültig');
        currentContent = data.content;
        logAvailable = true;
        filterLogLines();
      } catch (_) {
        currentContent = '';
        logAvailable = false;
        document.getElementById('log-terminal').textContent = 'Logquelle nicht verfügbar oder Zugriff erforderlich.';
        badge.textContent = 'Nicht verfügbar';
      }
    }

    function filterLogLines() {
      if (!logAvailable) return;
      const q = document.getElementById('log-filter').value.toLowerCase();
      const lines = currentContent ? currentContent.split('\n') : [];
      const filtered = q ? lines.filter(line => line.toLowerCase().includes(q)) : lines;
      document.getElementById('log-terminal').textContent = filtered.join('\n');
      document.getElementById('log-lines-badge').textContent = q
        ? `${filtered.length} / ${lines.length} Zeilen` : `${lines.length} Zeilen`;
    }

    function copyLog() {
      const text = document.getElementById('log-terminal').textContent;
      navigator.clipboard.writeText(text);
      alert('Log in Zwischenablage kopiert!');
    }

    window.addEventListener('DOMContentLoaded', () => {
      refreshLog();
    });
  </script>
</BachLayout>
