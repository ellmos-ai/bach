---
import BachLayout from "../../layouts/BachLayout.astro";
---

<BachLayout title="Usecases | Governance" currentPath="/governance/usecases">
  <header class="uc-page-head">
    <div>
      <h1>Usecases & Workflows</h1>
      <p>Vorhandene Definitionen aus der verbundenen Usecase-Datenbank. Eine Definition ist kein ausgeführter Workflow.</p>
    </div>
    <div class="uc-actions">
      <button type="button" class="btn" id="uc-refresh">Aktualisieren</button>
      <button type="button" class="btn" id="uc-check-all">Alle Definitionen prüfen</button>
      <button type="button" class="btn btn-primary" id="uc-create">+ Neuer Usecase</button>
    </div>
  </header>
  <p id="uc-page-status" role="status" hidden></p>

  <nav class="uc-nav" aria-label="Governance">
    <a href="/governance" class="btn btn-sm">Control Room</a>
    <a href="/governance/funk" class="btn btn-sm">Agentenfunk</a>
    <a href="/governance/usecases" class="btn btn-sm btn-primary" aria-current="page">Usecases</a>
    <a href="/governance/logs" class="btn btn-sm">Logs & Audit</a>
  </nav>

  <section class="uc-summary" aria-label="Stand der Definitionen">
    <div class="card"><strong id="uc-total">–</strong><span>Definitionen</span></div>
    <div class="card"><strong id="uc-pass">–</strong><span>Definition geprüft</span></div>
    <div class="card"><strong id="uc-fail">–</strong><span>Definition unvollständig</span></div>
    <div class="card"><strong id="uc-pending">–</strong><span>Prüfung ausstehend</span></div>
  </section>

  <div class="card uc-hint">
    <strong>Workflow-Ausführung in Arbeit</strong>
    <p>Die vorhandene Prüf-API kontrolliert Workflow-Datei und Testfelder und speichert einen Definitionsstatus. Der bisherige Ausführen-Endpunkt erzeugt nur Beispieltext. Ein sicherer Lauf benötigt einen gebundenen Workflow-Runner mit Rechten, Protokoll und echtem Ergebnis.</p>
  </div>

  <div class="uc-layout">
    <section class="card uc-list-panel" aria-label="Usecase-Liste">
      <div class="uc-toolbar">
        <label for="uc-search">Suche</label>
        <input id="uc-search" type="search" placeholder="Titel, Beschreibung oder Workflow" autocomplete="off" />
        <span id="uc-count" class="uc-muted" aria-live="polite">Lade Definitionen…</span>
      </div>
      <p id="uc-list-error" class="uc-error" role="alert" hidden></p>
      <div id="uc-list" class="uc-list"></div>
    </section>

    <section class="card uc-detail-panel" id="uc-detail" aria-label="Usecase-Details" aria-live="polite">
      <p id="uc-empty" class="uc-muted">Wähle eine Definition aus der Liste aus.</p>
      <div id="uc-detail-content" hidden>
        <div class="uc-detail-head">
          <div><span id="uc-id" class="uc-muted"></span><h2 id="uc-title"></h2></div>
          <div class="uc-actions">
            <button type="button" class="btn" id="uc-edit">Bearbeiten</button>
            <button type="button" class="btn btn-primary" id="uc-check">Definition prüfen</button>
            <button type="button" class="btn" id="uc-delete">Löschen</button>
          </div>
        </div>
        <dl class="uc-fields">
          <div><dt>Workflow</dt><dd id="uc-workflow"></dd></div>
          <div><dt>Definitionsstatus</dt><dd id="uc-result"></dd></div>
          <div><dt>Prüfwert</dt><dd id="uc-score"></dd></div>
          <div><dt>Zuletzt geprüft</dt><dd id="uc-tested"></dd></div>
          <div><dt>Erstellt von</dt><dd id="uc-author"></dd></div>
          <div><dt>Aktualisiert</dt><dd id="uc-updated"></dd></div>
        </dl>
        <h3>Beschreibung</h3><p id="uc-description" class="uc-content"></p>
        <h3>Prüfeingabe</h3><p id="uc-input" class="uc-content"></p>
        <h3>Erwartete Ausgabe</h3><p id="uc-expected" class="uc-content"></p>
        <p id="uc-action-status" role="status" hidden></p>
      </div>
    </section>
  </div>

  <dialog id="uc-editor" class="uc-dialog" aria-label="Usecase bearbeiten">
    <form id="uc-editor-form">
      <div class="uc-detail-head">
        <h2 id="uc-editor-title">Neuer Usecase</h2>
        <button type="button" class="btn" id="uc-editor-close" aria-label="Schließen">×</button>
      </div>
      <div class="uc-editor-grid">
        <label class="uc-wide">Titel<input name="title" required maxlength="500" /></label>
        <label class="uc-wide">Beschreibung<textarea name="description" rows="4"></textarea></label>
        <label class="uc-wide">Workflowname<input name="workflow_name" list="uc-workflow-options" autocomplete="off" /></label>
        <datalist id="uc-workflow-options"></datalist>
        <label>Prüfeingabe<textarea name="test_input" rows="3"></textarea></label>
        <label>Erwartete Ausgabe<textarea name="expected_output" rows="3"></textarea></label>
      </div>
      <p class="uc-muted">Ein Workflowname wird als Definition gespeichert; hier wird kein Workflow gestartet.</p>
      <p id="uc-editor-error" class="uc-error" role="alert" hidden></p>
      <div class="uc-actions uc-editor-actions">
        <button type="button" class="btn" id="uc-editor-cancel">Abbrechen</button>
        <button type="submit" class="btn btn-primary">Speichern</button>
      </div>
    </form>
  </dialog>

  <style>
    .uc-page-head,.uc-detail-head { display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; flex-wrap:wrap; }
    .uc-page-head h1 { margin:0 0 .25rem; font-size:1.75rem; }
    .uc-page-head p,.uc-muted,.uc-hint p { color:var(--text-muted); }
    .uc-actions,.uc-nav { display:flex; flex-wrap:wrap; gap:.55rem; }
    .uc-nav { margin:1.25rem 0; }
    .uc-summary { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.75rem; margin-bottom:1rem; }
    .uc-summary .card { padding:1rem; display:flex; flex-direction:column; min-width:0; }
    .uc-summary strong { font-size:1.6rem; line-height:1.2; }
    .uc-summary span { color:var(--text-muted); font-size:.78rem; }
    .uc-hint { padding:1rem; margin-bottom:1rem; border-left:3px solid var(--warning); }
    .uc-hint p { margin:.35rem 0 0; font-size:.85rem; }
    .uc-layout { display:grid; grid-template-columns:minmax(17rem,2fr) minmax(20rem,3fr); gap:1rem; align-items:start; }
    .uc-list-panel,.uc-detail-panel { min-width:0; padding:1rem; }
    .uc-toolbar { display:flex; flex-direction:column; gap:.45rem; margin-bottom:.8rem; }
    .uc-toolbar input,.uc-editor-grid input,.uc-editor-grid textarea { min-width:0; width:100%; box-sizing:border-box; padding:.65rem; background:var(--bg-dark); color:var(--text); border:1px solid var(--border); border-radius:var(--radius-sm); font:inherit; }
    .uc-list { display:flex; flex-direction:column; gap:.45rem; max-height:65vh; overflow:auto; }
    .uc-list button { width:100%; display:flex; flex-direction:column; gap:.3rem; text-align:left; padding:.8rem; background:var(--bg-dark); color:var(--text); border:1px solid var(--border); border-radius:var(--radius-sm); cursor:pointer; }
    .uc-list button[aria-current="true"] { border-color:var(--accent); }
    .uc-list small,.uc-fields dt { color:var(--text-muted); }
    .uc-list strong,.uc-detail-panel h2 { overflow-wrap:anywhere; }
    .uc-fields { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.5rem 1rem; }
    .uc-fields>div { min-width:0; border-top:1px solid var(--border); padding:.45rem 0; }
    .uc-fields dd { margin:.2rem 0 0; overflow-wrap:anywhere; }
    .uc-content { white-space:pre-wrap; overflow-wrap:anywhere; }
    .uc-error { color:var(--error); overflow-wrap:anywhere; }
    .uc-dialog { width:min(42rem,calc(100vw - 1.5rem)); max-height:calc(100vh - 1.5rem); overflow:auto; padding:1.3rem; background:var(--bg-panel); color:var(--text); border:1px solid var(--border); border-radius:var(--radius-md); }
    .uc-dialog::backdrop { background:rgba(0,0,0,.68); }
    .uc-editor-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.75rem; margin:.7rem 0; }
    .uc-editor-grid label { display:flex; min-width:0; flex-direction:column; gap:.3rem; }
    .uc-wide { grid-column:1/-1; }
    .uc-editor-actions { justify-content:flex-end; }
    @media (max-width:900px) { .uc-layout { grid-template-columns:minmax(0,1fr); } .uc-list { max-height:20rem; } }
    @media (max-width:600px) { .uc-summary,.uc-fields,.uc-editor-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .uc-summary strong { font-size:1.3rem; } }
  </style>

  <script is:inline>
    (() => {
      const byId = id => document.getElementById(id);
      const api = '/api/usecases';
      let rows = [];
      let selectedId = null;
      let editorId = null;
      const message = (id, value) => { const node=byId(id); node.textContent=value || ''; node.hidden=!value; };
      const label = result => result === 'pass' ? 'Definition geprüft' : result === 'fail' ? 'Definition unvollständig' : 'Prüfung ausstehend';
      const display = value => value == null || value === '' ? '–' : String(value);
      const validId = value => Number.isSafeInteger(Number(value)) && Number(value) > 0;

      async function request(url, options) {
        const response = await fetch(url, options);
        const body = await response.json().catch(() => ({}));
        if (!response.ok || body.success !== true) throw new Error(body.detail || body.error || `API nicht erreichbar (HTTP ${response.status}).`);
        return body;
      }

      async function load(selected = selectedId) {
        message('uc-list-error', '');
        byId('uc-count').textContent = 'Lade Definitionen…';
        try {
          const body = await request(api);
          if (!Array.isArray(body.usecases) || !body.stats) throw new Error('Ungültige Usecase-Antwort.');
          rows = body.usecases.filter(row => validId(row.id));
          const stats = body.stats;
          for (const [key, value] of [['total',stats.total],['pass',stats.pass],['fail',stats.fail],['pending',stats.pending]]) {
            byId('uc-' + key).textContent = Number.isSafeInteger(value) && value >= 0 ? String(value) : '–';
          }
          const options = byId('uc-workflow-options'); options.replaceChildren();
          for (const name of new Set(rows.map(row => row.workflow_name).filter(name => typeof name === 'string' && name.trim()))) {
            const option = document.createElement('option'); option.value=name; options.append(option);
          }
          renderList();
          if (selected && rows.some(row => Number(row.id) === Number(selected))) await open(Number(selected));
          else if (selected) clearDetail();
        } catch (cause) {
          rows=[];
          for (const key of ['total','pass','fail','pending']) byId('uc-' + key).textContent='–';
          byId('uc-list').replaceChildren();
          byId('uc-count').textContent='Keine Daten geladen';
          message('uc-list-error', cause instanceof Error ? cause.message : 'Usecases konnten nicht geladen werden.');
        }
      }

      function renderList() {
        const query = byId('uc-search').value.trim().toLocaleLowerCase('de');
        const found = rows.filter(row => [row.title,row.description,row.workflow_name].some(value => String(value || '').toLocaleLowerCase('de').includes(query)));
        const list=byId('uc-list'); list.replaceChildren();
        byId('uc-count').textContent = `${found.length} von ${rows.length} Definitionen`;
        if (!found.length) {
          const p=document.createElement('p');p.className='uc-muted';p.textContent=rows.length ? 'Keine passende Definition.' : 'Noch keine Usecases gespeichert.';list.append(p);return;
        }
        for (const row of found) {
          const button=document.createElement('button');button.type='button';button.dataset.id=String(row.id);
          button.setAttribute('aria-current',String(Number(row.id)===selectedId));
          const title=document.createElement('strong');title.textContent=display(row.title);
          const secondary=document.createElement('small');secondary.textContent=`${display(row.workflow_name)} · ${label(row.test_result)}`;
          button.append(title,secondary);button.addEventListener('click',()=>open(Number(row.id)));list.append(button);
        }
      }

      function clearDetail() {
        selectedId=null;byId('uc-empty').hidden=false;byId('uc-detail-content').hidden=true;renderList();
      }
      async function open(id) {
        if (!validId(id)) return;
        message('uc-action-status','');
        try {
          const body=await request(`${api}/${encodeURIComponent(id)}`);
          const item=body.usecase;
          if (!item || Number(item.id)!==id) throw new Error('Usecase-Detail stimmt nicht mit der ID überein.');
          selectedId=id;byId('uc-empty').hidden=true;byId('uc-detail-content').hidden=false;
          for (const [name,value] of Object.entries({id:`Usecase #${id}`,title:display(item.title),workflow:display(item.workflow_name),
            result:label(item.test_result),score:item.test_score == null ? '–' : `${item.test_score} %`,
            tested:display(item.last_tested),author:display(item.created_by),updated:display(item.updated_at),
            description:display(item.description),input:display(item.test_input),expected:display(item.expected_output)})) {
            byId('uc-' + name).textContent=value;
          }
          renderList();
          return item;
        } catch (cause) {
          message('uc-list-error',cause instanceof Error ? cause.message : 'Detail konnte nicht geladen werden.');
          return null;
        }
      }

      function editor(item) {
        editorId=item?.id ?? null;
        const form=byId('uc-editor-form');form.reset();message('uc-editor-error','');
        byId('uc-editor-title').textContent=editorId ? 'Usecase bearbeiten' : 'Neuer Usecase';
        for (const field of ['title','description','workflow_name','test_input','expected_output']) form.elements[field].value=String(item?.[field] || '');
        byId('uc-editor').showModal();form.elements.title.focus();
      }
      byId('uc-create').addEventListener('click',()=>editor(null));
      byId('uc-edit').addEventListener('click',async()=>{if(selectedId){const item=await open(selectedId);if(item)editor(item);}});
      for(const id of ['uc-editor-close','uc-editor-cancel'])byId(id).addEventListener('click',()=>byId('uc-editor').close());
      byId('uc-refresh').addEventListener('click',()=>load());
      byId('uc-search').addEventListener('input',renderList);

      byId('uc-editor-form').addEventListener('submit',async event=>{
        event.preventDefault();const form=event.currentTarget;if(!form.reportValidity())return;
        const submit=form.querySelector('button[type="submit"]');submit.disabled=true;message('uc-editor-error','');
        const values=new FormData(form);
        const payload=Object.fromEntries(['title','description','workflow_name','test_input','expected_output'].map(key=>[key,String(values.get(key)||'').trim()]));
        try {
          const id=editorId;
          const body=await request(id ? `${api}/${encodeURIComponent(id)}` : api,
            {method:id?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
          const savedId=id || Number(body.id);
          if(!validId(savedId))throw new Error('Speichern gemeldet, aber keine gültige ID zurückgegeben.');
          const check=await request(`${api}/${encodeURIComponent(savedId)}`);
          if(!check.usecase || ['title','description','workflow_name','test_input','expected_output'].some(key=>String(check.usecase[key]||'').trim()!==payload[key]))
            throw new Error('Speichern gemeldet, der Kontrollabruf weicht jedoch ab.');
          byId('uc-editor').close();await load(savedId);
        }catch(cause){message('uc-editor-error',cause instanceof Error?cause.message:'Usecase konnte nicht gespeichert werden.');}
        finally{submit.disabled=false;}
      });

      byId('uc-check').addEventListener('click',async()=>{
        if(!selectedId)return;
        if(!confirm('Nur die Usecase-Definition prüfen? Workflow und Modell werden nicht ausgeführt; der Prüfstatus wird gespeichert.'))return;
        const button=byId('uc-check');button.disabled=true;message('uc-action-status','Prüfe Definition…');
        try {
          const body=await request(`${api}/${encodeURIComponent(selectedId)}/test`,{method:'POST'});
          await load(selectedId);
          message('uc-action-status',`Definitionsprüfung gespeichert: ${label(body.result)}. Kein Workflow wurde ausgeführt.`);
        }catch(cause){message('uc-action-status',cause instanceof Error?cause.message:'Definitionsprüfung fehlgeschlagen.');}
        finally{button.disabled=false;}
      });
      byId('uc-check-all').addEventListener('click',async()=>{
        if(!rows.length)return;
        if(!confirm(`${rows.length} Usecase-Definitionen prüfen und ihren Prüfstatus speichern? Kein Workflow wird ausgeführt.`))return;
        const button=byId('uc-check-all');button.disabled=true;message('uc-list-error','');
        try {
          const body=await request(`${api}/test-all`,{method:'POST'});
          if(!Number.isSafeInteger(body.total))throw new Error('Ungültige Prüfantwort.');
          await load();
          message('uc-page-status',`${body.total} Definitionen geprüft. Kein Workflow wurde ausgeführt.`);
        }catch(cause){message('uc-list-error',cause instanceof Error?cause.message:'Definitionsprüfung fehlgeschlagen.');}
        finally{button.disabled=false;}
      });
      byId('uc-delete').addEventListener('click',async()=>{
        if(!selectedId)return;
        const id=selectedId;
        if(!confirm(`Usecase #${id} wirklich löschen? Diese Aktion entfernt die gespeicherte Definition.`))return;
        const button=byId('uc-delete');button.disabled=true;message('uc-action-status','');
        try {
          await request(`${api}/${encodeURIComponent(id)}`,{method:'DELETE'});
          const response=await fetch(`${api}/${encodeURIComponent(id)}`);
          const check=await response.json().catch(()=>({}));
          if(!response.ok || check.success!==false || check.error!=='Nicht gefunden')
            throw new Error('Löschung gemeldet, aber der Kontrollabruf ist nicht eindeutig. Bitte Daten prüfen.');
          clearDetail();await load(null);
        }catch(cause){message('uc-action-status',cause instanceof Error?cause.message:'Usecase konnte nicht gelöscht werden.');}
        finally{button.disabled=false;}
      });
      load();
    })();
  </script>
</BachLayout>
