---
// src/pages/governance/usecases.astro - Use Cases & Standard Workflows
import BachLayout from "../../layouts/BachLayout.astro";
---

<BachLayout title="Use Cases & Workflows | Governance" currentPath="/governance/usecases">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem;">
    <div>
      <h1 style="font-size:1.75rem;font-weight:800;letter-spacing:-0.02em;margin-bottom:0.25rem;">
        📑 Use Cases & Standard Workflows
      </h1>
      <p style="color:var(--text-muted);font-size:0.875rem;">
        Gesteuerte Abläufe • Standard-Szenarien • Multi-Agent Workflows • Governance & Gate-Prüfungen
      </p>
    </div>

    <div style="display:flex;gap:0.5rem;">
      <button class="btn btn-sm btn-primary" onclick="alert('Neuen Workflow-Use-Case anlegen...');">
        + Neuer Use Case
      </button>
    </div>
  </div>

  <!-- Governance Modul-Tabs -->
  <div style="display:flex;gap:0.5rem;margin-bottom:1.5rem;border-bottom:1px solid var(--border);padding-bottom:0.5rem;flex-wrap:wrap;">
    <a href="/governance" class="btn btn-sm">🏛️ Control Room</a>
    <a href="/governance/funk" class="btn btn-sm">📻 Agentenfunk</a>
    <a href="/governance/usecases" class="btn btn-sm btn-primary">📑 Use Cases & Workflows</a>
    <a href="/governance/logs" class="btn btn-sm">📜 Logs & Audit</a>
  </div>

  <!-- Kennzahlen -->
  <div class="grid grid-cols-4" style="gap:1rem;margin-bottom:1.5rem;">
    <div class="card" style="text-align:center;padding:1rem;">
      <div style="font-size:1.75rem;font-weight:800;color:var(--accent);">18</div>
      <div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.25rem;">Gesamt Use Cases</div>
    </div>
    <div class="card" style="text-align:center;padding:1rem;border-left:3px solid var(--success);">
      <div style="font-size:1.75rem;font-weight:800;color:var(--success);">14</div>
      <div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.25rem;">Aktiv & Geprüft</div>
    </div>
    <div class="card" style="text-align:center;padding:1rem;border-left:3px solid var(--warning);">
      <div style="font-size:1.75rem;font-weight:800;color:var(--warning);">3</div>
      <div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.25rem;">In Review</div>
    </div>
    <div class="card" style="text-align:center;padding:1rem;border-left:3px solid var(--accent-blue);">
      <div style="font-size:1.75rem;font-weight:800;color:var(--accent-blue);">99.4%</div>
      <div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.25rem;">Erfolgsquote</div>
    </div>
  </div>

  <!-- Filter & Suchleiste -->
  <div class="card" style="margin-bottom:1.5rem;padding:0.75rem 1rem;">
    <div style="display:flex;gap:1rem;align-items:center;flex-wrap:wrap;">
      <input type="text" id="uc-search" placeholder="Suche nach Workflow, Akteur, Gate..." oninput="filterUseCases()" style="flex:1;min-width:200px;padding:0.5rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:0.85rem;" />
      <div style="display:flex;gap:0.5rem;">
        <button class="btn btn-sm btn-primary filter-btn" onclick="setCategory('all')">Alle</button>
        <button class="btn btn-sm filter-btn" onclick="setCategory('code')">Code & Git</button>
        <button class="btn btn-sm filter-btn" onclick="setCategory('research')">Research</button>
        <button class="btn btn-sm filter-btn" onclick="setCategory('system')">System & Sync</button>
      </div>
    </div>
  </div>

  <!-- Use Case Liste -->
  <div id="usecase-list" style="display:flex;flex-direction:column;gap:1rem;">
    <!-- UC 1 -->
    <div class="card uc-item" data-category="code" style="border-left:4px solid var(--accent);">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:0.5rem;">
        <div>
          <div style="display:flex;align-items:center;gap:0.5rem;">
            <h3 style="font-size:1rem;font-weight:700;margin:0;color:var(--text);">UC-01: Automatisierter Code-Review & Linting-Pipeline</h3>
            <span class="badge badge-success">Aktiv</span>
            <span class="badge">Code & Git</span>
          </div>
          <p style="font-size:0.8rem;color:var(--text-muted);margin:0.25rem 0 0.5rem 0;">
            Strikte Prüfung von PEP 639 Lizenzen, Ruff Lints, Mermaid-Diagramm-Syntax und Fail-Closed P-001 Lock-Checks.
          </p>
          <div style="display:flex;gap:1rem;font-size:0.75rem;color:var(--text-muted);">
            <span>Trigger: <code>Pre-Commit / Pre-Push</code></span>
            <span>Akteure: <code>gemini</code>, <code>claude</code></span>
            <span>Letzter Lauf: <strong style="color:var(--success);">Erfolgreich (Exit 0)</strong></span>
          </div>
        </div>
        <button class="btn btn-sm" onclick="alert('UC-01 Trockenlauf gestartet...');">▶ Testlauf</button>
      </div>
    </div>

    <!-- UC 2 -->
    <div class="card uc-item" data-category="research" style="border-left:4px solid var(--accent-blue);">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:0.5rem;">
        <div>
          <div style="display:flex;align-items:center;gap:0.5rem;">
            <h3 style="font-size:1rem;font-weight:700;margin:0;color:var(--text);">UC-02: Forschungsstand-Ingest & Quellen-Verifikation</h3>
            <span class="badge badge-success">Aktiv</span>
            <span class="badge">Research</span>
          </div>
          <p style="font-size:0.8rem;color:var(--text-muted);margin:0.25rem 0 0.5rem 0;">
            Automatischer Download und Hash-Sicherung von Original-PDFs mit Crossref- und arXiv-API-Gegenprobe vor Zitation.
          </p>
          <div style="display:flex;gap:1rem;font-size:0.75rem;color:var(--text-muted);">
            <span>Trigger: <code>Wöchentlich / On-Demand</code></span>
            <span>Akteure: <code>gemini (Research)</code></span>
            <span>Gate: <strong style="color:var(--accent);">Zero-Hallucination-Check</strong></span>
          </div>
        </div>
        <button class="btn btn-sm" onclick="alert('UC-02 Ingest-Prüfung gestartet...');">▶ Testlauf</button>
      </div>
    </div>

    <!-- UC 3 -->
    <div class="card uc-item" data-category="system" style="border-left:4px solid var(--warning);">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:0.5rem;">
        <div>
          <div style="display:flex;align-items:center;gap:0.5rem;">
            <h3 style="font-size:1rem;font-weight:700;margin:0;color:var(--text);">UC-03: Multi-Host System- & Credentials-Sync</h3>
            <span class="badge badge-success">Aktiv</span>
            <span class="badge">System & Sync</span>
          </div>
          <p style="font-size:0.8rem;color:var(--text-muted);margin:0.25rem 0 0.5rem 0;">
            Bidirektionaler Abgleich von Regeldateien (GEMINI.md, CLAUDE.md) und Credentials zwischen Laptop und Mac Studio via Tailscale SSH.
          </p>
          <div style="display:flex;gap:1rem;font-size:0.75rem;color:var(--text-muted);">
            <span>Trigger: <code>Täglich 08:00 / manuell sync_agy.py</code></span>
            <span>Host-Cluster: <code>ASUS-GEI ➔ Mac Studio (100.119.69.90)</code></span>
            <span>Letzter Lauf: <strong style="color:var(--success);">Synchron (2026-10-03)</strong></span>
          </div>
        </div>
        <button class="btn btn-sm" onclick="alert('UC-03 Sync-Simulation gestartet...');">▶ Testlauf</button>
      </div>
    </div>

    <!-- UC 4 -->
    <div class="card uc-item" data-category="code" style="border-left:4px solid var(--success);">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:0.5rem;">
        <div>
          <div style="display:flex;align-items:center;gap:0.5rem;">
            <h3 style="font-size:1rem;font-weight:700;margin:0;color:var(--text);">UC-04: Cross-Agent Handoff & Session Checkpoint</h3>
            <span class="badge badge-success">Aktiv</span>
            <span class="badge">Code & Git</span>
          </div>
          <p style="font-size:0.8rem;color:var(--text-muted);margin:0.25rem 0 0.5rem 0;">
            Strukturierte Übergabe von Teilaufgaben via USMC/Memory (`add_fact`, `add_lesson`, `end_session`) an den nächsten Agenten.
          </p>
          <div style="display:flex;gap:1rem;font-size:0.75rem;color:var(--text-muted);">
            <span>Trigger: <code>Session-Abschluss / Modell-Wechsel</code></span>
            <span>Mesh: <code>claude ↔ gemini ↔ codex</code></span>
            <span>Status: <strong style="color:var(--success);">Aktiv (Belegt in USMC)</strong></span>
          </div>
        </div>
        <button class="btn btn-sm" onclick="alert('UC-04 Handoff-Check gestartet...');">▶ Testlauf</button>
      </div>
    </div>
  </div>

  <script is:inline>
    let activeCat = 'all';

    function setCategory(cat) {
      activeCat = cat;
      document.querySelectorAll('.filter-btn').forEach(b => {
        b.classList.remove('btn-primary');
      });
      event.target.classList.add('btn-primary');
      filterUseCases();
    }

    function filterUseCases() {
      const q = document.getElementById('uc-search').value.toLowerCase();
      const items = document.querySelectorAll('.uc-item');
      items.forEach(el => {
        const cat = el.getAttribute('data-category');
        const text = el.textContent.toLowerCase();
        const matchesCat = (activeCat === 'all' || cat === activeCat);
        const matchesQuery = text.includes(q);
        el.style.display = (matchesCat && matchesQuery) ? 'block' : 'none';
      });
    }
  </script>
</BachLayout>
