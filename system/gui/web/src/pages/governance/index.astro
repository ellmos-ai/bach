---
import BachLayout from "../../layouts/BachLayout.astro";
---

<BachLayout title="Governance CONTROL" currentPath="/governance">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem;">
    <div>
      <h1 style="font-size:1.75rem;font-weight:800;letter-spacing:-0.02em;margin-bottom:0.25rem;">🛡️ Governance CONTROL Room</h1>
      <p style="color:var(--text-muted);font-size:0.875rem;">Entscheidungen, Lock-Feed und konfigurierte Richtlinien</p>
    </div>
    <span class="badge" id="governance-state">Status wird geprüft</span>
  </div>

  <div style="display:flex;gap:0.5rem;margin-bottom:1.5rem;border-bottom:1px solid var(--border);padding-bottom:0.5rem;flex-wrap:wrap;">
    <a href="/governance" class="btn btn-sm btn-primary">🏛️ Control Room</a>
    <a href="/governance/funk" class="btn btn-sm">📻 Agentenfunk</a>
    <a href="/governance/usecases" class="btn btn-sm">📑 Use Cases & Workflows</a>
    <a href="/governance/logs" class="btn btn-sm">📜 Logs & Audit</a>
  </div>

  <div class="card" style="margin-bottom:1.5rem;border-left:4px solid var(--warning);">
    <div class="card-header">
      <h2 class="card-title">⚖️ Entscheidungen</h2>
      <span class="badge" id="decisions-count-badge">Nicht geprüft</span>
    </div>
    <p style="font-size:0.8rem;color:var(--text-muted);">Die Liste zeigt Dateien im Entscheidungsregister. Ein offener Antrag oder eine Freigabe wird daraus nicht abgeleitet.</p>
    <div id="decisions-list" style="display:flex;flex-direction:column;gap:0.75rem;">Quelle wird geprüft.</div>
  </div>

  <div class="grid grid-cols-2">
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">🔒 Lock-Master</h2>
        <span class="badge" id="locks-count-badge">Nicht geprüft</span>
      </div>
      <p style="font-size:0.8rem;color:var(--text-muted);">Letzter generierter Lock-Scan; sein Zeitstempel wird geprüft. Schreibfreigaben folgen weiterhin den Lock-Dateien.</p>
      <div id="locks-list" style="display:flex;flex-direction:column;gap:0.75rem;">Lock-Feed wird geprüft.</div>
      <p id="locks-source" style="font-size:0.75rem;color:var(--text-muted);margin-top:0.75rem;"></p>
    </div>
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">📜 System-Policies (P-001 bis P-007)</h2>
        <span class="badge">Durchsetzung nicht geprüft</span>
      </div>
      <p style="font-size:0.8rem;color:var(--text-muted);">Konfigurierte Einträge; ein aktiver Guard wird hier nicht behauptet.</p>
      <div id="policies-list" style="display:flex;flex-direction:column;gap:0.75rem;font-size:0.82rem;">Konfiguration wird geladen.</div>
    </div>
  </div>

  <div class="card" id="section-agentenfunk" style="margin-top:1.5rem;border-left:4px solid var(--accent-blue);">
    <div class="card-header"><h2 class="card-title">📻 Agentenfunk</h2></div>
    <p style="font-size:0.8rem;color:var(--text-muted);">Nachrichten und Zustellung über die Agentenfunk-Ansicht prüfen.</p>
    <a href="/governance/funk" class="btn btn-sm">Zur Agentenfunk-Ansicht</a>
  </div>

  <script is:inline>
    function setText(id, value) {
      document.getElementById(id).textContent = value;
    }
    function appendRow(parent, title, detail) {
      const row = document.createElement('div');
      row.style.cssText = 'padding:0.75rem;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm)';
      const heading = document.createElement('strong');
      heading.textContent = title;
      row.appendChild(heading);
      if (detail) {
        const note = document.createElement('div');
        note.style.cssText = 'font-size:0.75rem;color:var(--text-muted)';
        note.textContent = detail;
        row.appendChild(note);
      }
      parent.appendChild(row);
    }
    async function loadGovernance() {
      try {
        const res = await fetch('/api/governance/status');
        if (!res.ok) throw new Error('status_unavailable');
        const data = await res.json();
        const available = data.availability === 'available';
        setText('governance-state', available ? 'Lock-Feed verfügbar' : 'Lock-Status unbekannt');
        setText('locks-count-badge', available && Number.isInteger(data.lock_count) ? data.lock_count + ' Locks im Feed' : 'Nicht geprüft');
        setText('locks-source', data.scanned_at ? 'Lock-Scan: ' + data.scanned_at : 'Kein gültiger Lock-Scan verfügbar');
        const locks = document.getElementById('locks-list');
        locks.replaceChildren();
        if (available) {
          for (const lock of data.active_locks || []) appendRow(locks, lock.name, 'Scope: ' + lock.scope);
          if (data.lock_count === 0) appendRow(locks, 'Keine Sperren im letzten Scan', '');
        } else appendRow(locks, 'Lock-Lage unbekannt', data.error || 'Feed nicht verfügbar');
        const policies = document.getElementById('policies-list');
        policies.replaceChildren();
        for (const policy of data.policies || []) appendRow(policies, policy.id + ': ' + policy.title, 'Durchsetzung nicht geprüft');
        const decisions = document.getElementById('decisions-list');
        decisions.replaceChildren();
        for (const decision of data.recent_decisions || []) appendRow(decisions, decision.title, 'Registerdatei: ' + decision.filename);
        setText('decisions-count-badge', (data.recent_decisions || []).length + ' Registerdateien');
        if (!(data.recent_decisions || []).length) appendRow(decisions, 'Keine Registerdateien gefunden', 'Offene Entscheidungen nicht geprüft');
      } catch (_) {
        setText('governance-state', 'Status unbekannt');
        setText('locks-count-badge', 'Nicht geprüft');
        setText('decisions-count-badge', 'Nicht geprüft');
        setText('locks-list', 'Lock-Feed nicht erreichbar.');
        setText('policies-list', 'Konfiguration nicht erreichbar.');
        setText('decisions-list', 'Entscheidungsregister nicht erreichbar.');
      }
    }
    loadGovernance();
  </script>
</BachLayout>
